# Ontvanger van offerte-, advies- en spoedformulieren.
# Zonder SMTP_HOST blijft het formulier werken en toont de site een mailto-fallback.
FORM_TO_EMAIL=info@matchvermogen.nl
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Arbopartner Brabant <info@matchvermogen.nl>"

# HMAC voor het formulierstempel. Minimaal 16 tekens. Ontbreekt dit,
# dan gebruikt de server een vaste afleiding uit de broncode.
FORM_HMAC_SECRET=

# Kandidaten van /werken-bij. Alle drie nodig, anders gaat de aanmelding
# per mail naar info@matchvermogen.nl (SMTP_* hierboven), met het CV als bijlage.
# AIRTABLE_CV_FIELD is optioneel en staat standaard op CV.
# De directe upload naar Airtable stopt bij 5 MB. Tot 10 MB accepteren we wel;
# een groter CV gaat dan per mail mee en het record krijgt CvNotitie.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=Kandidaten
AIRTABLE_CV_FIELD=CV

# Railway zet PORT zelf. Lokaal is het startscript standaard 4327.
PORT=4327
HOST=0.0.0.0
