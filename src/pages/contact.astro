---
import MedewerkersVeld from "../components/MedewerkersVeld.astro";
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import CallbackForm from "../components/CallbackForm.astro";
import CalendlyEmbed from "../components/CalendlyEmbed.astro";
import Figure from "../components/Figure.astro";
import OfficeVisit from "../components/OfficeVisit.astro";
import { site, phoneHref, mailHref, whatsappHref } from "../data/site";
import { crumbsLd } from "../lib/schema";

const crumbs = [
  { name: "Home", path: "/" },
  { name: "Contact", path: "/contact" },
];
---

<Base title="Contact" description="Bel, mail of schrijf Arbopartner Brabant, een label van Matchvermogen B.V. in Uden." jsonLd={[crumbsLd(crumbs)]}>
  <Breadcrumbs crumbs={crumbs} />
  <article class="mx-auto grid max-w-6xl gap-8 px-4 pt-6 lg:grid-cols-2">
    <div>
      <h1 class="font-serif text-5xl text-green-950">Bel of stuur een bericht</h1>
      <p class="mt-4 text-lg">Contact met Arbopartner Brabant loopt via {site.parent.legalName} in {site.parent.city}. Bellen gaat via {site.parent.phoneDisplay}. WhatsApp is {site.parent.whatsappDisplay}. {site.labelStatement}.</p>
      <p class="mt-6"><a class="rounded-full bg-ochre-500 px-5 py-3 font-semibold" data-cta="contact-bel" data-channel="phone" href={phoneHref}>Bel {site.parent.phoneDisplay}</a></p>
      <p class="mt-2 text-sm text-ink-soft">U zit nergens aan vast door te bellen.</p>
      <Figure id="pagina-contact" class="mt-6" />
      <address class="mt-4 not-italic">
        {site.parent.legalName}<br />
        {site.parent.street}<br />
        {site.parent.postalCode} {site.parent.city}<br />
        KvK {site.parent.kvk}
      </address>
      <p class="mt-4">
        <a class="font-semibold underline" href={phoneHref}>{site.parent.phoneDisplay}</a><br />
        <a class="font-semibold underline" href={mailHref}>{site.parent.email}</a><br />
        <a class="font-semibold underline" href={whatsappHref}>WhatsApp {site.parent.whatsappDisplay}</a>
      </p>
    </div>
    <form class="space-y-3 rounded-[2rem] border border-line bg-white/80 p-5" data-endpoint="/api/advies" data-kind="advies" data-cta="contact">
      <h2 class="font-serif text-3xl">Stuur een bericht</h2>
      <label class="block">Naam<input class="field" name="naam" required autocomplete="name" /></label>
      <label class="block">Bedrijf<input class="field" name="organisatie" required autocomplete="organization" /></label>
      <label class="block">Telefoon<input class="field" name="telefoon" type="tel" required autocomplete="tel" /></label>
      <MedewerkersVeld />
      <label class="block">Bericht<textarea class="field min-h-20" name="vraag" maxlength="1000"></textarea></label>
      <label class="flex gap-2 text-sm"><input type="checkbox" name="toestemming" value="ja" required /> <span>Akkoord met contact over dit bericht. <a class="underline" href="/privacy">Privacy</a></span></label>
      <div class="absolute -left-[9999px]" aria-hidden="true"><label>Website<input name="company_website" tabindex="-1" autocomplete="off" /></label></div>
      <button class="rounded-full bg-ochre-500 px-5 py-3 font-semibold" type="submit">Verstuur het bericht</button>
      <p class="text-sm">U zit nergens aan vast. We nemen contact op over dit bericht.</p>
      <p data-status class="text-sm" role="status"></p>
    </form>
  </article>
  <div class="mx-auto max-w-6xl px-4 py-8">
    <CalendlyEmbed />
  </div>
  <div class="mx-auto max-w-6xl px-4 pb-8">
    <OfficeVisit />
  </div>
  <div class="mx-auto max-w-6xl px-4 pb-4">
    <CallbackForm />
  </div>
</Base>

<style>
  .field { display: block; margin-top: 0.25rem; width: 100%; border: 1px solid var(--color-line); border-radius: 0.9rem; padding: 0.55rem 0.75rem; }
</style>

<script>
  import "../scripts/forms.ts";
</script>
