---
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import CtaBand from "../components/CtaBand.astro";
import FaqList from "../components/FaqList.astro";
import { CBS_WAGE, compareEmployment, costPerNeededHour, costPerProductiveHour, defaultCompareInput, MARKET } from "../lib/calc";
import { savingPercent } from "../lib/compare-view";
import { site } from "../data/site";
import { euro, num, pct } from "../lib/format";
import { levels, type Block } from "../lib/rates";
import { crumbsLd, faqLd } from "../lib/schema";

const crumbs = [
  { name: "Home", path: "/" },
  { name: "Tarieven", path: "/tarieven" },
];
const hours: Block[] = [10, 20, 24];
const scenario = compareEmployment(defaultCompareInput());
const perProductiveHour = costPerProductiveHour(scenario);
const perNeededHour = costPerNeededHour(scenario);
const mediorTien = levels.medior.rates[10];
const productiveWeek = scenario.employed.productiveHoursWeek;
const savingShare = pct(Math.round(savingPercent(scenario) * 10) / 10);

const faq = [
  {
    q: "Zijn dit de definitieve prijzen?",
    a: "Nee. De tabel is een richtprijs per uur, exclusief btw. De offerte bevestigt het tarief voor uw dossiers. Dit is geen offerte.",
  },
  {
    q: "Hoe vergelijkt dit met iemand in dienst?",
    a: `De tabel zet drie uurtarieven naast elkaar: de kost per productief uur in dienst, het midden van de zzp-band van STAVV, en ons uurtarief. U bespaart circa ${savingShare} tegenover een dienstverband in het standaardscenario. Omgeslagen naar de uren die u afneemt, ligt ons uur lager. Heeft u bijna een volle werkweek nodig, dan kan een dienstverband als geheel lager uitvallen. De calculator laat dat zien.`,
  },
  {
    q: "Zit de bedrijfsarts in dit uur?",
    a: "Nee. U betaalt de uren van de casemanager. De bedrijfsarts blijft u zelf organiseren. Reistijd binnen ongeveer 45 minuten van het kantoor in Uden zit in het uur. Ligt het adres verder in Brabant, dan staat de rit in de offerte.",
  },
];
---

<Base
  title="Tarieven"
  description="Uurtarieven voor een gedetacheerde casemanager: medior, medior+ en senior bij 10, 20 en 24+ uur. Exclusief btw. Dit is geen offerte."
  jsonLd={[crumbsLd(crumbs), faqLd(faq)]}
>
  <Breadcrumbs crumbs={crumbs} />
  <article class="mx-auto max-w-3xl px-4 pb-4 pt-10">
    <h1 class="font-serif text-4xl text-green-950 md:text-5xl">Uurtarieven, exclusief btw</h1>
    <p class="mt-4 text-lg">Een tarief van Arbopartner Brabant is een richtprijs per uur voor een gedetacheerde casemanager. Hoe groter het blok, hoe lager het uur. Dit is geen offerte. Het label is voor organisaties met 35–500 medewerkers.</p>

    <h2 class="mt-10 font-serif text-3xl text-green-950">Uurtarieven</h2>
    <div class="ap-rates mt-4">
      <table class="w-full text-left">
        <caption class="sr-only">Uurtarief exclusief btw voor medior, medior+ en senior bij 10, 20 en 24 of meer uur per week</caption>
        <thead>
          <tr class="border-b border-line text-sm">
            <th class="py-2 pr-4 font-semibold" scope="col">Niveau</th>
            {hours.map((hour) => (
              <th class="py-2 pr-4 font-semibold" scope="col">{hour === 24 ? "24+ uur" : `${hour} uur`}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {Object.values(levels).map((level) => (
            <tr class="border-b border-line">
              <th class="py-3 pr-4 font-semibold" scope="row">{level.short}</th>
              {hours.map((hour) => (
                <td class="py-3 pr-4" data-label={hour === 24 ? "24+ uur" : `${hour} uur`}>{euro(level.rates[hour])}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-3 text-sm text-ink-soft">Per uur, exclusief btw. Het blok volgt de uren per week: 10, 20 of 24 en meer.</p>

    <h2 id="vergelijking" class="mt-12 font-serif text-3xl text-green-950">Wat kost een casemanager in dienst écht per productief uur?</h2>
    <p class="mt-4">Hetzelfde standaardscenario als de calculator: medior, 100 medewerkers, 5,4% verzuim, één contract van 40 uur. In de kost zitten werkgeverslasten, uren die wegvallen door verlof, feestdagen en verzuim, en de risicokosten van vervanging, overnametijd, verlies van continuïteit en een slechte koppeling aan loonwaarde. Tot {site.discount.tweedeSpoor}% korting op spoor 2 en tot {site.discount.arbeidsdeskundige}% op arbeidsdeskundig onderzoek telt mee als besparing.</p>
    <div class="mt-4 overflow-x-auto">
      <table class="w-full text-left">
        <caption class="sr-only">Uurtarief in dienst per productief uur, zzp-casemanager en Arbopartner</caption>
        <thead>
          <tr class="border-b border-line text-sm">
            <th class="py-2 pr-4 font-semibold" scope="col">In dienst, per productief uur</th>
            <th class="py-2 pr-4 font-semibold" scope="col">Zzp-casemanager</th>
            <th class="py-2 font-semibold" scope="col">Arbopartner</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="py-3 pr-4 font-serif text-3xl text-green-950">{euro(perProductiveHour)}</td>
            <td class="py-3 pr-4 font-serif text-3xl text-green-950">{euro(MARKET.zzpHourly)}</td>
            <td class="py-3 font-serif text-3xl text-green-950">{euro(mediorTien)}</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="mt-3">U bespaart circa {savingShare} tegenover een dienstverband in dit scenario. In dienst is de volle kost per productief uur. Zzp is het midden van de band die <a class="underline" href={MARKET.zzpUrl}>STAVV</a> noemt, €{MARKET.zzpLow} tot €{MARKET.zzpHigh}. Dat midden is geen gemiddelde.</p>
    <div class="mt-4 grid gap-3 sm:grid-cols-2">
      <p class="rounded-2xl border border-line bg-white p-4">
        <span class="block text-sm text-ink-soft">In dienst, per uur dat u nodig heeft</span>
        <strong class="mt-1 block font-serif text-4xl text-green-950">{euro(perNeededHour)}</strong>
      </p>
      <p class="rounded-2xl bg-ochre-200 p-4">
        <span class="block text-sm">Medior bij 10 uur</span>
        <strong class="mt-1 block font-serif text-4xl text-green-950">{euro(mediorTien)}</strong>
      </p>
    </div>
    <p class="mt-3">Ons uurtarief ligt lager. Een productief uur van de persoon in dienst is {euro(perProductiveHour)}. Het contract levert ongeveer {num(productiveWeek)} van die uren per week, en dit scenario heeft er {scenario.neededHours} nodig. De {euro(perNeededHour)} is die kost, gedeeld door de uren die u afneemt.</p>
    <p class="mt-3 text-sm text-ink-soft">
      Het model start bij het CBS-mediaan uurloon van {euro(CBS_WAGE.hourly)} ({CBS_WAGE.group}, {CBS_WAGE.year}, voorlopig) en telt vakantiegeld, werkgeverspremies, verlof, verzuim, werving en de opbouw van de transitievergoeding mee.
      <a class="underline" href={CBS_WAGE.source}>Bron: CBS StatLine 86355NED</a>.
      Heeft u bijna een volle werkweek nodig, dan kan een dienstverband als geheel lager uitvallen. De calculator rekent dat met uw eigen cijfers.
    </p>
    <p class="mt-5">
      <a class="rounded-full bg-ochre-500 px-5 py-3 font-semibold" data-cta="tarieven-vergelijking" href="/casemanager-inhuren-of-in-dienst#vergelijking">Bereken het voor uw organisatie</a>
    </p>

    <FaqList items={faq} title="Vragen over de uurtarieven" />
  </article>
  <CtaBand
    title="Richtprijs omzetten in een offerte"
    text="De offerte bevestigt het uurtarief."
    href="/offerte"
    label="Vraag een offerte"
    proof={false}
  />
</Base>
