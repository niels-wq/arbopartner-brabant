---
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import CtaBand from "../components/CtaBand.astro";
import FaqList from "../components/FaqList.astro";
import { CBS_WAGE, compareEmployment, costPerNeededHour, defaultCompareInput } from "../lib/calc";
import { euro } from "../lib/format";
import { levels, type Block } from "../lib/rates";
import { crumbsLd, faqLd } from "../lib/schema";

const crumbs = [
  { name: "Home", path: "/" },
  { name: "Tarieven", path: "/tarieven" },
];
const hours: Block[] = [10, 20, 24];
const scenario = compareEmployment(defaultCompareInput());
const perNeededHour = costPerNeededHour(scenario);
const mediorTien = levels.medior.rates[10];

const faq = [
  {
    q: "Zijn dit de definitieve prijzen?",
    a: "Nee. De tabel is een richtprijs per uur, exclusief btw. De offerte bevestigt het tarief voor uw dossiers. Dit is geen offerte.",
  },
  {
    q: "Hoe vergelijkt dit met iemand in dienst?",
    a: "De vergelijking deelt de kost van een fulltime contract door de uren casemanagement die u nodig heeft. In het standaardscenario is dat tien uur per week tegenover één contract van veertig uur. Heeft u bijna een volle werkweek nodig, dan kan een dienstverband lager uitvallen. De tool laat dat zien.",
  },
  {
    q: "Zit de bedrijfsarts in dit uur?",
    a: "Nee. U betaalt de uren van de casemanager. De bedrijfsarts blijft u zelf organiseren. Reistijd binnen ongeveer 45 minuten van het kantoor in Uden zit in het uur. Ligt het adres verder in Brabant, dan staat de rit in de offerte.",
  },
];
---

<Base
  title="Tarieven"
  description="Uurtarieven voor een gedetacheerde casemanager: medior, medior+ en senior bij 10, 20 en 24+ uur. Exclusief btw. Dit is geen offerte."
  jsonLd={[crumbsLd(crumbs), faqLd(faq)]}
>
  <Breadcrumbs crumbs={crumbs} />
  <article class="mx-auto max-w-3xl px-4 pb-4 pt-10">
    <h1 class="font-serif text-4xl text-green-950 md:text-5xl">Uurtarieven, exclusief btw</h1>
    <p class="mt-4 text-lg">Een tarief van Arbopartner Brabant is een richtprijs per uur voor een gedetacheerde casemanager. Hoe groter het blok, hoe lager het uur. Dit is geen offerte. Het label is voor organisaties met 35–500 medewerkers.</p>

    <h2 class="mt-10 font-serif text-3xl text-green-950">Uurtarieven</h2>
    <div class="ap-rates mt-4">
      <table class="w-full text-left">
        <caption class="sr-only">Uurtarief exclusief btw voor medior, medior+ en senior bij 10, 20 en 24 of meer uur per week</caption>
        <thead>
          <tr class="border-b border-line text-sm">
            <th class="py-2 pr-4 font-semibold" scope="col">Niveau</th>
            {hours.map((hour) => (
              <th class="py-2 pr-4 font-semibold" scope="col">{hour === 24 ? "24+ uur" : `${hour} uur`}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {Object.values(levels).map((level) => (
            <tr class="border-b border-line">
              <th class="py-3 pr-4 font-semibold" scope="row">{level.short}</th>
              {hours.map((hour) => (
                <td class="py-3 pr-4" data-label={hour === 24 ? "24+ uur" : `${hour} uur`}>{euro(level.rates[hour])}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-3 text-sm text-ink-soft">Per uur, exclusief btw. Het blok volgt de uren per week: 10, 20 of 24 en meer.</p>

    <h2 id="vergelijking" class="mt-12 font-serif text-3xl text-green-950">Tegenover iemand in dienst</h2>
    <p class="mt-4">In het standaardscenario heeft u {scenario.neededHours} uur casemanagement per week nodig. Een fulltime contract van {scenario.employed.contractHoursYear / 52} uur komt in dit model uit op {euro(perNeededHour, true)} per uur van die {scenario.neededHours} uur. Ons medior-tarief bij 10 uur is {euro(mediorTien)} per uur.</p>
    <div class="mt-4 grid gap-3 sm:grid-cols-2">
      <p class="rounded-2xl border border-line bg-white p-4">
        <span class="block text-sm text-ink-soft">Contract, omgerekend naar een nodig uur</span>
        <strong class="mt-1 block font-serif text-4xl text-green-950">{euro(perNeededHour, true)}</strong>
      </p>
      <p class="rounded-2xl bg-ochre-200 p-4">
        <span class="block text-sm">Medior bij 10 uur</span>
        <strong class="mt-1 block font-serif text-4xl text-green-950">{euro(mediorTien)}</strong>
      </p>
    </div>
    <p class="mt-3">Het verschil zit in de uren die een contract wel betaalt en die u niet nodig heeft. Heeft u bijna een volle werkweek nodig, dan kan een dienstverband lager uitvallen. De vergelijking rekent dat eerlijk.</p>
    <p class="mt-3 text-sm text-ink-soft">
      Het model start bij het CBS-mediaan uurloon van {euro(CBS_WAGE.hourly)} ({CBS_WAGE.group}, {CBS_WAGE.year}, voorlopig) en telt vakantiegeld, werkgeverspremies, verlof, verzuim, werving en de opbouw van de transitievergoeding mee.
      <a class="underline" href={CBS_WAGE.source}>Bron: CBS StatLine 86355NED</a>.
    </p>
    <p class="mt-5">
      <a class="rounded-full bg-ochre-500 px-5 py-3 font-semibold" data-cta="tarieven-vergelijking" href="/casemanager-inhuren-of-in-dienst#vergelijking">Vergelijk dit met iemand in dienst</a>
    </p>

    <FaqList items={faq} title="Vragen over de uurtarieven" />
  </article>
  <CtaBand
    title="Richtprijs omzetten in een offerte"
    text="De offerte bevestigt het uurtarief."
    href="/offerte"
    label="Vraag een offerte"
    proof={false}
  />
</Base>
