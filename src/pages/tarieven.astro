---
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ClusterNav from "../components/ClusterNav.astro";
import CtaBand from "../components/CtaBand.astro";
import FaqList from "../components/FaqList.astro";
import PackageGrid from "../components/PackageGrid.astro";
import CallbackForm from "../components/CallbackForm.astro";
import { levels, type Block } from "../lib/rates";
import { euro } from "../lib/format";
import { priceFaq } from "../lib/pricing";
import { verzuimanalysePrijs } from "../lib/rates";
import { crumbsLd, faqLd } from "../lib/schema";

const crumbs = [
  { name: "Home", path: "/" },
  { name: "Tarieven", path: "/tarieven" },
];
const hours: Block[] = [10, 20, 24];
const faq = priceFaq();
---

<Base title="Tarieven" description="Richtprijzen voor een gedetacheerde casemanager: drie blokken, per maand en per uur. Medior, medior+ en senior bij 10, 20 of 24+ uur." jsonLd={[crumbsLd(crumbs), faqLd(faq)]}>
  <Breadcrumbs crumbs={crumbs} />
  <header class="mx-auto max-w-6xl px-4 pt-6">
    <h1 class="font-serif text-5xl text-green-950">Tarieven</h1>
    <p class="mt-4 max-w-3xl text-lg">Een tarief van Arbopartner Brabant is een richtprijs per uur voor een gedetacheerde casemanager, exclusief btw. Het maandbedrag is dat uur, maal de uren per week, maal 52, gedeeld door 12. Hoe groter het blok, hoe lager het uur. Het maandbedrag stijgt wel, want u neemt meer uren af. Dit is geen offerte.</p>
  </header>
  <div class="pt-8">
    <PackageGrid />
  </div>
  <article class="mx-auto max-w-3xl px-4">
    <h2 class="mt-12 font-serif text-3xl text-green-950">Uurtarieven waar de bedragen uit komen</h2>
    <div class="mt-4 overflow-x-auto">
      <table class="w-full min-w-[32rem] text-left">
        <thead>
          <tr class="border-b border-line">
            <th class="py-2" scope="col">Niveau</th>
            {hours.map((hour) => <th scope="col">{hour === 24 ? "24+ uur" : `${hour} uur`}</th>)}
          </tr>
        </thead>
        <tbody>
          {Object.values(levels).map((level) => (
            <tr class="border-b border-line">
              <th class="py-3 font-semibold" scope="row">{level.label}</th>
              {hours.map((hour) => <td>{euro(level.rates[hour])}</td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <h2 class="mt-8 font-serif text-3xl text-green-950">Wat erin zit</h2>
    <ul class="mt-3 list-disc pl-5">
      <li>De uren van de casemanager, op locatie of online.</li>
      <li>Reistijd binnen het werkgebied.</li>
      <li>Vervanging als de casemanager zelf uitvalt.</li>
      <li>Afstemming met de arbeidsdeskundige. Het onderzoek zelf offreert Matchvermogen, met 8% korting.</li>
    </ul>
    <h2 class="mt-8 font-serif text-3xl text-green-950">Wat er niet in zit</h2>
    <ul class="mt-3 list-disc pl-5">
      <li>De bedrijfsarts of een arbodienstcontract.</li>
      <li>Een tweede-spoortraject. Dat loopt via Best Match, met 10% korting.</li>
      <li>Juridische procedures en het opstellen van een vaststellingsovereenkomst.</li>
    </ul>
    <p class="mt-6 text-sm">Losse verzuimanalyse: {euro(verzuimanalysePrijs, true)} exclusief btw.</p>
    <FaqList items={faq} title="Vragen over prijzen" />
    <div class="mt-10">
      <CallbackForm />
    </div>
  </article>
  <ClusterNav />
  <CtaBand title="Richtprijs omzetten in een offerte" text="Drie korte stappen, in een paar minuten. De offerte bevestigt het tarief. Het gesprek van 30 minuten verplicht u tot niets." />
</Base>
