---
import Base from "../../../layouts/Base.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CtaBand from "../../../components/CtaBand.astro";
import FaqList from "../../../components/FaqList.astro";
import InlineLead from "../../../components/InlineLead.astro";
import Verzuimsysteem from "../../../components/Verzuimsysteem.astro";
import LokaleDiensten from "../../../components/LokaleDiensten.astro";
import { getRegio, regios, stedenInRegio, uwvBesluitUrl, uwvRegios2026Url } from "../../../data/regios";
import { areaServiceLd, crumbsLd, faqLd } from "../../../lib/schema";

export function getStaticPaths() {
  return regios.map((regio) => ({ params: { slug: regio.slug } }));
}

const regio = getRegio(Astro.params.slug)!;
const steden = stedenInRegio(regio.slug);
const crumbs = [
  { name: "Home", path: "/" },
  { name: "Werkgebied", path: "/werkgebied" },
  { name: regio.name, path: `/werkgebied/regio/${regio.slug}` },
];
const path = `/werkgebied/regio/${regio.slug}`;
---

<Base
  title={regio.seoTitle}
  description={regio.seoDescription}
  jsonLd={[
    crumbsLd(crumbs),
    faqLd(regio.faq),
    areaServiceLd({
      name: regio.h1,
      path,
      description: regio.seoDescription,
      areaName: regio.name,
      areaType: "AdministrativeArea",
    }),
  ]}
>
  <Breadcrumbs crumbs={crumbs} />
  <article class="mx-auto max-w-3xl px-4 pt-6">
    <p class="text-sm font-semibold uppercase tracking-[0.14em] text-ochre-800">Noord-Brabant · op locatie en online</p>
    <h1 class="mt-2 font-serif text-5xl text-green-950">{regio.h1}</h1>
    {regio.intro.map((paragraph) => <p class="mt-4">{paragraph}</p>)}
    <h2 class="mt-8 font-serif text-3xl text-green-950">Hoe we hier werken</h2>
    {regio.werken.map((paragraph) => <p class="mt-4">{paragraph}</p>)}
    <p class="mt-4 text-sm font-semibold">
      <a class="underline" href="/offerte">Offerte aanvragen</a>
      <span class="px-2 text-ink-soft">·</span>
      <a class="underline" href="/contact">Contact</a>
      <span class="px-2 text-ink-soft">·</span>
      <a class="underline" href="/adviesgesprek">Adviesgesprek</a>
    </p>
    <h2 class="mt-8 font-serif text-3xl text-green-950">Plaatsen in deze regio</h2>
    <ul class="mt-3 flex flex-wrap gap-2">
      {regio.gemeenten.map((name) => <li class="rounded-full bg-sand-200 px-3 py-1 text-sm">{name}</li>)}
    </ul>
    <p class="mt-4 text-sm text-ink-soft">{regio.gemeenteNoot}</p>
    <p class="mt-3 text-sm">
      <a class="underline" href={uwvBesluitUrl}>Besluit werkgebieden UWV 2024</a>
      <span class="px-2 text-ink-soft">·</span>
      <a class="underline" href={uwvRegios2026Url}>Arbeidsmarktregio’s per 1 januari 2026</a>
    </p>
    <h2 class="mt-8 font-serif text-3xl text-green-950">Pagina’s per plaats</h2>
    <ul class="mt-3 space-y-2">
      {steden.map((place) => (
        <li>
          <a class="font-semibold underline" href={`/werkgebied/${place.slug}`}>Casemanager {place.in}</a>
          <span class="text-sm text-ink-soft"> · {place.municipality}</span>
        </li>
      ))}
    </ul>
    <LokaleDiensten plaats={regio.name} />
    <Verzuimsysteem />
    <FaqList items={regio.faq} />
  </article>
  <div class="mx-auto max-w-3xl px-4">
    <InlineLead source={`regio-${regio.slug}`} title={`Kort doorgeven voor ${regio.name}`} text="Twee stappen. We bellen terug en zeggen of de rit binnen het tarief valt of in de offerte hoort. Dit formulier is nog geen offerte." />
  </div>
  <CtaBand title={`Offerte voor ${regio.name}`} text="U noemt de plaats en de dossiers. Wij bevestigen de uren en de rit." href="/offerte" label="Vraag een offerte aan" proof={false} />
</Base>
