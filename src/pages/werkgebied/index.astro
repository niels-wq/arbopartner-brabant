---
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ClusterNav from "../../components/ClusterNav.astro";
import BrabantPhoto from "../../components/BrabantPhoto.astro";
import Photo from "../../components/Photo.astro";
import BrabantMap from "../../components/BrabantMap.astro";
import CtaBand from "../../components/CtaBand.astro";
import InlineLead from "../../components/InlineLead.astro";
import { fotoVoorPlaats } from "../../data/brabant-fotos";
import { gemeenten } from "../../data/gemeenten";
import { places } from "../../data/places";
import { regios } from "../../data/regios";
import { crumbsLd } from "../../lib/schema";

const crumbs = [
  { name: "Home", path: "/" },
  { name: "Werkgebied", path: "/werkgebied" },
];
---

<Base title="Casemanager in Brabant" description="Werkgebied van Arbopartner Brabant: heel Noord-Brabant. Het kantoor staat in Uden, Losplaats 16d. Voor organisaties met 35–500 medewerkers." jsonLd={[crumbsLd(crumbs)]}>
  <Breadcrumbs crumbs={crumbs} />
  <header class="mx-auto max-w-6xl px-4 pt-6">
    <h1 class="font-serif text-5xl text-green-950">Casemanager in heel Brabant</h1>
    <p class="mt-4 max-w-2xl">Arbopartner Brabant werkt voor werkgevers in Noord-Brabant, nuchter en dichtbij. De thuisbasis is het kantoor aan de Losplaats 16d in Uden. Reistijd binnen ongeveer 45 minuten van dat kantoor zit in het tarief. Ligt uw adres verder in de provincie, dan staat de rit in de offerte. De minuten bij een stad zijn een indicatie per auto buiten de spits.</p>
    <BrabantMap class="mt-6" />
    <Photo id="gesprek-werkgever" class="mt-6 max-w-3xl" />
  </header>
  <section class="mx-auto max-w-6xl px-4 pt-8" aria-labelledby="regios-kop">
    <h2 id="regios-kop" class="font-serif text-3xl text-green-950">Vier regio’s</h2>
    <p class="mt-2 max-w-2xl text-sm text-ink-soft">De indeling volgt de UWV-arbeidsmarktregio’s. Zuidoost-Brabant en Helmond-De Peel staan op één pagina, omdat Brainport ze allebei dekt. De Kempen hoort daarbij.</p>
    <ul class="mt-4 grid gap-4 sm:grid-cols-2">
      {regios.map((regio) => (
        <li>
          <a class="block h-full rounded-[2rem] border border-line bg-white/80 p-5" href={`/werkgebied/regio/${regio.slug}`}>
            <h3 class="font-serif text-2xl text-green-950">{regio.name}</h3>
            <p class="mt-2 text-sm">{regio.card}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>
  <ul class="mx-auto grid max-w-6xl gap-4 px-4 py-8 sm:grid-cols-2 lg:grid-cols-3">
    {places.map((place) => {
      return (
        <li>
          <a class="block h-full overflow-hidden rounded-[2rem] border border-line bg-white/80" href={`/werkgebied/${place.slug}`}>
            {fotoVoorPlaats(place.slug) && <BrabantPhoto id={fotoVoorPlaats(place.slug)!} plain sizes="(min-width: 1024px) 22rem, 100vw" />}
            <div class="p-5">
              <h2 class="font-serif text-2xl text-green-950">{place.name}</h2>
              <p class="text-sm text-ochre-800">{place.buitenBrabant ? "Rand, Gelderland" : place.municipality} · ongeveer {place.minutes} minuten</p>
              <p class="mt-2 text-sm">{place.sectors.join(", ")}</p>
            </div>
          </a>
        </li>
      );
    })}
  </ul>
  <section class="mx-auto max-w-6xl px-4 pb-8">
    <h2 class="font-serif text-3xl text-green-950">Alle gemeenten in Noord-Brabant</h2>
    <p class="mt-2 max-w-2xl text-sm text-ink-soft">De lijst volgt de gemeentelijke indeling van het CBS op 1 januari 2026. Een stad als Uden hoort bij Maashorst, Veghel bij Meierijstad.</p>
    <ul class="mt-4 flex flex-wrap gap-2">
      {gemeenten.map((name) => (
        <li class="rounded-full bg-white px-3 py-1 text-sm ring-1 ring-line">{name}</li>
      ))}
    </ul>
  </section>
  <div class="mx-auto max-w-3xl px-4">
    <InlineLead source="werkgebied-overzicht" title="Waar zit uw bedrijf?" text="Twee stappen. We bellen terug en kijken of de rit binnen de ring van ongeveer 45 minuten valt, of dat de rit in de offerte hoort." />
  </div>
  <ClusterNav />
  <CtaBand title="Kijken of de rit in het tarief zit" text="We zeggen in het gesprek of uw adres binnen ongeveer 45 minuten van Uden valt." />
</Base>
