---
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ClusterNav from "../../components/ClusterNav.astro";
import CtaBand from "../../components/CtaBand.astro";
import Photo from "../../components/Photo.astro";
import Mark from "../../components/Mark.astro";
import InlineLead from "../../components/InlineLead.astro";
import { fotoVoorDienst } from "../../data/fotos";
import { serviceIcons, services } from "../../data/services";
import { crumbsLd } from "../../lib/schema";

const crumbs = [
  { name: "Home", path: "/" },
  { name: "Diensten", path: "/diensten" },
];
---

<Base title="Diensten" description="Casemanager detacheren, verzuimanalyse, protocol, training, jobcoaching, mediation, eerste en tweede spoor, WIA-begeleiding en arbeidsdeskundig onderzoek. Voor organisaties met 35–500 medewerkers." jsonLd={[crumbsLd(crumbs)]}>
  <Breadcrumbs crumbs={crumbs} />
  <header class="mx-auto max-w-6xl px-4 pt-6">
    <h1 class="font-serif text-5xl text-green-950">Diensten</h1>
    <p class="mt-4 max-w-2xl text-lg text-ink-soft">Een dienst van Arbopartner Brabant is begeleiding van verzuim door een vaste gedetacheerde casemanager, voor organisaties met 35–500 medewerkers. Daaromheen zitten de diensten die Matchvermogen, Best Match, werkhervattingskas.nl of arbeidsdeskundig.com echt aanbieden. Een preventief medisch onderzoek staat daar niet als dienst. Het label is geen arbodienst.</p>
    <p class="mt-6"><a class="rounded-full bg-ochre-500 px-5 py-3 font-semibold" data-cta="diensten-advies" href="/adviesgesprek">Plan een adviesgesprek</a></p>
    <p class="mt-2 text-sm text-ink-soft">Het gesprek van 30 minuten verplicht u tot niets.</p>
    <Photo id="gesprek-drie" eager class="mt-6 max-w-3xl" />
  </header>
  <div class="mx-auto grid max-w-6xl gap-4 px-4 py-8 md:grid-cols-2">
    {services.map((service) => (
      <a class="overflow-hidden rounded-[2rem] border border-line bg-white/80" href={`/diensten/${service.slug}`}>
        <Photo id={fotoVoorDienst(service.slug)} plain caption={false} sizes="(min-width: 768px) 28rem, 100vw" />
        <div class="p-6">
        <h2 class="font-serif text-3xl text-green-950"><Mark name={serviceIcons[service.slug]} />{service.title}</h2>
        <p class="mt-2 text-ink-soft">{service.lead}</p>
        </div>
      </a>
    ))}
  </div>
  <div class="mx-auto max-w-3xl px-4">
    <InlineLead source="diensten-overzicht" title="Welke dienst speelt er?" />
  </div>
  <ClusterNav />
  <CtaBand />
</Base>
