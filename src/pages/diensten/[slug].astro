---
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import FaqList from "../../components/FaqList.astro";
import CtaBand from "../../components/CtaBand.astro";
import HireBenefits from "../../components/HireBenefits.astro";
import Figure from "../../components/Figure.astro";
import Mark from "../../components/Mark.astro";
import InlineLead from "../../components/InlineLead.astro";
import { services } from "../../data/services";
import { zzpFaq } from "../../data/site";

const icon: Record<string, "calendar" | "chart" | "document" | "balance" | "route" | "shield"> = {
  "casemanager-detachering": "calendar",
  verzuimanalyse: "chart",
  "verzuimbeleid-protocol": "document",
  "vso-en-ontslagdossier": "balance",
  "tweede-spoor": "route",
  "arbeidsdeskundig-onderzoek": "shield",
};
import { crumbsLd, faqLd } from "../../lib/schema";

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;
const faq = [...service.faq, zzpFaq];
const crumbs = [
  { name: "Home", path: "/" },
  { name: "Diensten", path: "/diensten" },
  { name: service.title, path: `/diensten/${service.slug}` },
];
---

<Base title={service.title} description={service.description} jsonLd={[crumbsLd(crumbs), faqLd(faq)]}>
  <Breadcrumbs crumbs={crumbs} />
  <article class="mx-auto max-w-3xl px-4 pt-6">
    <h1 class="font-serif text-5xl text-green-950">{service.title}</h1>
    <p class="mt-4 text-lg text-ink-soft">{service.lead}</p>
    <Figure id={`dienst-${service.slug}`} eager class="mt-6" />
    {service.sections.map((section) => (
      <section class="mt-8">
        <h2 class="font-serif text-3xl text-green-950"><Mark name={icon[service.slug] ?? "document"} />{section.heading}</h2>
        {section.paragraphs.map((paragraph) => <p class="mt-3">{paragraph}</p>)}
      </section>
    ))}
    {service.sister && (
      <p class="mt-8 rounded-3xl bg-ochre-200 px-5 py-4">
        Zustermerk {service.sister.name}: <a class="font-semibold underline" href={service.sister.url}>{service.sister.text}</a>
      </p>
    )}
    <HireBenefits />
    <FaqList items={faq} />
  </article>
  <div class="mx-auto max-w-3xl px-4">
    <InlineLead
      id={service.slug === "verzuimanalyse" ? "gratis" : undefined}
      source={service.slug === "verzuimanalyse" ? "gratis-verzuimanalyse" : `dienst-${service.slug}`}
      title={service.slug === "verzuimanalyse" ? "Gratis verzuimanalyse" : "Kort doorgeven over deze dienst"}
      submit={service.slug === "verzuimanalyse" ? "Gratis verzuimanalyse" : "Verstuur"}
      text={service.slug === "verzuimanalyse"
        ? "Twee stappen: eerst uw nummer, daarna naam en organisatie. We laten op basis van uw cijfers zien hoe het verzuimpercentage kan dalen. Geen vast percentage vooraf. Het uitgewerkte rapport van €995 blijft een aparte opdracht."
        : "Twee stappen: eerst uw nummer, daarna naam en organisatie. We bellen terug. Dit formulier is nog geen offerte."}
    />
  </div>
  <CtaBand />
</Base>
