---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ClusterNav from "../../components/ClusterNav.astro";
import Photo from "../../components/Photo.astro";
import CtaBand from "../../components/CtaBand.astro";
import InlineLead from "../../components/InlineLead.astro";
import { fotoVoorBlog } from "../../data/fotos";
import { crumbsLd } from "../../lib/schema";

const posts = (await getCollection("blog")).sort((a, b) => +b.data.pubDate - +a.data.pubDate);
const crumbs = [
  { name: "Home", path: "/" },
  { name: "Kennis", path: "/blog" },
];
---

<Base title="Kennis over verzuim" description="Artikelen voor werkgevers over ziekmelding, verzuimkosten, casemanagement en re-integratie in Brabant." jsonLd={[crumbsLd(crumbs)]}>
  <Breadcrumbs crumbs={crumbs} />
  <header class="mx-auto max-w-6xl px-4 pt-6">
    <h1 class="font-serif text-5xl text-green-950">Uitleg voor werkgevers</h1>
    <p class="mt-4 max-w-2xl">Kennis op deze site is algemene uitleg voor werkgevers over verzuim, re-integratie en de kosten daarvan. Geen juridisch advies en geen oordeel over één dossier. De wet die de re-integratiestappen voorschrijft, noemen we in het artikel zelf, niet als merk.</p>
    <Photo id="gesprek-documenten" eager class="mt-6 max-w-3xl" />
  </header>
  <ul class="mx-auto grid max-w-6xl gap-4 px-4 py-8 md:grid-cols-2">
    {posts.map((post) => (
      <li>
        <a class="block h-full overflow-hidden rounded-[2rem] border border-line bg-white/80" href={`/blog/${post.id}`}>
          <Photo id={fotoVoorBlog(post.id)!} plain caption={false} sizes="(min-width: 768px) 24rem, 100vw" />
          <div class="p-5">
          <p class="text-sm text-ochre-800">{post.data.keyword}</p>
          <h2 class="mt-1 font-serif text-2xl text-green-950">{post.data.title}</h2>
          <p class="mt-2 text-sm text-ink-soft">{post.data.description}</p>
          </div>
        </a>
      </li>
    ))}
    </ul>
  <div class="mx-auto max-w-3xl px-4">
    <InlineLead source="blog-overzicht" title="Vraag over een artikel" />
  </div>
  <ClusterNav />
  <CtaBand title="Van een artikel naar uw dossiers" text="De stukken zijn algemene uitleg. In een gesprek kijken we of ze op uw situatie passen." />
</Base>
