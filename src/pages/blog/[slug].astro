---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import AuthorBlock from "../../components/AuthorBlock.astro";
import ClusterNav from "../../components/ClusterNav.astro";
import FaqList from "../../components/FaqList.astro";
import CtaBand from "../../components/CtaBand.astro";
import Figure from "../../components/Figure.astro";
import InlineLead from "../../components/InlineLead.astro";
import { visualAlt } from "../../data/visuals";
import { absoluteUrl } from "../../data/site";
import { articleLd, crumbsLd, faqLd } from "../../lib/schema";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const imageId = `blog-${post.id}`;
const image = absoluteUrl(`/beeld/${imageId}-1200.webp`);
const crumbs = [
  { name: "Home", path: "/" },
  { name: "Kennis", path: "/blog" },
  { name: post.data.title, path: `/blog/${post.id}` },
];
const iso = (date: Date) => date.toISOString().slice(0, 10);
---

<Base
  title={post.data.title}
  description={post.data.description}
  image={image}
  imageAlt={visualAlt(imageId)}
  jsonLd={[
    crumbsLd(crumbs),
    faqLd(post.data.faq),
    articleLd({
      title: post.data.title,
      description: post.data.description,
      path: `/blog/${post.id}`,
      date: iso(post.data.pubDate),
      updated: iso(post.data.updated),
      image,
    }),
  ]}
>
  <Breadcrumbs crumbs={crumbs} />
  <article class="mx-auto max-w-3xl px-4 pt-6">
    <p class="text-sm font-semibold uppercase tracking-[0.14em] text-ochre-800">{post.data.keyword}</p>
    <h1 class="mt-2 font-serif text-4xl text-green-950 md:text-5xl">{post.data.title}</h1>
    <Figure id={imageId} eager class="mt-6" />
    <p class="mt-3 flex items-center gap-3 text-sm text-ink-soft">
      <img class="h-10 w-10 rounded-full object-cover object-[center_20%]" src="/mensen/niels-alderding-avatar.webp" width="160" height="160" alt="" />
      <span>Niels Alderding, oprichter van Matchvermogen, namens Arbopartner Brabant. Gepubliceerd {iso(post.data.pubDate)}. Bijgewerkt {iso(post.data.updated)}. Dit is algemene informatie voor werkgevers, geen advies over één dossier.</span>
    </p>
    <div class="prose-ap mt-6">
      <Content />
    </div>
    <AuthorBlock />
    <FaqList items={post.data.faq} />
    <section class="mt-10">
      <h2 class="font-serif text-3xl text-green-950">Bronnen</h2>
      <ul class="mt-3 space-y-3 text-sm">
        {post.data.sources.map((source) => (
          <li>
            <a class="font-semibold text-green-800 underline decoration-ochre-500" href={source.url}>{source.title}</a>
            {source.note && <span> — {source.note}</span>}
          </li>
        ))}
      </ul>
    </section>
    {post.data.related.length > 0 && (
      <p class="mt-6 text-sm">
        Verder lezen:
        {post.data.related.map((slug, index) => (
          <span>
            {index > 0 && " · "}
            <a class="underline" href={`/blog/${slug}`}>{slug.replaceAll("-", " ")}</a>
          </span>
        ))}
      </p>
    )}
  </article>
  <div class="mx-auto max-w-3xl px-4">
    <InlineLead source={`blog-${post.id}`} title="Vraag over dit onderwerp" text="Twee stappen. We bellen terug. Dit is algemene informatie op de pagina; het formulier is geen advies over één dossier." />
  </div>
  <ClusterNav />
  <CtaBand />
</Base>
