---
import Figure from "../../components/Figure.astro";
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import CtaBand from "../../components/CtaBand.astro";
import ReviewCard from "../../components/ReviewCard.astro";
import { levels, monthlyCost } from "../../lib/rates";
import { euro } from "../../lib/format";
import { monthLine, packages, riskReversal, savingLine } from "../../lib/pricing";
import { site } from "../../data/site";
import { reviews } from "../../data/reviews";
import { crumbsLd } from "../../lib/schema";

export function getStaticPaths() {
  return packages.map((pack) => ({ params: { slug: pack.slug }, props: { pack } }));
}

const { pack } = Astro.props;
const crumbs = [
  { name: "Home", path: "/" },
  { name: "Pakketten", path: "/pakketten" },
  { name: pack.name, path: `/pakketten/${pack.slug}` },
];
const review = reviews.find((item) => item.name === "Heidi Wichems") ?? reviews[0];
---

<Base title={`Pakket ${pack.name}`} description={`${pack.concrete}. ${pack.summary} Richtprijzen exclusief btw, per maand en per uur.`} jsonLd={[crumbsLd(crumbs)]}>
  <Breadcrumbs crumbs={crumbs} />
  <article class="mx-auto max-w-3xl px-4 pt-6">
    <p class="text-sm font-semibold uppercase tracking-[0.14em] text-ochre-800">{pack.concrete}</p>
    <h1 class="mt-2 font-serif text-5xl text-green-950">Pakket {pack.name}</h1>
    <Figure id={`pagina-pakket-${pack.slug}`} eager class="mt-6" />
    {pack.featured && <p class="ap-badge mt-4 inline-flex rounded-full px-3 py-1 text-sm font-semibold">Richtadvies</p>}
    <p class="mt-4 text-lg">{pack.summary}</p>
    <ul class="mt-4 list-disc space-y-2 pl-5">
      {pack.outcomes.map((point) => <li>{point}</li>)}
    </ul>
    <p class="mt-4 text-sm">{riskReversal}</p>
    <p class="mt-3">Achtervang: arbeidsdeskundige via Matchvermogen met {site.discount.arbeidsdeskundige}% korting, tweede spoor via Best Match met {site.discount.tweedeSpoor}% korting.</p>
    <table class="mt-6 w-full text-left">
      <caption class="mb-2 text-left font-semibold">Richtprijs per maand, exclusief btw, bij {pack.hours === 24 ? "24 uur of meer" : `${pack.hours} uur`} per week</caption>
      <thead>
        <tr class="border-b border-line">
          <th class="py-2" scope="col">Niveau</th>
          <th scope="col">Per maand</th>
          <th scope="col">Per uur</th>
        </tr>
      </thead>
      <tbody>
        {Object.values(levels).map((level) => {
          const rate = level.rates[pack.hours];
          const note = pack.hours === 10 ? "Referentietarief van dit niveau." : savingLine(level.id, pack.hours);
          return (
            <tr class="border-b border-line align-top">
              <th class="py-3 pr-3 font-semibold" scope="row">{level.label}</th>
              <td class="py-3 pr-3">
                <span class="block font-semibold">{euro(monthlyCost(pack.hours, rate))}</span>
                <span class="block text-sm text-ink-soft">{monthLine(pack.hours, rate)}</span>
              </td>
              <td class="py-3">
                <span class="block">{euro(rate)}</span>
                <span class="mt-1 block text-sm text-ink-soft">{note}</span>
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
    <p class="mt-3 text-sm text-ink-soft">Een offerte kan afwijken. <a class="underline" href="/tarieven">Alle tarieven</a>.</p>
    <div class="mt-6 flex flex-col gap-3 sm:flex-row">
      <a class="rounded-full bg-green-800 px-5 py-3 text-center font-semibold" data-cta={`pakket-${pack.slug}-offerte`} href={`/offerte?pakket=${encodeURIComponent(pack.offer)}`}>Offerte voor {pack.name}</a>
      <a class="rounded-full border border-green-800 px-5 py-3 text-center font-semibold" data-cta={`pakket-${pack.slug}-advies`} href="/adviesgesprek">Vrijblijvend kennismaken</a>
    </div>
    <h2 class="mt-12 font-serif text-3xl text-green-950">Ervaring bij het moederbedrijf</h2>
    <p class="mt-2 text-sm">Dit citaat gaat over Matchvermogen, niet over pakket {pack.name}.</p>
    <div class="mt-4">
      <ReviewCard review={review} />
    </div>
  </article>
  <CtaBand title={`Offerte voor ${pack.name}`} text="Drie korte stappen, in een paar minuten. Daarna rekenen we een voorstel. Het gesprek verplicht u tot niets." />
</Base>
