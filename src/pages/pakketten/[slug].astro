---
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import CtaBand from "../../components/CtaBand.astro";
import { levels, monthlyCost, verzuimanalysePrijs, type Block } from "../../lib/rates";
import { euro } from "../../lib/format";
import { site } from "../../data/site";
import { crumbsLd } from "../../lib/schema";

const pages: Record<string, { name: string; hours: Block; intro: string; points: string[] }> = {
  basis: {
    name: "Basis",
    hours: 10,
    intro: "Tien uur per week is genoeg als u een beperkt aantal dossiers heeft en iemand zoekt die ze vasthoudt. Geen rapportagefabriek, wel een vast gezicht.",
    points: [
      "Eén casemanager, niveau naar keuze.",
      "Wekelijks op locatie of in een vast dagdeel.",
      "Geschikt als start, ook als u later naar twintig uur wilt.",
      "Verzuimanalyse is los beschikbaar, niet inbegrepen.",
    ],
  },
  premium: {
    name: "Premium",
    hours: 20,
    intro: "Twintig uur per week voor organisaties met meerdere langdurige dossiers of weinig eigen HR. U krijgt elk kwartaal een korte rapportage en in het eerste jaar een verzuimanalyse.",
    points: [
      `Verzuimanalyse van ${euro(verzuimanalysePrijs, true)} in het eerste jaar inbegrepen.`,
      "Kwartaalrapportage: instroom, duur en dossiers zonder plan.",
      "Ruimte om leidinggevenden te coachen, niet alleen dossiers te schrijven.",
      "Niveau medior, medior+ of senior.",
    ],
  },
  pro: {
    name: "Pro",
    hours: 24,
    intro: "Vanaf 24 uur per week, voor grotere vestigingen of een stapel complexe dossiers. Vanaf 30 uur zetten we twee casemanagers in, zodat vakantie of ziekte de boel niet stillegt.",
    points: [
      "Alles uit Premium.",
      "Vanaf 30 uur twee personen op uw dossiers.",
      "Het uurtarief is het 24+-tarief, ook als u meer dan 24 uur afneemt.",
      "Passend bij 200+ medewerkers of een hoog aandeel psychisch verzuim.",
    ],
  },
};

export function getStaticPaths() {
  return ["basis", "premium", "pro"].map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const page = pages[slug];
const crumbs = [
  { name: "Home", path: "/" },
  { name: "Pakketten", path: "/pakketten" },
  { name: page.name, path: `/pakketten/${slug}` },
];
---

<Base title={`Pakket ${page.name}`} description={page.intro} jsonLd={[crumbsLd(crumbs)]}>
  <Breadcrumbs crumbs={crumbs} />
  <article class="mx-auto max-w-3xl px-4 pt-6">
    <h1 class="font-serif text-5xl text-green-950">Pakket {page.name}</h1>
    <p class="mt-4 text-lg">{page.intro}</p>
    <ul class="mt-4 list-disc space-y-2 pl-5">
      {page.points.map((point) => <li>{point}</li>)}
    </ul>
    <p class="mt-4">Achtervang: arbeidsdeskundige via Matchvermogen met {site.discount.arbeidsdeskundige}% korting, tweede spoor via Best Match met {site.discount.tweedeSpoor}% korting.</p>
    <table class="mt-6 w-full text-left">
      <caption class="mb-2 text-left font-semibold">Richtprijs per maand, exclusief btw, bij {page.hours} uur per week</caption>
      <thead>
        <tr class="border-b border-line"><th class="py-2">Niveau</th><th>Per uur</th><th>Per maand</th></tr>
      </thead>
      <tbody>
        {Object.values(levels).map((level) => (
          <tr class="border-b border-line">
            <td class="py-2">{level.label}</td>
            <td>{euro(level.rates[page.hours])}</td>
            <td>{euro(monthlyCost(page.hours, level.rates[page.hours]))}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="mt-3 text-sm text-ink-soft">Berekend als uren × tarief × 52 / 12. Een offerte kan afwijken. <a class="underline" href="/tarieven">Alle tarieven</a>.</p>
  </article>
  <CtaBand title={`Offerte voor ${page.name}`} text="In drie stappen vertelt u omvang, situatie en pakket. We rekenen daarna een voorstel uit." />
</Base>
