---
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ClusterNav from "../../components/ClusterNav.astro";
import CtaBand from "../../components/CtaBand.astro";
import PackageGrid from "../../components/PackageGrid.astro";
import { crumbsLd } from "../../lib/schema";

const crumbs = [
  { name: "Home", path: "/" },
  { name: "Pakketten", path: "/pakketten" },
];
---

<Base title="Pakketten" description="Basis, Premium en Pro. Maandbedrag en uurtarief per niveau, exclusief btw. Premium is het blok dat we als eerste voorleggen." jsonLd={[crumbsLd(crumbs)]}>
  <Breadcrumbs crumbs={crumbs} />
  <header class="mx-auto max-w-6xl px-4 pt-6">
    <h1 class="font-serif text-5xl text-green-950">Pakketten</h1>
    <p class="mt-4 max-w-3xl text-lg">Een pakket is een vast uurblok voor een gedetacheerde casemanager. Basis is tien uur, Premium twintig, Pro vanaf 24. Het niveau bepaalt wie er komt. Het maandbedrag rekent u als uren × uurtarief × 52 / 12.</p>
  </header>
  <div class="pt-8">
    <PackageGrid />
  </div>
  <ClusterNav />
  <CtaBand title="Offerte in een paar minuten" text="Drie korte stappen. U kiest het blok, wij rekenen het voorstel. Het adviesgesprek verplicht u tot niets." />
</Base>
