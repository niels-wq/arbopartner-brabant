---
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { site, phoneHref } from "../data/site";
import { crumbsLd } from "../lib/schema";

const crumbs = [
  { name: "Home", path: "/" },
  { name: "Adviesgesprek", path: "/adviesgesprek" },
];
---

<Base title="Adviesgesprek" description="Gratis adviesgesprek van 30 minuten over uw verzuimdossiers. Geen verkooppraatje." jsonLd={[crumbsLd(crumbs)]}>
  <Breadcrumbs crumbs={crumbs} />
  <article class="mx-auto grid max-w-6xl gap-8 px-4 pt-6 lg:grid-cols-2">
    <div>
      <h1 class="font-serif text-5xl text-green-950">Dertig minuten, zonder verplichting</h1>
      <p class="mt-4 text-lg">We kijken of een vaste casemanager past, welk niveau, en of u eerst een analyse nodig heeft. U hoeft niets af te nemen.</p>
      <p class="mt-4 rounded-3xl bg-ochre-200 px-4 py-3 text-sm">{site.placeholders.agenda}</p>
      <p class="mt-4">Liever bellen: <a class="font-semibold underline" href={phoneHref}>{site.parent.phoneDisplay}</a>.</p>
    </div>
    <form class="space-y-3 rounded-[2rem] border border-line bg-white/80 p-5" data-endpoint="/api/advies" data-kind="advies">
      <label class="block">Naam<input class="field" name="naam" required /></label>
      <label class="block">Organisatie<input class="field" name="organisatie" required /></label>
      <label class="block">E-mail<input class="field" name="email" type="email" required /></label>
      <label class="block">Telefoon<input class="field" name="telefoon" type="tel" required /></label>
      <label class="block">Voorkeur voor dag of dagdeel<input class="field" name="voorkeur" required /></label>
      <label class="block">Waar wilt u het over hebben?<textarea class="field min-h-28" name="vraag" required></textarea></label>
      <label class="flex items-start gap-2 text-sm">
        <input type="checkbox" name="toestemming" value="ja" required />
        <span>Matchvermogen B.V. mag contact opnemen over deze afspraak. <a class="underline" href="/privacy">Privacy</a></span>
      </label>
      <div class="absolute -left-[9999px]" aria-hidden="true"><label>Website<input name="company_website" tabindex="-1" autocomplete="off" /></label></div>
      <button class="rounded-full bg-green-800 px-5 py-3 font-semibold text-sand-50" type="submit">Vraag het gesprek aan</button>
      <p data-status class="text-sm" role="status"></p>
    </form>
  </article>
</Base>

<style>
  .field { display: block; margin-top: 0.25rem; width: 100%; border: 1px solid var(--color-line); border-radius: 0.9rem; padding: 0.55rem 0.75rem; background: white; }
</style>

<script>
  import "../scripts/forms.ts";
</script>
