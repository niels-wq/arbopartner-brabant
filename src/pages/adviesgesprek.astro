---
import MedewerkersVeld from "../components/MedewerkersVeld.astro";
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import CalendlyEmbed from "../components/CalendlyEmbed.astro";
import Figure from "../components/Figure.astro";
import OfficeVisit from "../components/OfficeVisit.astro";
import { officeConversation, site, phoneHref } from "../data/site";
import { crumbsLd } from "../lib/schema";

const crumbs = [
  { name: "Home", path: "/" },
  { name: "Adviesgesprek", path: "/adviesgesprek" },
];
---

<Base title="Adviesgesprek" description="Gratis adviesgesprek van 30 minuten, op het kantoor in Uden, bij u op het bedrijf of online. Geen verkooppraatje." jsonLd={[crumbsLd(crumbs)]}>
  <Breadcrumbs crumbs={crumbs} />
  <article class="mx-auto grid max-w-6xl gap-8 px-4 pt-6 lg:grid-cols-2">
    <div>
      <h1 class="font-serif text-5xl text-green-950">Dertig minuten, zonder verplichting</h1>
      <Figure id="pagina-advies" eager class="mt-6" />
      <p class="mt-4 text-lg">Een adviesgesprek is een gratis gesprek van 30 minuten over uw verzuimdossiers. We kijken of een vaste casemanager past, welk niveau, en of u eerst een analyse nodig heeft. U hoeft niets af te nemen. Het gesprek kan op het kantoor in Uden, bij u op het bedrijf of online.</p>
      <p class="mt-4">Op kantoor, {site.parent.street} in {site.parent.city}, is het {officeConversation.place.charAt(0).toLowerCase()}{officeConversation.place.slice(1)} Voor de begeleiding zelf komen werknemers daarheen. {officeConversation.threshold} {officeConversation.employer} {officeConversation.care}</p>
      <a class="mt-5 inline-block rounded-full bg-green-800 px-5 py-3 font-semibold text-sand-50" data-cta="advies-kantoor" href="#afspraak">Plan een gesprek op ons kantoor</a>
      <p class="mt-4">Liever bellen: <a class="font-semibold underline" href={phoneHref}>{site.parent.phoneDisplay}</a>.</p>
    </div>
    <form id="afspraak" class="scroll-mt-24 space-y-3 rounded-[2rem] border border-line bg-white/80 p-5" data-endpoint="/api/advies" data-kind="advies" data-cta="adviesgesprek">
      <h2 class="font-serif text-3xl text-green-950">Plan een gesprek op ons kantoor</h2>
      <label class="block">Waar wilt u het gesprek?
        <select class="field" name="plek">
          <option value="Op het kantoor in Uden, Losplaats 16d">Op het kantoor in Uden</option>
          <option value="Bij de werkgever">Bij de werkgever</option>
          <option value="Online">Online</option>
        </select>
      </label>
      <label class="block">Naam<input class="field" name="naam" required autocomplete="name" /></label>
      <label class="block">Bedrijf<input class="field" name="organisatie" required autocomplete="organization" /></label>
      <label class="block">Telefoon<input class="field" name="telefoon" type="tel" required autocomplete="tel" /></label>
      <MedewerkersVeld />
      <label class="block">E-mail, als u wilt<input class="field" name="email" type="email" autocomplete="email" /></label>
      <label class="block">Waar wilt u het over hebben?<textarea class="field min-h-20" name="vraag" maxlength="1000"></textarea></label>
      <label class="flex items-start gap-2 text-sm">
        <input type="checkbox" name="toestemming" value="ja" required />
        <span>Matchvermogen B.V. mag contact opnemen over deze afspraak. <a class="underline" href="/privacy">Privacy</a></span>
      </label>
      <div class="absolute -left-[9999px]" aria-hidden="true"><label>Website<input name="company_website" tabindex="-1" autocomplete="off" /></label></div>
      <button class="rounded-full bg-green-800 px-5 py-3 font-semibold text-sand-50" type="submit">Vraag het gesprek aan</button>
      <p data-status class="text-sm" role="status"></p>
    </form>
  </article>
  <div class="mx-auto max-w-6xl px-4 py-8">
    <CalendlyEmbed />
  </div>
  <div class="mx-auto max-w-6xl px-4 pb-8">
    <OfficeVisit cta={false} />
  </div>
</Base>

<style>
  .field { display: block; margin-top: 0.25rem; width: 100%; border: 1px solid var(--color-line); border-radius: 0.9rem; padding: 0.55rem 0.75rem; background: white; }
</style>

<script>
  import "../scripts/forms.ts";

  const plek = new URLSearchParams(window.location.search).get("plek");
  const select = document.querySelector<HTMLSelectElement>("#afspraak [name=plek]");
  const choice: Record<string, string> = {
    kantoor: "Op het kantoor in Uden, Losplaats 16d",
    werkgever: "Bij de werkgever",
    online: "Online",
  };
  if (select && plek && choice[plek]) select.value = choice[plek];
</script>
