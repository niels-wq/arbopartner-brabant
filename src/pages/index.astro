---
import Base from "../layouts/Base.astro";
import CostTeaser from "../components/CostTeaser.astro";
import CtaBand from "../components/CtaBand.astro";
import ClusterNav from "../components/ClusterNav.astro";
import FaqList from "../components/FaqList.astro";
import HireBenefits from "../components/HireBenefits.astro";
import ReviewCard from "../components/ReviewCard.astro";
import { calendlyKennismaking } from "../data/calendly";
import { mapsDirectionsHref, officeConversation, site, zzpFaq } from "../data/site";
import { reviewsAboutNiels } from "../data/reviews";
import Button from "../components/Button.astro";
import CalendlyButton from "../components/CalendlyButton.astro";
import Guarantees from "../components/Guarantees.astro";
import { qualityFaq } from "../data/garanties";
import TeamStrip from "../components/TeamStrip.astro";
import BrabantMap from "../components/BrabantMap.astro";
import VerzuimTijdlijn from "../components/VerzuimTijdlijn.astro";
import AndersDanArbodienst from "../components/AndersDanArbodienst.astro";
import Situaties from "../components/Situaties.astro";
import Feiten from "../components/Feiten.astro";
import Photo from "../components/Photo.astro";
import { faqLd, teamPeopleLd } from "../lib/schema";
import { verzuimsysteem } from "../data/verzuimsysteem";
import SpoedBand from "../components/SpoedBand.astro";
import PraktijkTeasers from "../components/PraktijkTeasers.astro";

const faq = [
  {
    q: "Voor wie is Arbopartner Brabant?",
    a: `Voor organisaties met 35–500 medewerkers in Noord-Brabant. De thuisbasis en het kantoor staan in Uden, aan de Losplaats 16d. Reistijd binnen ongeveer 45 minuten van dat kantoor zit in het tarief. Ligt het adres verder in Brabant, dan staat de rit in de offerte. Kleinere organisaties en particulieren verwijzen we door naar een gerichte opdracht bij Matchvermogen, niet naar een wekelijks blok. Meer dan ${site.maxEmployees} medewerkers valt buiten Arbopartner Brabant.`,
  },
  {
    q: "Zijn jullie een arbodienst?",
    a: "Een arbodienst richt zich op verzuimbegeleiding, de bedrijfsarts en de stappen in de eerste twee ziektejaren. Wij vullen aan met senior casemanagers en gaan verder op de keten tot en met 12 jaar WGA en de Ziektewet. De bedrijfsarts blijft u zelf organiseren.",
  },
  {
    q: "Wat is het verschil met iemand in dienst nemen?",
    a: "U betaalt de uren die u afneemt. Een fulltime kracht betaalt u ook bij een lage caseload. De vergelijking rekent de jaarkosten met bronnen die u aanpast. Bij een bijna volle werkweek kan een dienstverband in euro's lager zijn. Dan laat de tool dat zien, en blijven continuïteit, onafhankelijkheid en het ontbreken van werkgeversrisico staan. De wijzigingstermijn van de uren staat in de offerte.",
  },
  {
    q: "Van wie zijn de reviews?",
    a: "Van Matchvermogen, ons moederbedrijf. Ze staan letterlijk op matchvermogen.nl en gaan niet over Arbopartner Brabant. We hebben nog geen eigen reviews.",
  },
  zzpFaq,
  qualityFaq,
];

const jsonLd = [faqLd(faq), ...teamPeopleLd()];
---

<Base
  home
  title="Casemanager en arbo in Brabant | Arbopartner Brabant"
  description={site.description}
  jsonLd={jsonLd}
>
  <section class="mx-auto grid max-w-6xl items-center gap-10 px-4 pb-6 pt-12 md:grid-cols-[1.15fr_0.85fr] md:pt-20">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.16em] text-ochre-800">{site.labelStatement}</p>
      <h1 class="mt-3 max-w-xl text-4xl text-green-950 md:text-6xl">Casemanager en arbo in Brabant.</h1>
      <p class="mt-5 max-w-xl text-lg text-ink-soft">Nuchter, dichtbij, Brabants. Arbopartner Brabant hoort bij Matchvermogen B.V. en detacheert een vaste casemanager {site.audience} in heel Noord-Brabant. Het kantoor staat in Uden, aan de Losplaats 16d. Uw arbodienst en bedrijfsarts blijven. Een arbeidsdeskundige van Matchvermogen staat als achtervang klaar, met {site.discount.arbeidsdeskundige}% korting op dat onderzoek.</p>
      <div class="mt-8">
        <Button data-cta="home-advies" href="/adviesgesprek">Plan een adviesgesprek</Button>
        <p class="mt-2 text-sm text-ink-soft">Het gesprek van 30 minuten verplicht u tot niets.</p>
        <p class="mt-3 max-w-xl text-sm text-ink-soft">
          Liever eerst kort kennismaken?
          <CalendlyButton inline cta="home-calendly" />
          <span> — 15 minuten, vrijblijvend.</span>
          <a class="ml-1 font-semibold text-green-800 underline" data-cta="home-spoed" href="/spoedhulp">Ik heb nu een probleem</a>
        </p>
      </div>
      <ul class="mt-6 flex flex-wrap gap-2 text-sm font-semibold" aria-label="Vertrouwen">
        <li class="rounded-full bg-white px-3 py-1 text-green-950 ring-1 ring-line">Van Matchvermogen</li>
        <li class="rounded-full bg-white px-3 py-1 text-green-950 ring-1 ring-line">KvK {site.parent.kvk}</li>
        <li><a class="inline-block rounded-full bg-white px-3 py-1 text-green-950 ring-1 ring-line" data-cta="home-reviews" href="/reviews">Reviews van Matchvermogen</a></li>
        <li><a class="inline-block rounded-full bg-white px-3 py-1 text-green-950 ring-1 ring-line" data-cta="home-werkgebied" href="/werkgebied">Werkgebied: heel Noord-Brabant</a></li>
      </ul>
    </div>
    <aside>
      <Photo id="gesprek-bank" eager sizes="(min-width: 768px) 28rem, 100vw" />
      <div class="mt-4 rounded-2xl border border-line bg-white p-6">
        <img class="niels-face h-20 w-20 rounded-full" src={site.founder.avatar} width="240" height="240" alt="Niels Alderding" />
        <p class="mt-4 text-lg font-semibold text-green-950">{site.founder.name}</p>
        <p class="text-sm text-ink-soft">{site.founder.role}</p>
        <blockquote class="mt-3 text-lg leading-snug text-green-950">
          <p>{site.founder.quote}</p>
        </blockquote>
        <p class="mt-3 text-sm text-ink-soft">
          Citaat: <a class="underline" href={site.founder.quoteUrl}>arbeidsdeskundig.com</a>.
        </p>
      </div>
    </aside>
  </section>

  <SpoedBand />

  <AndersDanArbodienst />

  <Guarantees plaats="home" />

  <div class="pt-2">
    <CostTeaser />
  </div>

  <section class="mx-auto max-w-3xl px-4 py-16">
    <h2 class="font-serif text-3xl text-green-950">Wat u niet krijgt</h2>
    <ul class="mt-4 space-y-2 text-ink-soft">
      <li>Geen wisselend loket.</li>
      <li>Geen nacalculatie voor reistijd binnen ongeveer 45 minuten van Uden.</li>
      <li>Geen vast percentage vooraf. Na een analyse laten we zien hoe het verzuim kan dalen.</li>
      <li>Geen verzonnen besparing als u bijna een volle werkweek nodig heeft.</li>
    </ul>
  </section>

  <section class="mx-auto grid max-w-6xl gap-6 px-4 pb-8 md:grid-cols-3" aria-label="Keuzehulp">
    <a class="overflow-hidden rounded-2xl border border-line bg-white" data-cta="home-kaart-spoed" href="/spoedhulp">
      <Photo id="gesprek-documenten" plain sizes="(min-width: 768px) 20rem, 100vw" />
      <div class="p-6">
      <h2 class="font-serif text-2xl text-green-950">Ik heb nu een verzuimprobleem</h2>
      <p class="mt-2 text-ink-soft">Een zieke medewerker, een vastgelopen dossier of een sanctierisico. Bel, app of laat u terugbellen.</p>
      <span class="mt-4 inline-block font-semibold text-green-800">Naar spoedhulp</span>
      </div>
    </a>
    <a class="overflow-hidden rounded-2xl border border-line bg-white" data-cta="home-kaart-pakket" href="/pakketten">
      <Photo id="gesprek-drie" plain sizes="(min-width: 768px) 20rem, 100vw" />
      <div class="p-6">
      <h2 class="font-serif text-2xl text-green-950">Ik wil verzuim structureel regelen</h2>
      <p class="mt-2 text-ink-soft">Basis, Premium of Pro. Eén niveau casemanager, een vast aantal uren, een vast gezicht.</p>
      <span class="mt-4 inline-block font-semibold text-green-800">Bekijk de pakketten</span>
      </div>
    </a>
    <a class="overflow-hidden rounded-2xl border border-line bg-white" data-cta="home-kaart-kosten" href="/verzuimkosten-berekenen">
      <Photo id="werkplek-notitie" plain sizes="(min-width: 768px) 20rem, 100vw" />
      <div class="p-6">
      <h2 class="font-serif text-2xl text-green-950">Wat kost verzuim mij?</h2>
      <p class="mt-2 text-ink-soft">Reken met de TNO-dagkosten en kies zelf een scenario. Geen belofte, wel een bedrag.</p>
      <span class="mt-4 inline-block font-semibold text-green-800">Reken het zelf</span>
      </div>
    </a>
  </section>

  <div class="mx-auto max-w-6xl px-4 pb-8">
    <PraktijkTeasers kop="Twee praktijkvoorbeelden" />
  </div>

  <Situaties compact />

  <Feiten />

  <section class="mx-auto max-w-6xl px-4 py-16">
    <h2 class="font-serif text-3xl text-green-950">Eén mens, met een zwaardere achtervang</h2>
    <Photo id="gesprek-advies" class="mt-6 max-w-3xl" />
    <div class="mt-8 grid gap-4 md:grid-cols-2">
      <article class="rounded-2xl border border-line bg-white p-6">
        <h3 class="font-serif text-2xl text-green-950">Vaste casemanager</h3>
        <p class="mt-2 text-ink-soft">Medior, medior+ of senior. Dezelfde persoon elke week, op uw locatie of op het kantoor in Uden. Uren schalen mee met de dossiers.</p>
      </article>
      <article class="rounded-2xl border border-line bg-white p-6">
        <h3 class="font-serif text-2xl text-green-950">Arbeidsdeskundige erachter</h3>
        <p class="mt-2 text-ink-soft">Via Matchvermogen, tegen een lager tarief dan los inkopen. De onderzoeker is niet dezelfde persoon als de begeleider. Het percentage bevestigen we in de offerte.</p>
      </article>
      <article class="rounded-2xl border border-line bg-white p-6">
        <h3 class="font-serif text-2xl text-green-950">Tweede spoor als het moet</h3>
        <p class="mt-2 text-ink-soft">Via Best Match, op tijd, niet in de laatste maand van het tweede jaar. De korting via het netwerk bevestigen we in de offerte.</p>
      </article>
      <article class="rounded-2xl border border-line bg-white p-6">
        <h3 class="font-serif text-2xl text-green-950">Gesprek op ons kantoor</h3>
        <p class="mt-2 text-ink-soft">Werknemer en werkgever komen naar Losplaats 16d in Uden. {officeConversation.place} {officeConversation.threshold} {officeConversation.employer} {officeConversation.care}</p>
        <a class="mt-3 inline-block font-semibold text-green-900 underline decoration-ochre-500" data-cta="home-kantoor" href="/adviesgesprek?plek=kantoor#afspraak">Plan een gesprek op ons kantoor</a>
      </article>
      <article class="rounded-2xl border border-line bg-white p-6 md:col-span-2">
        <h3 class="font-serif text-2xl text-green-950">{verzuimsysteem.title}</h3>
        <p class="mt-2 text-ink-soft">{verzuimsysteem.text}</p>
      </article>
    </div>
    <p class="mt-8"><a class="font-semibold text-green-900 underline decoration-ochre-500" data-cta="home-diensten" href="/diensten">Bekijk de diensten</a> of <a class="font-semibold text-green-900 underline decoration-ochre-500" data-cta="home-advies-sectie" href="/adviesgesprek">plan een adviesgesprek van 30 minuten</a>. Dat gesprek verplicht u tot niets.</p>
  </section>

  <HireBenefits />

  <TeamStrip />

  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="flex items-end justify-between gap-4">
      <h2 class="font-serif text-3xl text-green-950">Wat opdrachtgevers over Niels schreven</h2>
      <a class="hidden font-semibold text-green-800 sm:inline" data-cta="home-reviews-kop" href="/reviews">Alle citaten</a>
    </div>
    <p class="mt-2 max-w-2xl text-sm text-ink-soft">Deze citaten noemen Niels en staan letterlijk op matchvermogen.nl. Ze gaan over het moederbedrijf, niet over Arbopartner Brabant.</p>
    <div class="mt-5 grid gap-4 md:grid-cols-3">
      {reviewsAboutNiels().slice(0, 3).map((review) => <ReviewCard review={review} />)}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16" aria-labelledby="ontvangst-kop">
    <h2 id="ontvangst-kop" class="font-serif text-3xl text-green-950">Hier ontvangen wij uw medewerkers</h2>
    <p class="mt-2 max-w-2xl text-ink-soft">Op het hoofdkantoor in Uden, en ook op locatie bij u op de werkvloer, door heel Brabant.</p>
    <div class="mt-6 grid items-start gap-6 lg:grid-cols-2">
      <BrabantMap pins="kantoor" />
      <article class="overflow-hidden rounded-2xl border border-line bg-white">
        <Photo id="gesprek-werkgever" plain kader="natuurlijk" sizes="(min-width: 1024px) 36rem, 100vw" />
        <div class="p-5">
          <p class="text-sm font-semibold uppercase tracking-[0.14em] text-ochre-800">Hoofdkantoor</p>
          <h3 class="mt-1 font-serif text-2xl text-green-950">{site.parent.city}</h3>
          <address class="mt-2 not-italic text-ink-soft">
            {site.parent.legalName}<br />
            {site.parent.street}<br />
            {site.parent.postalCode} {site.parent.city}
          </address>
          <p class="mt-4 flex flex-wrap items-center gap-3">
            <a class="font-semibold text-green-900 underline decoration-ochre-500" data-cta="home-route-uden" href={mapsDirectionsHref} rel="noopener noreferrer">Route</a>
            <CalendlyButton cta="home-locatie-uden" label="Plan een gesprek op locatie" />
          </p>
          <p class="mt-3 text-sm text-ink-soft">{calendlyKennismaking.note}</p>
        </div>
      </article>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-4" aria-labelledby="hulpen-kop">
    <h2 id="hulpen-kop" class="font-serif text-3xl text-green-950">Hulpen bij een lopend dossier</h2>
    <p class="mt-2 max-w-2xl text-ink-soft">Twee vragen die een werkgever zelf kan beantwoorden voordat er iemand meekijkt. Geen offerte en geen oordeel van UWV.</p>
    <div class="mt-6 grid gap-4 md:grid-cols-2">
      <a class="rounded-[2rem] border border-line bg-white/80 p-6" data-cta="home-risicoscan" href="/loonsanctie-risicoscan">
        <h3 class="font-serif text-2xl text-green-950">Loonsanctie-risicoscan</h3>
        <p class="mt-2 text-ink-soft">Tien vragen over één zieke medewerker. U ziet een risico en per punt een concreet advies.</p>
      </a>
      <a class="rounded-[2rem] border border-line bg-white/80 p-6" data-cta="home-verzuim-tijdlijn" href="/verzuim-tijdlijn">
        <h3 class="font-serif text-2xl text-green-950">Verzuim-tijdlijn</h3>
        <p class="mt-2 text-ink-soft">Vul de eerste ziektedag in. U krijgt de data, een tip per moment en een agenda-bestand.</p>
      </a>
    </div>
  </section>

  <VerzuimTijdlijn />

  <ClusterNav />

  <div class="mx-auto max-w-6xl px-4">
    <FaqList items={faq} />
  </div>
  <CtaBand />
</Base>
