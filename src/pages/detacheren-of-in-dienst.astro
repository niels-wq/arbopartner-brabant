---
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import CompareCalc from "../components/calculators/CompareCalc.astro";
import { crumbsLd, faqLd } from "../lib/schema";

const crumbs = [
  { name: "Home", path: "/" },
  { name: "Detacheren of in dienst", path: "/detacheren-of-in-dienst" },
];
const faq = [
  {
    q: "Claimen jullie dat detacheren goedkoper is?",
    a: "Nee. De calculator zet de kosten per productief uur naast elkaar. Een lager bedrag is geen belofte en geen verkoopargument. De reden om te detacheren is zekerheid en flexibiliteit.",
  },
  {
    q: "Wat telt als een productief uur?",
    a: "Bij detachering: elk uur dat u afneemt. Bij een dienstverband: contracturen min wettelijk verlof, feestdagen, verzuim en een leeglooppercentage voor overleg, reizen, scholing en administratie. Leegloop en feestdagen zijn gelabelde aannames.",
  },
  {
    q: "Waarom staat de transitievergoeding niet in het uurtarief?",
    a: "Die betaalt u alleen als het dienstverband eindigt. We tonen een illustratie na drie jaar, buiten de uurprijs. Bij detachering bouwt u die vergoeding niet op.",
  },
];
---

<Base title="Detacheren of zelf een casemanager in dienst" description="Vergelijk de kosten per productief uur. Indicatie, geen offerte. Zekerheid en flexibiliteit staan voorop, niet een prijsclaim." jsonLd={[crumbsLd(crumbs), faqLd(faq)]}>
  <Breadcrumbs crumbs={crumbs} />
  <header class="mx-auto max-w-6xl px-4 pt-6">
    <h1 class="font-serif text-5xl text-green-950">Detacheren of iemand in dienst nemen</h1>
    <p class="mt-4 max-w-3xl text-lg">Een contractuur is geen productief uur. Verlof, verzuim, werving en een lege stoel zitten in de kostprijs van een dienstverband. Bij detachering koopt u de uren die u nodig heeft, met vervanging en zonder transitievergoeding. De uitkomst is een indicatie, geen offerte.</p>
    <ul class="mt-4 grid gap-2 text-green-950 sm:grid-cols-2">
      <li class="rounded-2xl bg-ochre-200 px-4 py-3">Geen ziekterisico: uitval lossen wij op.</li>
      <li class="rounded-2xl bg-ochre-200 px-4 py-3">Vervanging is geregeld.</li>
      <li class="rounded-2xl bg-ochre-200 px-4 py-3">Direct inzetbaar, zonder vacaturemaand.</li>
      <li class="rounded-2xl bg-ochre-200 px-4 py-3">Maandelijks op- of afschalen.</li>
      <li class="rounded-2xl bg-ochre-200 px-4 py-3">Geen transitievergoeding.</li>
      <li class="rounded-2xl bg-ochre-200 px-4 py-3">Senior of arbeidsdeskundige als achtervang.</li>
    </ul>
  </header>
  <div class="mx-auto max-w-6xl px-4 py-8">
    <CompareCalc />
  </div>
</Base>
