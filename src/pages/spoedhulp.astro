---
import Figure from "../components/Figure.astro";
import MedewerkersVeld from "../components/MedewerkersVeld.astro";
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { site, phoneHref, whatsappHref } from "../data/site";
import { crumbsLd, faqLd } from "../lib/schema";

const crumbs = [
  { name: "Home", path: "/" },
  { name: "Spoedhulp", path: "/spoedhulp" },
];
const faq = [
  {
    q: "Bellen jullie vandaag terug?",
    a: site.placeholders.callback,
  },
  {
    q: "Wat als het dossier al bijna twee jaar loopt?",
    a: "Bel vandaag. Een WIA-aanvraag of een dreigende loonsanctie wacht niet op een kennismakingstraject van een maand. We zeggen eerlijk of we nog kunnen helpen.",
  },
];
const checks = [
  "Noteer de eerste ziektedag en de laatste werkdag.",
  "Zoek het laatste advies van de bedrijfsarts erbij.",
  "Kijk of er een plan van aanpak is, en of het is getekend.",
  "Zet op een rij welke taken de medewerker nu wel of niet doet.",
  "Meld het niet alleen bij HR, maar ook bij de leidinggevende die het werk verdeelt.",
  "Bel ons voordat u een vaststellingsovereenkomst laat tekenen.",
];
---

<Base title="Spoedhulp bij verzuim" description="Zieke medewerker of een vastgelopen dossier? Bel of app Arbopartner Brabant vandaag nog." jsonLd={[crumbsLd(crumbs), faqLd(faq)]}>
  <Breadcrumbs crumbs={crumbs} />
  <article class="mx-auto grid max-w-6xl gap-8 px-4 pt-6 lg:grid-cols-2">
    <div>
      <h1 class="font-serif text-5xl text-green-950">Zieke medewerker? Bel vandaag.</h1>
      <Figure id="pagina-spoed" eager class="mt-6" />
      <p class="mt-4 text-lg">Geen keuzemenu. U spreekt iemand van Matchvermogen B.V., het moederbedrijf achter dit label.</p>
      <p class="mt-4 text-sm">{site.placeholders.callback}</p>
      <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a class="rounded-full bg-ochre-500 px-5 py-3 text-center font-semibold" data-cta="spoed-bel" data-channel="phone" href={phoneHref}>Bel {site.parent.phoneDisplay}</a>
        <a class="btn-ghost text-center" data-cta="spoed-app" data-channel="whatsapp" href={whatsappHref}>App {site.parent.whatsappDisplay}</a>
      </div>
      <p class="mt-2 text-sm text-ink-soft">U zit nergens aan vast door te bellen.</p>
      <h2 class="mt-8 font-serif text-3xl">Eerste zes weken, een korte lijst</h2>
      <ol class="mt-3 list-decimal space-y-2 pl-5">
        {checks.map((item) => <li>{item}</li>)}
      </ol>
    </div>
    <form class="space-y-3 rounded-[2rem] bg-green-950 p-5 text-sand-50" data-endpoint="/api/spoed" data-kind="spoed">
      <h2 class="font-serif text-3xl">Laat uw nummer achter</h2>
      <label class="block text-sm">Naam<input class="field" name="naam" required /></label>
      <label class="block text-sm">Telefoon<input class="field" name="telefoon" type="tel" required /></label>
      <label class="block text-sm">Organisatie<input class="field" name="organisatie" required /></label>
      <MedewerkersVeld />
      <label class="block text-sm">Wat is er aan de hand?<textarea class="field min-h-28" name="wat" required></textarea></label>
      <label class="flex items-start gap-2 text-sm">
        <input type="checkbox" name="toestemming" value="ja" required />
        <span>U mag mij bellen over deze melding.</span>
      </label>
      <div class="absolute -left-[9999px]" aria-hidden="true"><label>Website<input name="company_website" tabindex="-1" autocomplete="off" /></label></div>
      <button class="rounded-full bg-ochre-500 px-5 py-3 font-semibold text-ink" type="submit">Vraag een terugbelverzoek</button>
      <p class="text-sm">U zit nergens aan vast. We bellen over deze melding.</p>
      <p data-status class="text-sm" role="status"></p>
    </form>
  </article>
</Base>

<style>
  .field { display: block; margin-top: 0.25rem; width: 100%; border-radius: 0.9rem; padding: 0.55rem 0.75rem; color: var(--color-ink); background: white; }
</style>

<script>
  import "../scripts/forms.ts";
</script>
