---
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Button from "../components/Button.astro";
import CtaBand from "../components/CtaBand.astro";
import FaqList from "../components/FaqList.astro";
import Inloggen from "../components/Inloggen.astro";
import Photo from "../components/Photo.astro";
import { crumbsLd, faqLd } from "../lib/schema";

const crumbs = [
  { name: "Home", path: "/" },
  { name: "Diensten", path: "/diensten" },
  { name: "arbeid.ai", path: "/arbeid-ai" },
];

const faq = [
  {
    q: "Wat is arbeid.ai?",
    a: "arbeid.ai is ontwikkeld door SevenLab in samenwerking met Matchvermogen. Wij gebruiken het samen met onze verzuimbegeleiding in Brabant. Het werkt als compleet verzuimsysteem: ziekmeldingen, verzuimregistratie, dossiers en trajecten. Ook casemanagement, arbeidsdeskundige rapportage, spoor 2 en de portalen zitten erin. In een dossier staan statussen, documenten, notities en de gegevens van de werkgever, de functies en de contactpersonen. Rapporten, zoals een arbeidsdeskundig rapport, spoor 2, een risicoscan, een functiehuis of een UWV-bezwaar, komen er als pdf in onze huisstijl uit.",
  },
  {
    q: "Ziet de werkgever medische gegevens?",
    a: "De werkgever ziet in het werkgeversportaal wat voor die rol bedoeld is, niet automatisch het hele dossier. Medische informatie deelt de werknemer met de bedrijfsarts, niet met de werkgever. Dat is het gewone uitgangspunt van de privacywet.",
  },
  {
    q: "Kan mijn medewerker ook inloggen?",
    a: "Ja. Via het cliëntportaal ziet de medewerker opdrachten, gerichte documenten en berichten. Daar horen e-mailherinneringen bij.",
  },
  {
    q: "Heb ik een eigen verzuimsysteem nodig?",
    a: "Nee. arbeid.ai kan uw verzuimsysteem volledig vervangen. Het werkt als compleet verzuimsysteem: ziekmeldingen, verzuimregistratie, dossiers en trajecten.",
  },
  {
    q: "Wordt AI gebruikt voor beslissingen?",
    a: "Nee. AI maakt een concept. Onze casemanager of arbeidsdeskundige controleert dat en beslist altijd. Een professional beoordeelt alles.",
  },
  {
    q: "Hoe is de privacy geregeld?",
    a: "De AI-verwerking gebeurt in de EU. Inloggen gaat met tweestapsverificatie. Rollen en machtiging gelden per dossier. Er is een verwerkersovereenkomst, versleuteling en ISO 27001. Gegevens worden niet gebruikt om AI-modellen te trainen.",
  },
];

const stappen = [
  {
    title: "Aanmelden of een ziekmelding",
    text: "U meldt zich, of u levert een ziekmelding en documenten aan via het werkgeversportaal.",
  },
  {
    title: "Het dossier",
    text: "Onze casemanager of arbeidsdeskundige zet het dossier op in arbeid.ai.",
  },
  {
    title: "Uw eigen portaal",
    text: "U en uw medewerker krijgen toegang tot het portaal dat bij die rol hoort.",
  },
  {
    title: "Rapporten en voortgang",
    text: "Rapporten en de voortgang staan op één plek. Rapporten ontvangt u als pdf.",
  },
];
---

<Base
  title="arbeid.ai: ons systeem voor dossiers, rapportages en portalen"
  description="arbeid.ai is een compleet verzuimsysteem bij onze verzuimbegeleiding in Brabant: ziekmeldingen, verzuimregistratie, dossiers en portalen. Ontwikkeld door SevenLab in samenwerking met Matchvermogen."
  jsonLd={[crumbsLd(crumbs), faqLd(faq)]}
>
  <Breadcrumbs crumbs={crumbs} />
  <article>
    <header class="mx-auto grid max-w-6xl items-center gap-8 px-4 pt-6 lg:grid-cols-[1.1fr_0.9fr]">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.14em] text-ochre-800">Samen met de begeleiding</p>
        <h1 class="mt-2 font-serif text-4xl text-green-950 md:text-5xl">arbeid.ai: ons systeem voor dossiers, rapportages en portalen</h1>
        <p class="mt-4 max-w-xl text-lg">Eén platform voor casemanagement, arbeidsdeskundige rapportage, spoor 2, verzuimdossiers en portalen. arbeid.ai is ontwikkeld door SevenLab in samenwerking met Matchvermogen. Onze casemanager of arbeidsdeskundige werkt erin, naast de begeleiding bij u.</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <Inloggen variant="ghost" cta="arbeid-ai-inloggen" />
          <Button data-cta="arbeid-ai-advies" href="/adviesgesprek">Plan een adviesgesprek</Button>
        </div>
        <p class="mt-3 text-sm text-ink-soft">Bent u al klant? Log in met de gegevens die u van ons kreeg.</p>
      </div>
      <Photo id="gesprek-documenten" eager sizes="(min-width: 1024px) 32rem, 100vw" />
    </header>

    <div class="mx-auto max-w-3xl px-4">
      <section class="mt-12" aria-labelledby="wat-kop">
        <h2 id="wat-kop" class="font-serif text-3xl text-green-950">Wat erin staat</h2>
        <p class="mt-3">Een dossier heeft statussen, documenten, notities en de gegevens van de werkgever, de functies en de contactpersonen. Rapporten komen er als pdf in onze huisstijl uit: arbeidsdeskundig, spoor 2, een risicoscan, een functiehuis of een UWV-bezwaar.</p>
      </section>

      <section class="mt-10" aria-labelledby="samen-kop">
        <h2 id="samen-kop" class="font-serif text-3xl text-green-950">Samen met onze dienstverlening</h2>
        <p class="mt-3">Onze casemanager of arbeidsdeskundige werkt in arbeid.ai. AI maakt een concept. Onze professional controleert dat en beslist altijd.</p>
        <p class="mt-3">arbeid.ai werkt als compleet verzuimsysteem: ziekmeldingen, verzuimregistratie, dossiers en trajecten. Het kan uw verzuimsysteem volledig vervangen.</p>
      </section>

      <section class="mt-10" aria-labelledby="portalen-kop">
        <h2 id="portalen-kop" class="font-serif text-3xl text-green-950">Twee portalen</h2>
        <div class="mt-4 grid gap-4 md:grid-cols-2">
          <article class="rounded-2xl border border-line bg-white p-5">
            <h3 class="font-serif text-2xl text-green-950">Werkgever</h3>
            <p class="mt-2">Via het werkgeversportaal levert u ziekmeldingen en documenten aan, en ontvangt u rapporten als pdf. U krijgt e-mailherinneringen. U ziet wat voor uw rol bedoeld is, niet automatisch het hele dossier.</p>
          </article>
          <article class="rounded-2xl border border-line bg-white p-5">
            <h3 class="font-serif text-2xl text-green-950">Werknemer</h3>
            <p class="mt-2">Via het cliëntportaal ziet de medewerker opdrachten, gerichte documenten en berichten, met e-mailherinneringen. Medische informatie deelt de werknemer met de bedrijfsarts, niet met de werkgever.</p>
          </article>
        </div>
      </section>

      <section class="mt-10" aria-labelledby="rollen-kop">
        <h2 id="rollen-kop" class="font-serif text-3xl text-green-950">Wie waarbij mag</h2>
        <p class="mt-3">Beheerders, medewerkers en externe professionals, bijvoorbeeld een bedrijfsarts, een arbeidsdeskundige of een spoor 2-adviseur, krijgen alleen toegang tot het dossier waarvoor ze gemachtigd zijn.</p>
      </section>

      <section class="mt-10" aria-labelledby="privacy-kop">
        <h2 id="privacy-kop" class="font-serif text-3xl text-green-950">Privacy en beveiliging</h2>
        <ul class="mt-3 list-disc space-y-2 pl-5">
          <li>AI-verwerking in de EU.</li>
          <li>Inloggen met tweestapsverificatie.</li>
          <li>Rollen en machtiging per dossier.</li>
          <li>Een verwerkersovereenkomst.</li>
          <li>Versleuteling.</li>
          <li>ISO 27001.</li>
          <li>Gegevens worden niet gebruikt om AI-modellen te trainen.</li>
        </ul>
      </section>

      <section class="mt-10" aria-labelledby="stappen-kop">
        <h2 id="stappen-kop" class="font-serif text-3xl text-green-950">Zo werkt het</h2>
        <ol class="mt-4 grid gap-3">
          {stappen.map((stap, index) => (
            <li class="flex gap-4 rounded-2xl border border-line bg-white p-4">
              <span class="font-serif text-3xl text-ochre-800">{index + 1}</span>
              <p><span class="font-semibold text-green-950">{stap.title}.</span> {stap.text}</p>
            </li>
          ))}
        </ol>
      </section>

      <section class="mt-10 rounded-[2rem] border border-line bg-sand-100 p-6" aria-labelledby="klant-kop">
        <h2 id="klant-kop" class="font-serif text-3xl text-green-950">Bent u al klant?</h2>
        <p class="mt-3">Log in met de gegevens die u van ons kreeg.</p>
        <div class="mt-5 flex flex-wrap gap-3">
          <Inloggen variant="ghost" cta="arbeid-ai-inloggen-onder" />
          <Button data-cta="arbeid-ai-offerte" href="/offerte">Vraag een offerte aan</Button>
        </div>
        <p class="mt-3 text-sm text-ink-soft">Nog geen account? Plan een adviesgesprek of vraag een offerte. Dan kijken we of arbeid.ai bij uw dossiers past.</p>
      </section>

      <FaqList items={faq} />
    </div>
  </article>
  <CtaBand
    title="Eerst kijken of het bij u past"
    text="Een adviesgesprek duurt 30 minuten. U hoeft niets af te nemen."
    href="/adviesgesprek"
    label="Plan een adviesgesprek"
  />
</Base>
