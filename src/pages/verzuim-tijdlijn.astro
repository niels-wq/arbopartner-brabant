---
import Figure from "../components/Figure.astro";
import PlanOfOfferte from "../components/PlanOfOfferte.astro";
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Button from "../components/Button.astro";
import CtaBand from "../components/CtaBand.astro";
import FaqList from "../components/FaqList.astro";
import { site } from "../data/site";
import { timelineCountingNote, timelineMilestones, timelineSources } from "../lib/verzuim-tools";
import { crumbsLd, faqLd } from "../lib/schema";

const crumbs = [
  { name: "Home", path: "/" },
  { name: "Tools", path: "/tools" },
  { name: "Verzuim-tijdlijn", path: "/verzuim-tijdlijn" },
];
const faq = [
  {
    q: "Hoe komen de data tot stand?",
    a: "Een ziekteweek telt zeven dagen vanaf de eerste ziektedag die u invult. Bij week 6, 8, 52, 91, 93 en 104 tonen we de laatste dag van die week. Week 88 tonen we als de hele week, omdat UWV de brief in die week stuurt. De 42e-weeksmelding is de eerste werkdag na afloop van week 42.",
  },
  {
    q: "Telt een eerdere ziekmelding mee?",
    a: "Soms. UWV telt ziekteperiodes bij elkaar op als iemand binnen vier weken opnieuw ziek wordt, met uitzonderingen rond zwangerschap. Deze pagina telt niet zelf op. Gebruik de datum vanaf wanneer de periodes meetellen.",
  },
  {
    q: "Is de tijdlijn juridisch advies?",
    a: "Nee. Het is een geheugensteun. Een cao kan het loon in het eerste en tweede ziektejaar anders regelen dan het wettelijk minimum van 70 procent gedurende 104 weken.",
  },
  {
    q: "Hoe werken de herinneringen?",
    a: "Het agenda-bestand zet elk moment in uw agenda. Ligt de datum nog voor u, dan staat er een herinnering in, één of drie dagen van tevoren. Het formulier mailt de tijdlijn één keer. Een wekelijkse herinneringsmail sturen we niet.",
  },
  {
    q: "Wat als de WIA-aanvraag te laat is?",
    a: "UWV schrijft dat een te late aanvraag de uitkering later of tijdelijk lager kan laten ingaan. Ligt de vertraging aan de werkgever, dan betaalt de werkgever het loon langer door.",
  },
];
const howTo = {
  "@type": "HowTo",
  name: "Tijdlijn van de Wet verbetering poortwachter en de WIA",
  description: "Van de eerste ziektedag tot week 104, met de data die bij die dag horen. Geen juridisch advies.",
  step: timelineMilestones.map((item, index) => ({
    "@type": "HowToStep",
    position: index + 1,
    name: item.when,
    text: `${item.title}. ${item.tip}`,
  })),
};
---

<Base
  title="Verzuim-tijdlijn met exacte data"
  description="Vul de eerste ziektedag in. U ziet de data van de Wet verbetering poortwachter en de WIA, van week 6 tot week 104, met een tip per moment en een agenda-bestand."
  jsonLd={[crumbsLd(crumbs), faqLd(faq), howTo]}
>
  <Breadcrumbs crumbs={crumbs} />
  <article class="mx-auto max-w-3xl px-4 pt-6">
    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-ochre-800">{site.audience}</p>
    <h1 class="mt-3 font-serif text-4xl text-green-950 md:text-5xl">Verzuim-tijdlijn</h1>
    <Figure id="pagina-tijdlijn" eager class="mt-6" />
    <p class="mt-4 text-lg">Vul de eerste ziektedag in. U ziet de data van de Wet verbetering poortwachter en de WIA, van de probleemanalyse tot het einde van de loondoorbetaling. Elk moment heeft een korte tip. Het agenda-bestand zet de herinneringen in uw eigen agenda.</p>
    <p class="mt-4 text-sm text-ink-soft">{timelineCountingNote}</p>
    <p class="mt-4">Wie welke stap zet, zonder uw eigen datum, staat op de <a class="underline" href="/tools/tijdlijn-ziekteverzuim">tijdlijn ziekteverzuim</a>. Twijfelt u aan het dossier zelf, loop dan de <a class="underline" href="/loonsanctie-risicoscan">loonsanctie-risicoscan</a> na.</p>

    <form class="mt-8 space-y-3 rounded-[2rem] border border-line bg-white/80 p-5" data-timeline>
      <label class="block font-semibold text-green-950" for="eerste-ziektedag">Eerste ziektedag</label>
      <input class="ap-field" id="eerste-ziektedag" max="2035-12-31" min="1990-01-01" name="datum" required type="date" />
      <p class="text-sm text-ink-soft">De dag waarop de ziekmelding inging. Niet de dag dat HR het later in het systeem zette, als die data verschillen.</p>
      <Button data-cta="tijdlijn-bereken" type="submit">Toon de data</Button>
      <p class="text-sm" data-timeline-error role="status"></p>
    </form>

    <p class="mt-6 font-semibold text-green-950" data-timeline-position hidden></p>
    <ol class="ap-timeline mt-4">
      {timelineMilestones.map((item) => (
        <li class="ap-timeline-item rounded-3xl border border-line bg-white/80 p-5" data-milestone={item.id}>
          <p class="text-sm font-semibold uppercase tracking-wide text-ochre-800">{item.when}</p>
          <h2 class="font-serif text-2xl text-green-950">{item.title}</h2>
          <p class="text-sm text-ink-soft">{item.who}</p>
          <p class="mt-2 font-semibold" data-date>Datum verschijnt na de eerste ziektedag.</p>
          <p class="ap-status mt-2" data-status hidden></p>
          <p class="mt-2 text-sm text-ink-soft">{item.detail}</p>
          <p class="mt-2">{item.tip}</p>
        </li>
      ))}
    </ol>

    <div class="mt-8" data-timeline-actions hidden>
      <Button data-cta="tijdlijn-ics" data-ics="ja" type="button">Download de agenda (.ics)</Button>
      <p class="mt-2 text-sm text-ink-soft">Elk moment komt in uw agenda. Ligt de datum nog voor u, dan zit er een herinnering bij, één of drie dagen van tevoren. Verstreken data krijgen geen herinnering.</p>
      <form class="mt-8 space-y-3 rounded-[2rem] border border-line bg-white/80 p-5" data-cta="tijdlijn-mail" data-endpoint="/api/tijdlijn" data-kind="tijdlijn">
        <h2 class="font-serif text-3xl text-green-950">Mail mij de tijdlijn</h2>
        <p>Niet verplicht. We mailen deze data één keer naar u en naar ons. Herinneringen zet u met het agenda-bestand. Een wekelijkse herinneringsmail sturen we niet. Telefoon mag, het hoeft niet.</p>
        <label class="block">Naam<input class="ap-field" autocomplete="name" name="naam" required /></label>
        <label class="block">E-mail<input class="ap-field" autocomplete="email" name="email" required type="email" /></label>
        <label class="block">Telefoon, niet verplicht<input class="ap-field" autocomplete="tel" name="telefoon" type="tel" /></label>
        <input name="rapport" type="hidden" />
        <label class="flex items-start gap-2 text-sm">
          <input name="toestemming" required type="checkbox" value="ja" />
          <span>Mail mij deze tijdlijn. <a class="underline" href="/privacy">Privacy</a></span>
        </label>
        <div class="absolute -left-[9999px]" aria-hidden="true">
          <label>Website<input autocomplete="off" name="company_website" tabindex="-1" /></label>
        </div>
        <Button data-cta="tijdlijn-mail-knop" type="submit">Stuur de tijdlijn</Button>
        <p class="text-sm" data-status role="status"></p>
      </form>
    </div>

    <h2 class="mt-10 font-serif text-3xl text-green-950">Laat een casemanager meekijken</h2>
    <p class="mt-2">De data zijn een geheugensteun. Een casemanager bewaakt ze op uw dossiers.</p>
    <PlanOfOfferte gesprekCta="tijdlijn-gesprek" offerteCta="tijdlijn-offerte" phoneCta="tijdlijn-bel" whatsappCta="tijdlijn-whatsapp" />

    <h2 class="mt-10 font-serif text-3xl text-green-950">Bronnen</h2>
    <ul class="mt-3 list-disc space-y-2 pl-5">
      {timelineSources.map((source) => (
        <li><a class="underline" href={source.url} rel="noopener">{source.title}</a>. {source.note}</li>
      ))}
    </ul>
    <noscript><p class="mt-4">De exacte data hebben JavaScript nodig. De stappen en de tips staan wel op deze pagina.</p></noscript>
    <FaqList items={faq} />
  </article>
  <CtaBand title="De data door iemand laten bewaken" text="Een adviesgesprek duurt 30 minuten. U hoeft geen pakket af te nemen." />
</Base>

<script>
  import { buildTimeline, dateInRange, formatDutch, parseIsoDate, statusLabel } from "../lib/verzuim-tools";
  import { track } from "../scripts/track";
  import "../scripts/forms.ts";

  const form = document.querySelector<HTMLFormElement>("[data-timeline]");
  const input = form?.querySelector<HTMLInputElement>("input[name=datum]");
  const error = document.querySelector<HTMLElement>("[data-timeline-error]");
  const position = document.querySelector<HTMLElement>("[data-timeline-position]");
  const actions = document.querySelector<HTMLElement>("[data-timeline-actions]");
  const rapport = document.querySelector<HTMLInputElement>("[data-kind=tijdlijn] [name=rapport]");
  let current: ReturnType<typeof buildTimeline> | null = null;

  function show(value: string) {
    if (!error || !position || !actions) return;
    const date = parseIsoDate(value);
    const today = new Date();
    const todayDate = new Date(today.getFullYear(), today.getMonth(), today.getDate());
    if (!date) {
      error.textContent = "Vul een geldige eerste ziektedag in.";
      return;
    }
    const rangeError = dateInRange(date, todayDate);
    if (rangeError) {
      error.textContent = rangeError;
      return;
    }
    error.textContent = "";
    current = buildTimeline(date, todayDate, today);
    position.hidden = false;
    position.textContent = `Eerste ziektedag: ${formatDutch(date)}. ${current.position}`;
    for (const item of current.milestones) {
      const row = document.querySelector<HTMLElement>(`[data-milestone="${item.id}"]`);
      const dateNode = row?.querySelector<HTMLElement>("[data-date]");
      const statusNode = row?.querySelector<HTMLElement>("[data-status]");
      if (dateNode) dateNode.textContent = item.label;
      if (statusNode) {
        statusNode.hidden = false;
        statusNode.textContent = statusLabel[item.status];
        statusNode.classList.toggle("ap-status-past", item.status === "verstreken");
      }
    }
    if (rapport) rapport.value = current.report.slice(0, 8000);
    actions.hidden = false;
    track("calculator_result", { calculator: "verzuim-tijdlijn" });
  }

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (input?.value) show(input.value);
  });

  document.querySelector<HTMLButtonElement>("[data-ics]")?.addEventListener("click", () => {
    if (!current) return;
    const blob = new Blob([current.ics], { type: "text/calendar;charset=utf-8" });
    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");
    link.href = url;
    link.download = current.fileName;
    link.click();
    URL.revokeObjectURL(url);
    track("file_download", { calculator: "verzuim-tijdlijn", file_name: current.fileName });
  });

  const params = new URLSearchParams(window.location.search);
  const preset = params.get("datum");
  if (preset && input && parseIsoDate(preset)) {
    input.value = preset;
    show(preset);
  }
</script>
