---
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Figure from "../components/Figure.astro";
import CompareCalc from "../components/calculators/CompareCalc.astro";
import Guarantees from "../components/Guarantees.astro";
import InlineLead from "../components/InlineLead.astro";
import CtaBand from "../components/CtaBand.astro";
import FaqList from "../components/FaqList.astro";
import HireBenefits from "../components/HireBenefits.astro";
import ReviewCard from "../components/ReviewCard.astro";
import { compareLeadTitle, priceFinePrint, pricePromise, qualityFaq } from "../data/garanties";
import { officeConversation } from "../data/site";
import { reviewsAboutNiels } from "../data/reviews";
import { defaultScenario, scenarioNote } from "../lib/compare-view";
import { euro } from "../lib/format";
import { crumbsLd, faqLd } from "../lib/schema";

const crumbs = [
  { name: "Home", path: "/" },
  { name: "Casemanager inhuren of in dienst nemen?", path: "/casemanager-inhuren-of-in-dienst" },
];
const scenario = defaultScenario();
const faq = [
  {
    q: "Is een casemanager inhuren goedkoper dan iemand in dienst nemen?",
    a: `${pricePromise} ${priceFinePrint}`,
  },
  {
    q: "Welke kosten zitten er in het dienstverband?",
    a: "Bruto loon, vakantiegeld, eindejaarsuitkering als u die invult, werkgeverspremies, pensioen als u dat invult, verzuim en vervanging, verlof en feestdagen, werving, inwerktijd als u die invult, opleiding, registratie, laptop, lease en reiskosten als u die invult, en de jaarlijkse opbouw van de transitievergoeding. Leegloop bij een lage caseload zit in het volle contract. Een jaar volledige uitval tonen we ernaast, omdat het CBS-gemiddelde lange gevallen al bevat.",
  },
  {
    q: "Waar komt het standaard maandloon vandaan?",
    a: "Uit het mediaan bruto uurloon van CBS StatLine 86355NED, beroepsgroep specialisten personeels- en loopbaanontwikkeling, 2025 voorlopig. Het maandloon is uurloon maal contracturen maal 52 gedeeld door 12. Dat is een afleiding, geen CBS-maandloon. De groep is breder dan alleen casemanagers verzuim. U kunt het loon vervangen door het bedrag dat u zelf zou bieden.",
  },
  {
    q: "Wat als we wel een volle caseload hebben?",
    a: "Dan blijft de tool rekenen. Ligt het dienstverband lager, dan zegt de uitkomst dat ook. Het voordeel is dan kwalitatief: een vaste casemanager met vervanging bij ziekte of vakantie, onafhankelijkheid, wisselen zonder ontslag, geen werkgeversrisico, uren die u meeschaalt, en een gesprek op het kantoor in Uden. Wie daarheen komt, blijft in beweging. Dat kan verzuim minder en korter maken. We noemen geen percentage. Wie echt niet kan reizen, spreken we op het bedrijf of online. De wijzigingstermijn staat in de offerte.",
  },
  qualityFaq,
  {
    q: "Blijft de vergelijking eerlijk als inhuren duurder uitvalt?",
    a: priceFinePrint,
  },
];
const jsonLd = [crumbsLd(crumbs), faqLd(faq)];
---

<Base
  title="Casemanager inhuren of in dienst nemen?"
  description="Vergelijk de jaarkosten van een casemanager in dienst met inhuren. Bronnen van CBS, cao en werkgeverslasten, aannames die u aanpast, en een eerlijke uitkomst bij een hoge caseload."
  jsonLd={jsonLd}
>
  <Breadcrumbs crumbs={crumbs} />
  <header class="mx-auto max-w-6xl px-4 pt-6">
    <h1 class="max-w-4xl font-serif text-5xl text-green-950">Casemanager inhuren of in dienst nemen?</h1>
    <Figure id="pagina-inhuren" eager class="mt-6 max-w-3xl" />
    <p class="mt-4 max-w-3xl text-lg">Een casemanager inhuren betekent dat u de uren afneemt die de dossiers vragen. Een casemanager in dienst is een volledig contract: salaris, premies en werkplek lopen door, ook in een maand met weinig nieuwe gevallen. Een eigen casemanager spreekt meestal op de werkvloer, tussen collega's. Bij ons komen werknemer en werkgever naar Losplaats 16d in Uden. {officeConversation.place} {officeConversation.threshold} {officeConversation.employer} {officeConversation.care} {pricePromise} De vergelijking hieronder is die onderbouwing. Elke aanname heeft een bron en is aan te passen. De uitkomst is een berekening, geen offerte. {priceFinePrint}</p>
    {scenario.headline.positive && (
      <p class="mt-4 max-w-3xl text-lg font-semibold text-green-950">{scenario.headline.text}. {scenarioNote()}</p>
    )}
  </header>
  <Guarantees plaats="vergelijking" />
  <HireBenefits />
  <div class="mx-auto max-w-6xl px-4 pb-4">
    <h2 class="font-serif text-4xl text-green-950">De vergelijking</h2>
    <p class="mt-3 max-w-3xl">Drie stappen, met schuiven: het aantal medewerkers en het verzuimpercentage, het niveau, en het contract in dienst. De verwachte casemanageruren per jaar volgen uit de eerste stap. De staafgrafiek zet een dienstverband naast Arbopartner. In het standaardscenario, 100 medewerkers en 5,4% verzuim, is het verschil {euro(scenario.result.saving, true)} per jaar. Komt een dienstverband lager uit, dan zegt de tool dat.</p>
  </div>
  <div class="mx-auto max-w-6xl px-4 pb-8">
    <CompareCalc />
    <InlineLead
      id="kostenvergelijking"
      source="kostenvergelijking"
      title={compareLeadTitle}
      submit={compareLeadTitle}
      text="Twee stappen: eerst uw nummer, daarna naam en organisatie. We rekenen de vergelijking met uw uren en uw loon. Dit formulier is nog geen offerte."
    />
  </div>
  <section class="mx-auto max-w-6xl px-4 py-6">
    <h2 class="font-serif text-4xl text-green-950">Wat opdrachtgevers over Niels schreven</h2>
    <p class="mt-2 max-w-3xl text-sm">Letterlijke citaten van matchvermogen.nl waarin zijn handelen wordt beschreven. Ze gaan over Matchvermogen, niet over een offerte van dit label.</p>
    <div class="mt-5 grid gap-4 md:grid-cols-2">
      {reviewsAboutNiels().slice(0, 2).map((review) => <ReviewCard review={review} />)}
    </div>
    <p class="mt-3"><a class="font-semibold underline" href="/reviews">Alle citaten, met bron en datum</a></p>
  </section>
  <div class="mx-auto max-w-6xl px-4">
    <FaqList items={faq} title="Vragen over inhuren of in dienst" />
  </div>
  <CtaBand title="Uw uren omzetten in een offerte" text="De vergelijking onderbouwt de garantie en blijft eerlijk. De offerte bevestigt het tarief en de wijzigingstermijn. Het gesprek van 30 minuten verplicht u tot niets." />
</Base>
