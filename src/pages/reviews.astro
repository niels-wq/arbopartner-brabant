---
import Figure from "../components/Figure.astro";
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import CtaBand from "../components/CtaBand.astro";
import ReviewCard from "../components/ReviewCard.astro";
import { reviews, reviewNotice, reviewsAboutNiels } from "../data/reviews";
import { crumbsLd } from "../lib/schema";

const crumbs = [
  { name: "Home", path: "/" },
  { name: "Reviews", path: "/reviews" },
];

const reviewLd = reviews.map((review) => ({
  "@type": "Review",
  reviewBody: review.quote,
  datePublished: review.dateIso,
  author: { "@type": "Person", name: review.author },
  reviewRating: { "@type": "Rating", ratingValue: review.rating, bestRating: 5 },
  itemReviewed: {
    "@type": "Organization",
    name: "Matchvermogen",
    url: "https://matchvermogen.nl",
  },
  url: review.sourceUrl,
}));
---

<Base title="Reviews van Matchvermogen" description="Letterlijke reviews van het zustermerk Matchvermogen, met bron en datum. Arbopartner Brabant heeft nog geen eigen reviews." jsonLd={[crumbsLd(crumbs), ...reviewLd]}>
  <Breadcrumbs crumbs={crumbs} />
  <header class="mx-auto max-w-6xl px-4 pt-6">
    <h1 class="font-serif text-5xl text-green-950">Wat opdrachtgevers schreven</h1>
    <Figure id="pagina-reviews" eager class="mt-6" />
    <p class="mt-4 max-w-3xl">{reviewNotice}</p>
    <p class="mt-3 max-w-3xl">De paginabron van matchvermogen.nl zet bij deze 25 citaten een totaalscore van 5 uit 5. In diezelfde bron heeft één citaat een 4. Op arbeidsdeskundig.com staat 4,9 uit 5 op basis van 21 of meer Google-reviews, zonder exact aantal. Een Trustoo-profiel van Matchvermogen is niet gevonden. Daarom staat hier geen samengestelde score in de schema-code.</p>
    <p class="mt-3"><a class="font-semibold underline" href="https://matchvermogen.nl/referenties/">Alle referenties op matchvermogen.nl</a></p>
  </header>
  <section class="mx-auto max-w-6xl px-4 pt-8">
    <h2 class="font-serif text-3xl text-green-950">Citaten waarin Niels wordt genoemd</h2>
    <div class="mt-4 grid gap-4 md:grid-cols-2">
      {reviewsAboutNiels().map((review) => <ReviewCard review={review} />)}
    </div>
  </section>
  <section class="mx-auto max-w-6xl px-4 py-8">
    <h2 class="font-serif text-3xl text-green-950">Overige citaten</h2>
    <div class="mt-4 grid gap-4 md:grid-cols-2">
      {reviews.filter((review) => !review.mentionsNiels).map((review) => <ReviewCard review={review} />)}
    </div>
  </section>
  <CtaBand proof={false} title="Uw dossiers naast deze ervaring" text="De citaten gaan over Matchvermogen, niet over Arbopartner Brabant. In het gesprek kijken we of die werkwijze bij u past." />
</Base>
