---
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ReviewCard from "../components/ReviewCard.astro";
import { reviews, reviewNotice } from "../data/reviews";
import { crumbsLd } from "../lib/schema";

const crumbs = [
  { name: "Home", path: "/" },
  { name: "Reviews", path: "/reviews" },
];

const reviewLd = reviews.map((review) => ({
  "@type": "Review",
  reviewBody: review.quote,
  datePublished: review.dateIso,
  author: { "@type": "Person", name: review.name },
  itemReviewed: {
    "@type": "Organization",
    name: "Matchvermogen",
    url: "https://matchvermogen.nl",
  },
  url: review.sourceUrl,
}));
---

<Base title="Reviews van Matchvermogen" description="Letterlijke reviews van het zustermerk Matchvermogen, met bron en datum. Arbopartner Brabant heeft nog geen eigen reviews." jsonLd={[crumbsLd(crumbs), ...reviewLd]}>
  <Breadcrumbs crumbs={crumbs} />
  <header class="mx-auto max-w-6xl px-4 pt-6">
    <h1 class="font-serif text-5xl text-green-950">Reviews</h1>
    <p class="mt-4 max-w-3xl">{reviewNotice} Matchvermogen schrijft op de eigen site dat opdrachtgevers het bureau 5/5 sterren op Google geven. Dat getal nemen we niet over als score van Arbopartner Brabant, en het staat niet in een samengestelde beoordeling op deze site.</p>
    <p class="mt-3"><a class="font-semibold underline" href="https://matchvermogen.nl/referenties/">Alle referenties op matchvermogen.nl</a></p>
  </header>
  <div class="mx-auto grid max-w-6xl gap-4 px-4 py-8 md:grid-cols-2">
    {reviews.map((review) => <ReviewCard review={review} />)}
  </div>
</Base>
