---
import Figure from "../components/Figure.astro";
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { site } from "../data/site";
import { places } from "../data/places";
import { crumbsLd } from "../lib/schema";

const crumbs = [
  { name: "Home", path: "/" },
  { name: "Offerte", path: "/offerte" },
];
const pakketKeuze = Astro.url.searchParams.get("pakket") ?? "";
---

<Base title="Offerte in 2 minuten" description="Offerte in drie korte stappen: wie we bellen, de situatie, en het pakket. Richtprijs, geen contract." jsonLd={[crumbsLd(crumbs)]}>
  <Breadcrumbs crumbs={crumbs} />
  <article class="mx-auto max-w-3xl px-4 pt-6">
    <h1 class="font-serif text-5xl text-green-950">Offerte in 2 minuten</h1>
    <Figure id="pagina-offerte" eager class="mt-6" />
    <p class="mt-4">Drie korte stappen, zonder bijlage. Eerst wie we bellen, daarna de situatie, daarna het blok. {site.placeholders.offerteDagen}</p>
    <form class="mt-6 space-y-4" data-endpoint="/api/offerte" data-kind="offerte" data-cta="offerte" data-wizard>
      <p aria-live="polite">Stap <span data-step-label>1</span> van 3</p>
      <fieldset data-step="1" class="space-y-3 rounded-[2rem] border border-line bg-white/80 p-5">
        <legend class="font-serif text-2xl">1. Wie mogen we bellen?</legend>
        <label class="block">Naam<input class="ap-field" name="naam" required autocomplete="name" /></label>
        <label class="block">Telefoon<input class="ap-field" name="telefoon" type="tel" required autocomplete="tel" /></label>
        <label class="block">Organisatie<input class="ap-field" name="organisatie" required autocomplete="organization" /></label>
      </fieldset>
      <fieldset data-step="2" class="space-y-3 rounded-[2rem] border border-line bg-white/80 p-5">
        <legend class="font-serif text-2xl">2. De situatie</legend>
        <label class="block">E-mail<input class="ap-field" name="email" type="email" required autocomplete="email" /></label>
        <label class="block">Plaats
          <select class="ap-field" name="plaats" required>
            {places.map((place) => <option value={place.name}>{place.name}</option>)}
            <option value="Elders in Noord-Brabant">Elders in Noord-Brabant</option>
          </select>
        </label>
        <label class="block">Aantal medewerkers<input class="ap-field" name="medewerkers" type="number" min="35" max="500" required />
          <span class="mt-1 block text-sm font-normal">Voor organisaties met 35–500 medewerkers.</span>
        </label>
        <label class="block">Wat speelt er?
          <select class="ap-field" name="situatie" required>
            <option value="Nu een probleem">Nu een probleem</option>
            <option value="Structureel regelen">Structureel regelen</option>
            <option value="Allebei">Allebei</option>
          </select>
        </label>
      </fieldset>
      <fieldset data-step="3" class="space-y-3 rounded-[2rem] border border-line bg-white/80 p-5">
        <legend class="font-serif text-2xl">3. Pakket</legend>
        <label class="block">Pakket
          <select class="ap-field" name="pakket" required>
            <option value="Basis, 10 uur" selected={pakketKeuze === "Basis, 10 uur"}>Basis, 10 uur</option>
            <option value="Premium, 20 uur" selected={pakketKeuze === "Premium, 20 uur"}>Premium, 20 uur</option>
            <option value="Pro, 24+ uur" selected={pakketKeuze === "Pro, 24+ uur"}>Pro, 24 uur of meer</option>
            <option value="Nog niet zeker" selected={pakketKeuze === "Nog niet zeker"}>Nog niet zeker</option>
          </select>
        </label>
        <label class="block">Niveau
          <select class="ap-field" name="niveau" required>
            <option value="Medior">Medior</option>
            <option value="Medior+">Medior+</option>
            <option value="Senior">Senior met specialisatie</option>
            <option value="Nog niet zeker">Nog niet zeker</option>
          </select>
        </label>
        <label class="block">Sector, als u wilt<input class="ap-field" name="sector" /></label>
        <label class="block">Verzuimpercentage, als u het weet<input class="ap-field" name="verzuim" /></label>
        <label class="block">Aantal dossiers langer dan 6 weken<input class="ap-field" name="dossiers" /></label>
        <label class="block">Toelichting<textarea class="ap-field min-h-24" name="toelichting"></textarea></label>
        <label class="block">Gewenste start<input class="ap-field" name="start" type="text" placeholder="bijvoorbeeld 1 november" /></label>
        <label class="flex items-start gap-2 text-sm">
          <input name="toestemming" type="checkbox" value="ja" required />
          <span>Matchvermogen B.V. mag deze gegevens gebruiken om een offerte te maken. Zie de <a class="underline" href="/privacy">privacyverklaring</a>.</span>
        </label>
        <div class="absolute -left-[9999px]" aria-hidden="true">
          <label>Website<input name="company_website" tabindex="-1" autocomplete="off" /></label>
        </div>
        <button class="rounded-full bg-ochre-500 px-5 py-3 font-semibold" type="submit">Verstuur de aanvraag</button>
        <p class="text-sm">De aanvraag is nog geen contract. U zit nergens aan vast.</p>
        <p data-status class="text-sm" role="status"></p>
        <p class="text-sm text-ink-soft">Lukt het formulier niet, mail dan {site.parent.email}. {site.placeholders.eigenEmail}</p>
      </fieldset>
      <div class="flex gap-3" data-nav>
        <button type="button" data-prev class="rounded-full border border-green-800 px-4 py-2 font-semibold">Vorige</button>
        <button type="button" data-next class="rounded-full bg-ochre-500 px-4 py-2 font-semibold">Volgende stap</button>
      </div>
    </form>
  </article>
</Base>

<script>
  import "../scripts/forms.ts";
  import "../scripts/wizard.ts";

  const chosen = new URLSearchParams(location.search).get("pakket");
  const select = document.querySelector<HTMLSelectElement>("[name=pakket]");
  if (chosen && select && Array.from(select.options).some((option) => option.value === chosen)) {
    select.value = chosen;
  }
</script>
