---
import Figure from "../components/Figure.astro";
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { crumbsLd } from "../lib/schema";

const crumbs = [
  { name: "Home", path: "/" },
  { name: "Niet gevonden", path: "/404" },
];
---

<Base title="Pagina niet gevonden" description="Deze pagina bestaat niet op Arbopartner Brabant." jsonLd={[crumbsLd(crumbs)]}>
  <Breadcrumbs crumbs={crumbs} />
  <section class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="font-serif text-5xl text-green-950">Deze pagina is er niet</h1>
    <Figure id="pagina-niet-gevonden" eager class="mt-6" />
    <p class="mt-4">Het adres klopt niet, of de pagina is verplaatst.</p>
    <p class="mt-6"><a class="rounded-full bg-ochre-500 px-5 py-3 font-semibold" href="/">Naar de homepage</a></p>
    <p class="mt-3 text-sm">Of ga naar de <a class="underline" href="/diensten">diensten</a> of <a class="underline" href="/spoedhulp">spoedhulp</a>.</p>
  </section>
</Base>
