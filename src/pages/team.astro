---
import Figure from "../components/Figure.astro";
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import FaqList from "../components/FaqList.astro";
import ReviewCard from "../components/ReviewCard.astro";
import TeamPhoto from "../components/TeamPhoto.astro";
import { bestMatchTeam, groupTitle, matchvermogenTeam, teamSource } from "../data/team";
import { zzpFaq } from "../data/site";
import { reviewsAboutNiels } from "../data/reviews";
import { crumbsLd, faqLd, teamPeopleLd } from "../lib/schema";

const crumbs = [
  { name: "Home", path: "/" },
  { name: "Team", path: "/team" },
];
const faq = [
  zzpFaq,
  {
    q: "Waarom heeft niet iedereen een bio?",
    a: "Matchvermogen publiceert op de teampagina naam, functie en foto. Een langere tekst staat daar alleen bij Niels Alderding, in het stuk over de oprichting. Die tekst nemen we over. Voor de anderen verzinnen we geen bio.",
  },
];
const groups = [
  { title: groupTitle("matchvermogen"), people: matchvermogenTeam },
  { title: groupTitle("best-match"), people: bestMatchTeam },
];
const nielsReviews = reviewsAboutNiels().slice(0, 2);
---

<Base
  title="Team"
  description="Het team van Matchvermogen en Best Match Re-integratie, met de namen, functies en foto’s van matchvermogen.nl. Arbopartner werkt met een vaste kern en gecertificeerde zzp-casemanagers."
  jsonLd={[crumbsLd(crumbs), faqLd(faq), ...teamPeopleLd()]}
>
  <Breadcrumbs crumbs={crumbs} />
  <article class="mx-auto max-w-6xl px-4 pt-6">
    <h1 class="font-serif text-5xl text-green-950">Het team</h1>
    <Figure id="pagina-team" eager class="mt-6 max-w-3xl" />
    <p class="mt-4 max-w-3xl text-lg">Dit zijn de mensen die Matchvermogen op de <a class="underline" href={teamSource}>teampagina</a> publiceert, in dezelfde volgorde, met dezelfde functie. De foto’s komen van die pagina. Een gezicht dat daar niet staat, zetten we hier niet bij.</p>
    <p class="mt-4 max-w-3xl">{zzpFaq.a}</p>
    {groups.map((group) => (
      <section class="mt-10">
        <h2 class="font-serif text-3xl text-green-950">{group.title}</h2>
        <ul class="mt-5 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
          {group.people.map((person) => (
            <li class="rounded-2xl border border-line bg-white p-5 text-center">
              <TeamPhoto member={person} sizes="5rem" class="mx-auto h-20 w-20 rounded-full object-cover object-top" />
              <h3 class="mt-3 text-base font-semibold text-green-950">{person.name}</h3>
              <p class="text-sm text-ink-soft">{person.role}</p>
              {person.bio && <p class="mt-3 text-left text-sm">{person.bio}</p>}
            </li>
          ))}
        </ul>
      </section>
    ))}
    <p class="mt-6 max-w-3xl text-sm text-ink-soft">Best Match Re-integratie staat op dezelfde teampagina, onder een eigen kop. De functie bij elke naam is de functie die Matchvermogen daar publiceert.</p>
    <h2 class="mt-10 font-serif text-3xl text-green-950">Wat opdrachtgevers over Niels schreven</h2>
    <p class="mt-2 max-w-3xl text-sm">Letterlijke citaten van matchvermogen.nl waarin Niels wordt genoemd. Ze gaan over Matchvermogen, niet over dit label.</p>
    <div class="mt-4 grid gap-4 md:grid-cols-2">
      {nielsReviews.map((review) => <ReviewCard review={review} />)}
    </div>
    <p class="mt-3"><a class="font-semibold underline" href="/reviews">Alle citaten</a></p>
    <FaqList items={faq} />
  </article>
</Base>
