---
import Button from "./Button.astro";
import Mark from "./Mark.astro";
import { reviews } from "../data/reviews";
import { site } from "../data/site";

interface Props {
  title?: string;
  text?: string;
  href?: string;
  label?: string;
  risk?: string;
  proof?: boolean;
  cta?: string;
  wrapClass?: string;
}
const {
  title = "Bespreek uw dossiers met een mens",
  text = "Een adviesgesprek duurt 30 minuten. U krijgt geen verkooppraatje, wel een oordeel of detachering past.",
  href = "/adviesgesprek",
  label = "Plan een adviesgesprek",
  risk = `${site.responsePromise} Het gesprek van 30 minuten verplicht u tot niets.`,
  proof = true,
  cta = href === "/offerte" ? "band-offerte" : "band-advies",
  wrapClass = "mt-6",
} = Astro.props;
const quote = reviews.find((review) => review.author.startsWith("Melisia Telepary"));
---

<section class="mx-auto mt-14 max-w-6xl px-4">
  <div class="rounded-[2rem] bg-green-900 px-6 py-8 text-sand-50 md:px-10">
    <h2 class="font-serif text-3xl"><Mark name="chairs" class="text-ochre-200" />{title}</h2>
    <p class="mt-2 max-w-xl text-sand-100">{text}</p>
    {proof && quote && (
      <blockquote class="mt-4 max-w-xl border-l-2 border-ochre-500 pl-4">
        <p>„{quote.quote}”</p>
        <footer class="mt-2 text-sm">
          {quote.name}{quote.organisation ? `, ${quote.organisation}` : ""}. Review van Matchvermogen, {quote.date}.
          <a href="/reviews">Bron en datum</a>
        </footer>
      </blockquote>
    )}
    <div class={wrapClass}>
      <Button data-cta={cta} href={href}>{label}</Button>
      <p class="mt-3 max-w-xl text-sm">{risk}</p>
    </div>
  </div>
</section>
