---
import { visualAlt } from "../data/visuals";

interface Props {
  id: string;
  eager?: boolean;
  sizes?: string;
  class?: string;
}
const { id, eager = false, sizes = "(min-width: 768px) 42rem, 100vw", class: className } = Astro.props;
const alt = visualAlt(id);
const base = `/beeld/${id}`;
---

<figure class:list={["ap-figure", className]}>
  <picture>
    <source type="image/avif" srcset={`${base}-640.avif 640w, ${base}-1200.avif 1200w`} sizes={sizes} />
    <source type="image/webp" srcset={`${base}-640.webp 640w, ${base}-1200.webp 1200w`} sizes={sizes} />
    <img
      src={`${base}-640.webp`}
      alt={alt}
      width="1200"
      height="630"
      loading={eager ? "eager" : "lazy"}
      decoding="async"
      fetchpriority={eager ? "high" : "auto"}
    />
  </picture>
</figure>
