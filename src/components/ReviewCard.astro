---
import type { Review } from "../data/reviews";
import { reviewNotice } from "../data/reviews";
interface Props { review: Review }
const { review } = Astro.props;
---

<figure class="flex h-full flex-col rounded-3xl border border-line bg-white/80 p-5">
  <blockquote class="text-green-950">“{review.quote}”</blockquote>
  <figcaption class="mt-4 text-sm">
    <span class="font-semibold">{review.name}</span>
    <span class="text-ink-soft"> — {review.organisation}</span>
    <span class="mt-1 block text-ink-soft">{review.date}</span>
  </figcaption>
  <p class="mt-3 text-xs text-ochre-800">{reviewNotice}</p>
  <a class="mt-2 text-sm font-semibold text-green-800 underline decoration-ochre-500 underline-offset-2" href={review.sourceUrl}>Bron: {review.sourceLabel}</a>
</figure>
