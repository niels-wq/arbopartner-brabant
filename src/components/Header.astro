---
import Button from "./Button.astro";
import { site, phoneHref, whatsappHref } from "../data/site";
import { serviceGroups, serviceLayout } from "../data/service-layout";
import { services } from "../data/services";

const links = [
  { href: "/diensten", label: "Diensten" },
  { href: "/pakketten", label: "Pakketten" },
  { href: "/tarieven", label: "Tarieven" },
  { href: "/werkgebied", label: "Werkgebied" },
  { href: "/over-ons", label: "Over ons" },
];
const more = [
  { href: "/arbodienst-of-arbopartner", label: "Anders dan een arbodienst" },
  { href: "/situaties", label: "Situaties" },
  { href: "/tools", label: "Tools" },
  { href: "/loonsanctie-risicoscan", label: "Loonsanctie-risicoscan" },
  { href: "/verzuim-tijdlijn", label: "Verzuim-tijdlijn" },
  { href: "/blog", label: "Kennis" },
  { href: "/team", label: "Team" },
  { href: "/werken-bij", label: "Werken bij" },
  { href: "/contact", label: "Contact" },
];
---

<div class="sticky top-0 z-40 bg-green-950 text-sand-50">
  <div class="border-b border-white/15">
    <div class="mx-auto flex max-w-6xl flex-col gap-1 px-4 py-2 text-sm sm:flex-row sm:items-center sm:justify-between">
      <p class="m-0">
        <a class="font-semibold underline decoration-ochre-500 underline-offset-2" data-cta="top-spoed" href="/spoedhulp">Zieke medewerker? Bel of app vandaag nog.</a>
        <span class="hidden sm:inline"> {site.responsePromise}</span>
      </p>
      <p class="m-0 flex gap-4 font-semibold">
        <a data-cta="top-bel" data-channel="phone" href={phoneHref}>{site.parent.phoneDisplay}</a>
        <a data-cta="top-whatsapp" data-channel="whatsapp" href={whatsappHref} rel="noopener">App {site.parent.whatsappDisplay}</a>
      </p>
    </div>
  </div>
  <header>
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
      <a href="/" class="no-underline" data-cta="logo-home">
        <img class="site-logo" src="/logo-light.png?v=20261016b" width="223" height="64" alt="Arbopartner Brabant, een label van Matchvermogen" />
      </a>
      <nav class="hidden items-center gap-5 text-sm font-semibold lg:flex" aria-label="Hoofdmenu">
        {links.map((link) => (
          link.href === "/diensten" ? (
            <details class="relative">
              <summary class="cursor-pointer list-none">Diensten</summary>
              <div class="absolute left-0 z-50 mt-3 max-h-[70vh] w-72 overflow-y-auto rounded-2xl border border-line bg-sand-50 p-3 text-green-950">
                <a class="block py-2 font-semibold" href="/diensten">Alle diensten</a>
                {serviceGroups.map((group) => (
                  <div class="mt-2 border-t border-line pt-2">
                    <a class="block py-1 text-xs font-semibold uppercase tracking-wide text-ochre-800" href={`/diensten#${group.id}`}>{group.title}</a>
                    {services.filter((service) => serviceLayout[service.slug]?.group === group.id).map((service) => (
                      <a class="block py-1 text-sm" href={`/diensten/${service.slug}`}>{service.menu}</a>
                    ))}
                  </div>
                ))}
              </div>
            </details>
          ) : (
            <a href={link.href}>{link.label}</a>
          )
        ))}
        <details class="relative">
          <summary class="cursor-pointer list-none">Meer</summary>
          <div class="absolute right-0 z-50 mt-3 w-52 rounded-2xl border border-line bg-sand-50 p-3 text-green-950">
            {more.map((link) => (
              <a class="block py-2 font-semibold" href={link.href}>{link.label}</a>
            ))}
          </div>
        </details>
        <Button data-cta="nav-advies" href="/adviesgesprek">Adviesgesprek</Button>
      </nav>
      <details class="relative lg:hidden">
        <summary class="cursor-pointer list-none rounded-full border border-sand-100 px-3 py-2 text-sm font-semibold text-sand-50">Menu</summary>
        <div class="absolute right-0 z-50 mt-2 w-64 rounded-2xl border border-line bg-sand-50 p-4 text-green-950">
          {links.map((link) => (
            <a class="block py-2 font-semibold" href={link.href}>{link.label}</a>
          ))}
          {more.map((link) => (
            <a class="block py-2 font-semibold" href={link.href}>{link.label}</a>
          ))}
          <Button class="block" data-cta="menu-advies" href="/adviesgesprek">Adviesgesprek</Button>
          <a class="mt-2 block py-2 font-semibold" data-cta="menu-spoed" href="/spoedhulp">Spoedhulp</a>
          <p class="mt-3 text-xs font-semibold uppercase tracking-wide text-ochre-800">Diensten</p>
          <a class="block py-1 text-sm font-semibold" href="/diensten">Alle diensten</a>
          {serviceGroups.map((group) => (
            <>
              <a class="mt-2 block py-1 text-xs font-semibold uppercase tracking-wide text-ochre-800" href={`/diensten#${group.id}`}>{group.title}</a>
              {services.filter((service) => serviceLayout[service.slug]?.group === group.id).map((service) => (
                <a class="block py-1 text-sm" href={`/diensten/${service.slug}`}>{service.menu}</a>
              ))}
            </>
          ))}
        </div>
      </details>
    </div>
  </header>
</div>
