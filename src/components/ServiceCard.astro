---
import Button from "./Button.astro";
import Mark from "./Mark.astro";
import { serviceLayout } from "../data/service-layout";
import { serviceIcons, type Service } from "../data/services";
import { site } from "../data/site";

interface Props {
  service: Service;
}

const { service } = Astro.props;
const layout = serviceLayout[service.slug];
const discount =
  service.slug === "tweede-spoor"
    ? `Spoor 2 −${site.discount.tweedeSpoor}%`
    : service.slug === "arbeidsdeskundig-onderzoek"
      ? `AD −${site.discount.arbeidsdeskundige}%`
      : "";
const project = layout.priceKind === "project" && layout.group !== "interim";
const interim = layout.group === "interim";
---

<article class="flex h-full flex-col rounded-2xl border border-line bg-white p-5">
  <div class="flex items-start justify-between gap-3">
    <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-ochre-200 text-green-950">
      <Mark name={serviceIcons[service.slug]} class="ap-card-mark" />
    </span>
    {discount && <span class="rounded-full bg-ochre-200 px-3 py-1 text-sm font-semibold text-green-950">{discount}</span>}
    {project && <span class="rounded-full bg-sand-200 px-3 py-1 text-sm font-semibold text-green-950">Project</span>}
    {interim && <span class="rounded-full bg-sand-200 px-3 py-1 text-sm font-semibold text-green-950">Interim</span>}
  </div>
  <h3 class="mt-3 font-serif text-2xl text-green-950">{service.title}</h3>
  <p class="mt-2 flex-1 text-ink-soft">{layout.result}</p>
  <div class="mt-4 flex flex-wrap gap-2">
    <Button data-cta={`dienst-bekijk-${service.slug}`} href={`/diensten/${service.slug}`}>Bekijk</Button>
    <Button variant="ghost" data-cta={`dienst-offerte-${service.slug}`} href={`/offerte?dienst=${service.slug}`}>Offerte binnen 24 uur</Button>
  </div>
</article>
