---
import CalendlyButton from "./CalendlyButton.astro";
import { calendlyKennismaking } from "../data/calendly";
import { site, phoneHref, mailHref, whatsappHref } from "../data/site";
---

<div
  id="ap-engage"
  data-phone={site.parent.phoneDisplay}
  data-tel={site.parent.phoneTel}
></div>

<aside class="ap-sticky" aria-label="Snel contact">
  <a class="btn" data-cta="sticky-advies" href="/adviesgesprek">Adviesgesprek</a>
  <a class="btn btn-ghost" data-cta="sticky-bel" data-channel="phone" href={phoneHref}>Bel {site.parent.phoneDisplay}</a>
</aside>

<a class="ap-calc" data-cta="calculator-fab" href="/casemanager-inhuren-of-in-dienst#vergelijking" aria-label="Bereken uw besparing">
  <svg width="26" height="26" viewBox="0 0 26 26" aria-hidden="true" focusable="false">
    <rect x="4" y="2.5" width="18" height="21" rx="3" fill="none" stroke="currentColor" stroke-width="2"/>
    <path d="M8 8.5h10M8 14h3.2M14.8 14H18M8 18.2h3.2M14.8 18.2H18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
  </svg>
  <span class="ap-tip">Bereken uw besparing</span>
</a>

<div class="ap-dock">
  <button id="ap-chat-open" class="ap-icon" type="button" aria-expanded="false" aria-controls="ap-chat" aria-label="Chat openen">
    <img class="niels-face" src={site.founder.avatar} width="240" height="240" alt="" />
  </button>
  <details class="ap-contact">
    <summary>Contact</summary>
    <div class="ap-contact-menu">
      <a data-cta="fab-bel" data-channel="phone" href={phoneHref}>Bel {site.parent.phoneDisplay}</a>
      <a data-cta="fab-whatsapp" data-channel="whatsapp" href={whatsappHref} rel="noopener">WhatsApp {site.parent.whatsappDisplay}</a>
      <a data-cta="fab-mail" data-channel="email" href={mailHref}>Mail {site.parent.email}</a>
      <CalendlyButton class="" cta="fab-calendly" />
    </div>
  </details>
</div>

<section id="ap-chat" class="ap-chat" hidden role="dialog" aria-modal="false" aria-labelledby="ap-chat-title">
  <div class="ap-chat-head">
    <div>
      <p id="ap-chat-title" class="font-semibold">Arbopartner Brabant</p>
      <p class="text-sm">Korte antwoorden van {site.founder.name}</p>
    </div>
    <button type="button" data-close aria-label="Chat sluiten">×</button>
  </div>
  <div class="ap-log" data-log aria-live="polite"></div>
  <div class="ap-chips" data-chips>
    <button type="button">Wat kost een casemanager?</button>
    <button type="button">Zijn jullie een arbodienst?</button>
    <button type="button">Waar werken jullie?</button>
    <button type="button" data-calendly={calendlyKennismaking.id} data-calendly-url={calendlyKennismaking.url} data-cta="chat-calendly">{calendlyKennismaking.label}</button>
    <button type="button" data-lead="1">Ik wil teruggebeld worden</button>
  </div>
  <form class="ap-chat-form" data-ask>
    <label class="sr-only" for="ap-chat-q">Uw vraag</label>
    <input id="ap-chat-q" name="q" maxlength="240" placeholder="Typ uw vraag" />
    <button type="submit">Stuur</button>
  </form>
  <form class="ap-lead" data-lead hidden>
    <label>Naam<input name="naam" required autocomplete="name" /></label>
    <label>Bedrijf<input name="organisatie" required autocomplete="organization" /></label>
    <label>Telefoon<input name="telefoon" type="tel" required autocomplete="tel" /></label>
    <label>Aantal medewerkers<input name="medewerkers" type="number" min="35" max="500" required inputmode="numeric" /></label>
    <label>Vraag<textarea name="vraag" required maxlength="1000"></textarea></label>
    <label class="flex items-start gap-2 text-sm"><input type="checkbox" name="toestemming" value="ja" required /> <span>U mag contact opnemen. <a href="/privacy">Privacy</a></span></label>
    <div class="absolute -left-[9999px]" aria-hidden="true"><label>Website<input name="company_website" tabindex="-1" autocomplete="off" /></label></div>
    <button class="btn" type="submit">Verstuur</button>
    <p data-status class="text-sm" role="status"></p>
  </form>
</section>

<div id="ap-exit" class="ap-exit" hidden role="dialog" aria-modal="true" aria-labelledby="ap-exit-title">
  <div class="ap-exit-card">
    <div class="flex items-start gap-3">
      <img class="niels-koffie ap-exit-photo" src={site.founder.photo} width={site.founder.photoWidth} height={site.founder.photoHeight} alt="Niels Alderding" />
      <div class="flex min-w-0 flex-1 items-start justify-between gap-3">
        <h2 id="ap-exit-title" class="font-serif text-3xl text-green-950" tabindex="-1">Wat kan ik voor u doen?</h2>
        <button class="ap-close" type="button" data-close aria-label="Sluiten">×</button>
      </div>
    </div>
    <p class="mt-2">Naam en e-mailadres zijn verplicht. Telefoon en bedrijfsnaam mogen leeg. Een keer per bezoek. {site.responsePromise}</p>
    <form class="ap-lead mt-3" data-magnet>
      <label>Naam, verplicht<input name="naam" required autocomplete="name" /></label>
      <label>E-mailadres, verplicht<input name="email" type="email" required autocomplete="email" /></label>
      <label>Telefoon<input name="telefoon" type="tel" autocomplete="tel" inputmode="tel" aria-describedby="ap-exit-tel-hint" /></label>
      <p id="ap-exit-tel-hint" class="ap-hint">voor een snelle terugbelafspraak</p>
      <label>Bedrijfsnaam<input name="organisatie" autocomplete="organization" /></label>
      <div class="ap-exit-choices" role="radiogroup" aria-label="Kies wat u wilt doen">
        <label class="ap-exit-choice"><input type="radio" name="keuze" value="checklist" checked /> <span>Stuur mij de gratis verzuimchecklist</span></label>
        <label class="ap-exit-choice"><input type="radio" name="keuze" value="terugbel" /> <span>Bel mij terug</span></label>
        <label class="ap-exit-choice"><input type="radio" name="keuze" value="gesprek" /> <span>Plan direct een gesprek</span></label>
        <label class="ap-exit-choice"><input type="radio" name="keuze" value="besparing" /> <span>Bereken mijn besparing</span></label>
      </div>
      <div data-panel="checklist" class="ap-exit-panel">
        <p>De verzuim-checklist downloadt meteen als pdf. Geen advies over één dossier.</p>
      </div>
      <div data-panel="terugbel" class="ap-exit-panel" hidden>
        <p>Wanneer het u uitkomt. {site.responsePromise}</p>
        <div class="ap-exit-times">
          <button type="button" data-when="Ochtend">Ochtend</button>
          <button type="button" data-when="Middag">Middag</button>
          <button type="button" data-when="Later deze week">Later deze week</button>
        </div>
        <label>Uw tijdvoorkeur<input name="wanneer" maxlength="180" /></label>
      </div>
      <p data-panel="gesprek" class="ap-exit-panel" hidden>{calendlyKennismaking.note}</p>
      <p data-panel="besparing" class="ap-exit-panel" hidden>U gaat naar de vergelijking op deze site. Die rekent met uw aannames. Het is geen offerte.</p>
      <input type="hidden" name="checklist" data-checklist-body />
      <label class="flex items-start gap-2 text-sm"><input type="checkbox" name="toestemming" value="ja" required /> <span>Matchvermogen B.V. mag deze gegevens gebruiken om op mijn keuze te reageren. <a href="/privacy">Privacy</a></span></label>
      <div class="absolute -left-[9999px]" aria-hidden="true"><label>Website<input name="company_website" tabindex="-1" autocomplete="off" /></label></div>
      <div class="ap-actions">
        <button class="btn" type="submit" data-exit-submit data-cta="exit-checklist">Stuur mij de gratis verzuimchecklist</button>
        <button class="btn btn-ghost" type="button" data-close>Nee, dank u</button>
      </div>
      <p data-status class="text-sm" role="status"></p>
    </form>
  </div>
</div>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }
</style>

<script>
  import "../scripts/engage.ts";
</script>
