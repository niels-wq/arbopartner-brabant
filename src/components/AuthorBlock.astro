---
import { site } from "../data/site";
---

<aside class="mt-8 rounded-3xl border border-line bg-white/80 p-5 text-sm">
  <div class="flex items-center gap-3">
    <img class="niels-face h-14 w-14 rounded-full" src={site.founder.avatar} width="240" height="240" alt="" />
    <div>
      <h2 class="font-serif text-2xl text-green-950">{site.founder.name}</h2>
      <p>{site.founder.role}</p>
    </div>
  </div>
  <p class="mt-3">
    {site.name} is een label van {site.parent.legalName}, KvK {site.parent.kvk}, {site.parent.street}, {site.parent.postalCode} {site.parent.city}.
    {site.founder.name} is verantwoordelijk voor deze tekst. Het is algemene informatie voor werkgevers, geen medisch oordeel en geen advies over één dossier.
  </p>
  <p class="mt-2">
    Reviews op deze site zijn van Matchvermogen, niet van dit label.
    <a class="font-semibold underline" href="/reviews">Bron en datum</a>.
    Telefoon <a class="font-semibold underline" href={`tel:${site.parent.phoneTel}`}>{site.parent.phoneDisplay}</a>.
  </p>
</aside>
