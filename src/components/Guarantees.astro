---
import { analysisPromise, priceFinePrint, pricePromise, qualityConditions } from "../data/garanties";
import { site } from "../data/site";

interface Props {
  plaats?: "home" | "pakketten" | "vergelijking" | "diensten";
}

const { plaats = "home" } = Astro.props;
const vergelijkingHref = plaats === "vergelijking" ? "#kostenvergelijking" : "/casemanager-inhuren-of-in-dienst#vergelijking";
const vergelijkingLabel = plaats === "vergelijking" ? "Vraag uw persoonlijke kostenvergelijking aan" : "Bekijk de vergelijking";
---

<section class="mx-auto max-w-6xl px-4 py-16" aria-labelledby="garanties-kop">
  <h2 id="garanties-kop" class="font-serif text-3xl text-green-950">Onze garanties</h2>
  <p class="mt-3 max-w-3xl">{site.responsePromise}</p>
  <div class="mt-8 grid gap-6 md:grid-cols-3">
    <article class="flex flex-col rounded-2xl border border-line bg-white p-6">
      <h3 class="font-serif text-2xl text-green-950">Hoe het verzuim kan dalen</h3>
      <p class="mt-3 flex-1">{analysisPromise}</p>
      <a class="mt-5 inline-block rounded-full bg-green-800 px-5 py-3 text-center font-semibold text-sand-50" data-cta={`garantie-analyse-${plaats}`} href="/diensten/verzuimanalyse#gratis">Gratis verzuimanalyse</a>
    </article>
    <article class="flex flex-col rounded-2xl border border-line bg-white p-6">
      <h3 class="font-serif text-2xl text-green-950">Kwaliteit, als u de adviezen volgt</h3>
      <p class="mt-3 flex-1">Volgt u onze adviezen op, dan staan we voor de kwaliteit van de begeleiding. Klopt de aanpak niet, dan sturen we kosteloos bij of wisselen we van casemanager.</p>
      <p class="mt-4 text-xs text-ink-soft">{qualityConditions}</p>
    </article>
    <article class="flex flex-col rounded-2xl border border-line bg-white p-6">
      <h3 class="font-serif text-2xl text-green-950">Goedkoper dan iemand in dienst</h3>
      <p class="mt-3 flex-1">{pricePromise}</p>
      <p class="mt-4 text-xs text-ink-soft">{priceFinePrint}</p>
      <a class="mt-5 inline-block rounded-full bg-green-800 px-5 py-3 text-center font-semibold text-sand-50" data-cta={`garantie-vergelijking-${plaats}`} href={vergelijkingHref}>{vergelijkingLabel}</a>
    </article>
  </div>
</section>
