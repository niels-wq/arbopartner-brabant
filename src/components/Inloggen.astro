---
import Button from "./Button.astro";

interface Props {
  variant?: "ghost" | "ghost-light";
  class?: string;
  cta?: string;
}

const { variant = "ghost-light", class: className, cta = "inloggen-arbeid-ai" } = Astro.props;
---

<Button
  variant={variant}
  class={className}
  href="https://app.arbeid.ai/auth/login"
  target="_blank"
  rel="noopener"
  aria-label="Inloggen in arbeid.ai"
  data-cta={cta}
>
  <svg class="mr-1.5 h-4 w-4 shrink-0" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <rect x="5" y="11" width="14" height="10" rx="2" fill="none" stroke="currentColor" stroke-width="2"></rect>
    <path d="M8 11V8a4 4 0 0 1 8 0v3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
  </svg>
  Inloggen
</Button>
