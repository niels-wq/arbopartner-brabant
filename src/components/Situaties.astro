---
import Figure from "./Figure.astro";
import Mark from "./Mark.astro";
import { situaties } from "../data/situaties";

interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<section class="mx-auto max-w-6xl px-4 py-16" aria-labelledby="situaties-kop">
  <div class="grid items-end gap-6 md:grid-cols-[1.2fr_0.8fr]">
    <div>
      <h2 id="situaties-kop" class="font-serif text-3xl text-green-950">Herkent u dit?</h2>
      <p class="mt-3 max-w-2xl text-ink-soft">
        Zes situaties die we bij werkgevers tegenkomen. Geen verzonnen klant met een naam. Wel het probleem, wat wij doen, en wat u ervan mag verwachten.
      </p>
    </div>
    <Figure id="pagina-situaties" class="max-w-xl" />
  </div>
  <div class="mt-8 grid gap-4 md:grid-cols-2">
    {situaties.map((item) => (
      <article id={compact ? undefined : item.slug} class="overflow-hidden rounded-2xl border border-line bg-white">
        <Figure id={`situatie-${item.slug}`} sizes="(min-width: 768px) 28rem, 100vw" />
        <div class="p-6">
          <h3 class="font-serif text-2xl text-green-950"><Mark name={item.icon} />{item.title}</h3>
          <h4 class="mt-4 text-sm font-semibold uppercase tracking-wide text-ochre-800">Het probleem</h4>
          <p class="mt-1">{item.probleem}</p>
          <h4 class="mt-4 text-sm font-semibold uppercase tracking-wide text-ochre-800">Onze oplossing</h4>
          <p class="mt-1">{item.oplossing}</p>
          <h4 class="mt-4 text-sm font-semibold uppercase tracking-wide text-ochre-800">Het resultaat</h4>
          <p class="mt-1">{item.resultaat}</p>
          <p class="mt-4">
            <a class="font-semibold text-green-800 underline" href={compact ? `/situaties#${item.slug}` : item.href}>{item.hrefLabel}</a>
          </p>
        </div>
      </article>
    ))}
  </div>
  <div class="mt-8">
    <a class="rounded-full bg-green-800 px-5 py-3 font-semibold" data-cta={compact ? "home-situatie" : "situaties-advies"} href="/adviesgesprek">Bespreek uw situatie</a>
    {compact && (
      <a class="ml-4 font-semibold text-green-800 underline" data-cta="home-situaties" href="/situaties">Alle situaties op één pagina</a>
    )}
  </div>
</section>
