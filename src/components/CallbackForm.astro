---
import MedewerkersVeld from "./MedewerkersVeld.astro";
import { site } from "../data/site";
---

<form id="terugbel" class="space-y-3 rounded-[2rem] border border-line bg-white/80 p-5" data-endpoint="/api/terugbel" data-kind="terugbel" data-cta="terugbel">
  <h2 class="font-serif text-3xl text-green-950">Terugbelverzoek</h2>
  <p>Naam en telefoon. We bellen u terug. {site.placeholders.callback}</p>
  <label class="block">Naam<input class="ap-field" name="naam" required autocomplete="name" /></label>
  <label class="block">Telefoon<input class="ap-field" name="telefoon" type="tel" required autocomplete="tel" /></label>
  <MedewerkersVeld />
  <label class="block">Wanneer het u uitkomt, als u dat wilt<input class="ap-field" name="wanneer" maxlength="180" /></label>
  <label class="flex items-start gap-2 text-sm">
    <input name="toestemming" type="checkbox" value="ja" required />
    <span>Matchvermogen B.V. mag mij bellen over deze vraag. <a class="underline" href="/privacy">Privacy</a></span>
  </label>
  <div class="absolute -left-[9999px]" aria-hidden="true">
    <label>Website<input name="company_website" tabindex="-1" autocomplete="off" /></label>
  </div>
  <button class="rounded-full bg-ochre-500 px-5 py-3 font-semibold" type="submit">Bel mij terug</button>
  <p class="text-sm">U zit nergens aan vast. We bellen over dit verzoek.</p>
  <p data-status class="text-sm" role="status"></p>
</form>

<script>
  import "../scripts/forms.ts";
</script>
