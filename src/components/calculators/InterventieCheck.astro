---
import Button from "../Button.astro";
import InlineLead from "../InlineLead.astro";
import {
  bulkDiensten,
  disclaimer,
  groepen,
  prioriteiten,
  staffelToelichting,
} from "../../lib/interventie-tarief";

interface Props {
  modus?: "volledig" | "compact";
}

const { modus = "volledig" } = Astro.props;
const groepenLijst = groepen();
const bulkLijst = bulkDiensten();
---

<div class="scroll-mt-28" data-interventie-check data-modus={modus}>
  <div class="rounded-[2rem] border border-line bg-white/80 p-5 md:p-8">
    <div>
      <label class="block font-semibold" for="interventie-dienst">1. Om welke dienst gaat het?</label>
      <select class="field" id="interventie-dienst" data-dienst>
        {
          groepenLijst.map((groep) => (
            <optgroup label={groep.titel}>
              {groep.diensten.map((dienst) => (
                <option value={dienst.id} data-per-uur={dienst.perUur ? "1" : "0"}>
                  {dienst.label}
                </option>
              ))}
            </optgroup>
          ))
        }
      </select>
      <p class="mt-3 text-sm text-ink-soft" data-dienst-toelichting></p>
    </div>

    <fieldset class="mt-8">
      <legend class="font-semibold">Twee dingen om na te vragen bij een offerte</legend>
      <label class="mt-4 flex items-start gap-3">
        <input class="mt-1" type="checkbox" data-uwv />
        <span>Is bij uw tarief een UWV-garantie inbegrepen?</span>
      </label>
      <p class="mt-2 text-sm text-ink-soft">
        Een UWV-garantie betekent dat het traject zo is opgezet dat de re-integratie-inspanningen bij een WIA-beoordeling worden geaccepteerd. Vink aan als uw huidige tarief dat noemt.
      </p>
      <label class="mt-4 flex items-start gap-3">
        <input class="mt-1" type="checkbox" data-bulk />
        <span>Neemt u dit traject in bulk af, voor meerdere medewerkers tegelijk?</span>
      </label>
      <p class="mt-2 text-sm text-ink-soft">
        Bij meerdere medewerkers tegelijk ligt een tarief vaak lager dan bij één traject. Vink aan als uw prijs al zo’n korting bevat. De vergelijking haalt dan 10% van het richttarief af. Dat percentage is indicatief.
      </p>
    </fieldset>

    <fieldset class="mt-8">
      <legend class="font-semibold">2. Wat is voor u het belangrijkste bij dit traject?</legend>
      <div class="mt-4 flex flex-wrap gap-2" data-prioriteit>
        {
          prioriteiten.map((keuze) => (
            <button
              class="min-h-11 rounded-full border border-green-800 px-4 py-2 font-semibold text-green-950"
              type="button"
              data-waarde={keuze.id}
              aria-pressed="false"
            >
              {keuze.label}
            </button>
          ))
        }
      </div>
    </fieldset>

    <div class="mt-8" data-uren hidden>
      <label class="block font-semibold" for="interventie-uren">
        Aantal adviesuren
        <input class="field" id="interventie-uren" data-uren-invoer type="number" min="1" step="0.5" value="1" inputmode="decimal" />
      </label>
    </div>

    <div class="mt-8">
      <label class="block font-semibold" for="interventie-bedrag">
        Wat betaalt u, of krijgt u aangeboden, voor dit traject in totaal?
        <input class="field" id="interventie-bedrag" data-bedrag type="number" min="0" step="0.01" inputmode="decimal" />
      </label>
      <p class="mt-2 text-sm text-ink-soft">Exclusief btw. Vul het totaalbedrag in, niet het uurtarief, behalve als de dienst per uur is.</p>
    </div>

    <div class="mt-6">
      <Button type="button" data-bereken="1">Bereken mijn vergelijking</Button>
    </div>
    <p class="mt-4 text-sm font-semibold text-ochre-800" data-fout role="alert" hidden></p>

    <div class="mt-6 rounded-3xl bg-sand-100 p-5" data-uitkomst hidden>
      <p class="font-serif text-3xl text-green-950" data-kop></p>
      <p class="mt-3" data-tekst></p>
      <p class="mt-3 text-sm text-ink-soft" data-context></p>
      <div class="mt-5">
        <Button type="button" data-gesprek="1">Vraag een vrijblijvend gesprek aan</Button>
      </div>
    </div>
  </div>

  <p class="mt-6 max-w-3xl text-sm text-ink-soft">{disclaimer}</p>

  {
    modus === "compact" && (
      <p class="mt-4">
        <a class="font-semibold underline" href="/tools/interventie-check#bulkvoordeel">
          Naar de volledige vergelijking en het bulkvoordeel
        </a>
      </p>
    )
  }

  <div class="scroll-mt-28 mt-8" data-gesprek-blok hidden>
    <InlineLead
      source="interventie-check"
      title="Gesprek over dit tarief"
      text="De vergelijking vraagt geen persoonsgegevens. Dit formulier wel: telefoon, naam en organisatie. We bellen terug. Dit is nog geen offerte."
      submit="Verstuur de aanvraag"
    />
  </div>

  {
    modus === "volledig" && (
      <section class="mt-16" id="bulkvoordeel" aria-labelledby="bulk-titel">
        <h2 id="bulk-titel" class="max-w-3xl font-serif text-3xl text-green-950 md:text-4xl">
          Bulkvoordeel: hoeveel scheelt het bij meerdere medewerkers tegelijk?
        </h2>
        <p class="mt-4 max-w-3xl">
          Bij een reorganisatie of een groep met een vergelijkbaar profiel is gebundeld inkopen vaak voordeliger dan elk traject apart. De begeleiding blijft per medewerker. Alleen de inkoop verandert. De percentages hieronder zijn indicatief.
        </p>
        <div class="mt-6 rounded-[2rem] border border-line bg-white/80 p-5 md:p-8">
          <label class="block font-semibold" for="bulk-aantal">
            Voor hoeveel medewerkers gaat het?
            <input class="field" id="bulk-aantal" data-bulk-aantal type="number" min="1" max="9999" step="1" value="10" inputmode="numeric" />
          </label>
          <label class="mt-6 block font-semibold" for="bulk-dienst">
            Om welke interventie gaat het?
            <select class="field" id="bulk-dienst" data-bulk-dienst>
              {bulkLijst.map((dienst) => (
                <option value={dienst.id}>{dienst.label}</option>
              ))}
            </select>
          </label>
          <div class="mt-6">
            <Button type="button" data-bulk-bereken="1">
              Bereken het bulkvoordeel
            </Button>
          </div>
          <p class="mt-4 text-sm font-semibold text-ochre-800" data-bulk-fout role="alert" hidden></p>
          <div class="mt-6 rounded-3xl bg-sand-100 p-5" data-bulk-uitkomst hidden>
            <p class="font-serif text-3xl text-green-950" data-bulk-kop></p>
            <p class="mt-3" data-bulk-tekst></p>
            <div class="mt-5">
              <Button type="button" data-bulk-gesprek="1">
                Bespreek een bulkinkoop met ons
              </Button>
            </div>
          </div>
        </div>
        <p class="mt-4 max-w-3xl text-sm text-ink-soft">{staffelToelichting}</p>
      </section>
    )
  }
</div>

<script>
  import "../../scripts/interventie-check.ts";
</script>
