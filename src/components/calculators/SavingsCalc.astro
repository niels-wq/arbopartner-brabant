<div data-savings class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr]">
  <form class="space-y-4 rounded-[2rem] border border-line bg-white/80 p-5 md:p-7">
    <label class="block text-sm font-semibold">Aantal medewerkers
      <input class="field" name="employees" type="number" min="35" value="80" />
    </label>
    <label class="block text-sm font-semibold">Eigen verzuimpercentage
      <input class="field" name="absence" type="number" min="0" max="30" step="0.1" value="4.7" />
    </label>
    <p class="text-sm text-ink-soft" data-benchmark></p>
    <label class="block text-sm font-semibold">Gemiddeld bruto jaarloon
      <input class="field" name="wage" type="number" min="20000" step="500" value="36500" />
    </label>
    <label class="block text-sm font-semibold">Aantal langdurige dossiers
      <input class="field" name="long" type="number" min="0" value="2" />
    </label>
    <fieldset>
      <legend class="text-sm font-semibold">Scenario: daling in procentpunten</legend>
      <p class="text-sm text-ochre-800">Scenario, geen belofte. Er is geen bron die een vaste daling door een casemanager onderbouwt. U kiest het scenario zelf.</p>
      <div class="mt-2 flex gap-2">
        <label class="chip"><input type="radio" name="scenario" value="0.5" /> 0,5</label>
        <label class="chip"><input type="radio" name="scenario" value="1" checked /> 1,0</label>
        <label class="chip"><input type="radio" name="scenario" value="1.5" /> 1,5</label>
      </div>
    </fieldset>
    <label class="block text-sm font-semibold">Niveau casemanager
      <select class="field" name="level">
        <option value="medior">Medior</option>
        <option value="medior-plus">Medior+</option>
        <option value="senior">Senior met specialisatie</option>
      </select>
    </label>
    <label class="block text-sm font-semibold">Uren per week
      <input class="field" name="hours" type="number" min="10" max="40" value="10" />
    </label>
    <button class="rounded-full bg-green-800 px-5 py-3 font-semibold text-sand-50" type="submit">Reken het scenario</button>
  </form>
  <div>
    <div data-out class="rounded-[2rem] border border-line bg-white/80 p-6" aria-live="polite">
      <p class="font-serif text-2xl text-green-950">Vul uw cijfers in. Het resultaat is een scenario, geen belofte.</p>
    </div>
    <details class="mt-4 rounded-3xl bg-sand-100 p-4 text-sm" open>
      <summary class="cursor-pointer font-semibold">Bronnen bij deze berekening</summary>
      <ul class="mt-3 space-y-2" data-sources></ul>
    </details>
  </div>
</div>

<style>
  .field { display: block; margin-top: 0.25rem; width: 100%; max-width: 16rem; border: 1px solid var(--color-line); border-radius: 0.8rem; padding: 0.45rem 0.7rem; background: white; }
  .chip { display: inline-flex; gap: 0.35rem; border: 1px solid var(--color-line); border-radius: 999px; padding: 0.3rem 0.7rem; background: white; }
</style>

<script>
  import { defaultAbsencePct, savings, savingsSources, type SavingsInput } from "../../lib/calc";
  import { euro, num, pct } from "../../lib/format";
  import { levels } from "../../lib/rates";

  const root = document.querySelector<HTMLElement>("[data-savings]");
  const form = root?.querySelector("form");
  const out = root?.querySelector<HTMLElement>("[data-out]");
  const benchmark = root?.querySelector<HTMLElement>("[data-benchmark]");
  const sources = root?.querySelector<HTMLElement>("[data-sources]");
  const employees = form?.querySelector<HTMLInputElement>("[name=employees]");
  const absence = form?.querySelector<HTMLInputElement>("[name=absence]");

  if (sources) {
    sources.innerHTML = savingsSources
      .map((item) => `<li><a class="font-semibold text-green-800 underline decoration-ochre-500" href="${item.url}">${item.title}</a> — ${item.note}</li>`)
      .join("");
  }

  function refreshBenchmark() {
    if (!employees || !benchmark) return;
    const cbs = defaultAbsencePct(Number(employees.value || 0));
    benchmark.textContent = `CBS-benchmark bij deze grootte: ${pct(cbs)}. U kunt dat getal overnemen of uw eigen percentage laten staan.`;
  }
  employees?.addEventListener("change", () => {
    if (absence && employees) absence.value = String(defaultAbsencePct(Number(employees.value)));
    refreshBenchmark();
  });
  refreshBenchmark();

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!form || !out) return;
    const data = new FormData(form);
    const input: SavingsInput = {
      employees: Number(data.get("employees")),
      absencePct: Number(data.get("absence")),
      annualWage: Number(data.get("wage")),
      longCases: Number(data.get("long")),
      scenarioPoints: Number(data.get("scenario")) as 0.5 | 1 | 1.5,
      level: String(data.get("level")) as SavingsInput["level"],
      weeklyHours: Number(data.get("hours")),
    };
    const result = savings(input);
    const sign =
      result.net >= 0
        ? "minder dan het verschil in verzuimkosten"
        : "meer dan het verschil in verzuimkosten";
    out.innerHTML = `
      <p class="text-sm font-semibold uppercase tracking-[0.14em] text-ochre-800">Scenario, geen belofte</p>
      <h2 class="mt-2 font-serif text-3xl text-green-950">Verzuim kost nu ${euro(result.costNow, true)} per jaar</h2>
      <p class="mt-2">Dat is ${euro(result.day)} per verzuimdag, bij ${num(input.employees, 0)} medewerkers, ${pct(input.absencePct)} verzuim en een jaarloon van ${euro(input.annualWage, true)}. Alleen het loongerelateerde deel van de TNO-dagkosten schaalt mee met het loon. Arbo (€60) en begeleiding (€7,50) blijven vast.</p>
      <dl class="mt-4 grid gap-3 sm:grid-cols-2">
        <div class="rounded-2xl bg-sand-100 p-3"><dt>Scenario ${pct(input.scenarioPoints)} punt lager</dt><dd class="font-serif text-2xl">${euro(result.costScenario, true)}</dd></div>
        <div class="rounded-2xl bg-sand-100 p-3"><dt>Verschil in verzuimkosten</dt><dd class="font-serif text-2xl">${euro(result.grossSaving, true)}</dd></div>
        <div class="rounded-2xl bg-sand-100 p-3"><dt>${levels[input.level].label}, ${input.weeklyHours} uur</dt><dd class="font-serif text-2xl">${euro(result.guidanceCost, true)} per jaar</dd></div>
        <div class="rounded-2xl bg-green-900 p-3 text-sand-50"><dt>Verschil minus begeleiding</dt><dd class="font-serif text-2xl">${euro(result.net, true)}</dd></div>
      </dl>
      <p class="mt-3 text-sm">De begeleiding kost in dit scenario ${sign}. Dat is rekenwerk, geen voorspelling.</p>
      <p class="mt-3 text-sm">Risico-indicator, aanname: ${input.longCases} langdurige dossier(s) × 52 weken × weekloon × 1,3 werkgeverslasten = <strong>${euro(result.sanctionRisk, true)}</strong>. UWV kan maximaal 52 weken extra loon opleggen. De factor 1,3 is van ons, niet van UWV. Dit is geen kansberekening.</p>
    `;
  });
</script>
