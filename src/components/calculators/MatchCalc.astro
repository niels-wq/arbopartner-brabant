<div data-match class="grid gap-8 lg:grid-cols-[1.1fr_0.9fr]">
  <form class="space-y-6 rounded-[2rem] border border-line bg-white/80 p-5 md:p-7">
    <fieldset>
      <legend class="font-semibold">1. Aantal medewerkers</legend>
      <p class="text-sm text-ink-soft">We werken vanaf 35 medewerkers.</p>
      <div class="mt-2 flex flex-wrap gap-2">
        <label class="chip"><input type="radio" name="size" value="35-75" checked /> 35–75</label>
        <label class="chip"><input type="radio" name="size" value="76-200" /> 76–200</label>
        <label class="chip"><input type="radio" name="size" value="200+" /> 200+</label>
      </div>
      <label class="mt-3 block text-sm">Precies aantal
        <input class="field" type="number" name="headcount" min="35" value="50" />
      </label>
    </fieldset>
    <fieldset>
      <legend class="font-semibold">2. Verzuimpercentage</legend>
      <p class="text-sm text-ink-soft">CBS 2025: Nederland 5,4%.</p>
      <div class="mt-2 flex flex-wrap gap-2">
        <label class="chip"><input type="radio" name="absence" value="lt4" checked /> onder 4%</label>
        <label class="chip"><input type="radio" name="absence" value="4-6" /> 4–6%</label>
        <label class="chip"><input type="radio" name="absence" value="gt6" /> boven 6%</label>
      </div>
    </fieldset>
    <fieldset>
      <legend class="font-semibold">3. Langdurige dossiers, langer dan 6 weken</legend>
      <div class="mt-2 flex flex-wrap gap-2">
        <label class="chip"><input type="radio" name="long" value="0-1" checked /> 0–1</label>
        <label class="chip"><input type="radio" name="long" value="2-4" /> 2–4</label>
        <label class="chip"><input type="radio" name="long" value="5+" /> 5 of meer</label>
      </div>
    </fieldset>
    <fieldset>
      <legend class="font-semibold">4. Aard van het verzuim</legend>
      <div class="mt-2 flex flex-wrap gap-2">
        <label class="chip"><input type="radio" name="nature" value="fysiek" checked /> vooral fysiek</label>
        <label class="chip"><input type="radio" name="nature" value="gemengd" /> gemengd</label>
        <label class="chip"><input type="radio" name="nature" value="psychisch" /> vooral psychisch of conflict</label>
      </div>
    </fieldset>
    <fieldset>
      <legend class="font-semibold">5. Dossier aan het einde van jaar 1, of een WIA-aanvraag?</legend>
      <div class="mt-2 flex gap-2">
        <label class="chip"><input type="radio" name="year1" value="nee" checked /> nee</label>
        <label class="chip"><input type="radio" name="year1" value="ja" /> ja</label>
      </div>
    </fieldset>
    <fieldset>
      <legend class="font-semibold">6. Loonsanctierisico, conflict of een arbeidsrechtelijke component?</legend>
      <div class="mt-2 flex gap-2">
        <label class="chip"><input type="radio" name="sanction" value="nee" checked /> nee</label>
        <label class="chip"><input type="radio" name="sanction" value="ja" /> ja</label>
      </div>
    </fieldset>
    <fieldset>
      <legend class="font-semibold">7. Eigen HR</legend>
      <div class="mt-2 flex flex-wrap gap-2">
        <label class="chip"><input type="radio" name="hr" value="team" checked /> HR-team</label>
        <label class="chip"><input type="radio" name="hr" value="one" /> één HR-persoon</label>
        <label class="chip"><input type="radio" name="hr" value="none" /> geen HR</label>
      </div>
    </fieldset>
    <fieldset>
      <legend class="font-semibold">8. Sector met eigen cao of risico’s, zoals zorg, bouw, metaal of transport?</legend>
      <div class="mt-2 flex gap-2">
        <label class="chip"><input type="radio" name="sector" value="nee" checked /> nee</label>
        <label class="chip"><input type="radio" name="sector" value="ja" /> ja</label>
      </div>
    </fieldset>
    <button class="rounded-full bg-green-800 px-5 py-3 font-semibold text-sand-50" type="submit">Toon de match</button>
  </form>
  <div data-out class="rounded-[2rem] bg-green-950 p-6 text-sand-50" aria-live="polite">
    <p class="text-sm uppercase tracking-[0.16em] text-ochre-200">Richtadvies</p>
    <p class="mt-3 font-serif text-3xl">Beantwoord de vragen. U ziet daarna niveau, pakket en een richtprijs per maand.</p>
  </div>
</div>

<style>
  .chip {
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    padding: 0.35rem 0.7rem;
    background: white;
  }
  .field {
    margin-top: 0.25rem;
    width: 8rem;
    border: 1px solid var(--color-line);
    border-radius: 0.8rem;
    padding: 0.4rem 0.6rem;
  }
</style>

<script>
  import { headcountDefault, matchCasemanager, type MatchAnswers } from "../../lib/calc";
  import { euro } from "../../lib/format";
  import { blocks, levels } from "../../lib/rates";
  import { mountReport } from "../../scripts/report";
  import { track } from "../../scripts/track";

  const root = document.querySelector<HTMLElement>("[data-match]");
  const form = root?.querySelector("form");
  const out = root?.querySelector<HTMLElement>("[data-out]");
  const headcount = form?.querySelector<HTMLInputElement>("[name=headcount]");
  let headcountTouched = false;
  headcount?.addEventListener("input", () => {
    headcountTouched = true;
  });
  form?.querySelectorAll<HTMLInputElement>("[name=size]").forEach((input) => {
    input.addEventListener("change", () => {
      if (!headcountTouched && headcount) {
        headcount.value = String(headcountDefault(input.value as MatchAnswers["size"]));
      }
    });
  });

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!form || !out) return;
    const data = new FormData(form);
    const size = String(data.get("size")) as MatchAnswers["size"];
    const result = matchCasemanager({
      size,
      headcount: Number(data.get("headcount") || headcountDefault(size)),
      absence: String(data.get("absence")) as MatchAnswers["absence"],
      long: String(data.get("long")) as MatchAnswers["long"],
      nature: String(data.get("nature")) as MatchAnswers["nature"],
      year1: data.get("year1") === "ja",
      sanction: data.get("sanction") === "ja",
      hr: String(data.get("hr") || "team") as MatchAnswers["hr"],
      sector: data.get("sector") === "ja",
    });
    const pack = blocks[result.block];
    out.innerHTML = `
      <p class="text-sm uppercase tracking-[0.16em] text-ochre-200">Richtadvies, geen offerte</p>
      <h2 class="mt-2 font-serif text-4xl">${result.levelLabel}</h2>
      <p class="mt-2 text-sand-100">${levels[result.level].summary}</p>
      <p class="mt-4">Score ${result.score}. ${result.override ? "Omdat er een sanctie- of conflictrisico samenvalt met psychisch verzuim, adviseren we een senior. Dat is een harde regel, ook als de score lager is." : ""} ${result.steppedUp ? "De score is 8 of hoger, daarom ligt het uurblok een stap hoger dan het aantal medewerkers alleen zou suggereren." : ""}</p>
      <dl class="mt-4 grid grid-cols-2 gap-3 text-sm">
        <div><dt class="text-sand-200">Pakket</dt><dd class="text-lg font-semibold">${pack.name}</dd></div>
        <div><dt class="text-sand-200">Inzet</dt><dd class="text-lg font-semibold">${result.billedHours} uur per week</dd></div>
        <div><dt class="text-sand-200">Richtprijs per uur</dt><dd class="text-lg font-semibold">${euro(result.hourly)}</dd></div>
        <div><dt class="text-sand-200">Per maand</dt><dd class="text-lg font-semibold">${euro(result.monthly)}</dd></div>
      </dl>
      <p class="mt-3 text-sm text-sand-200">Exclusief btw. Reistijd binnen 45 minuten zit erin. ${result.twoPeople ? "Vanaf 30 uur werken twee casemanagers." : ""} Vuistregel: ongeveer 10 uur per 100 medewerkers, met een minimum van 10 uur.</p>
      <div class="mt-5 flex flex-col gap-3 sm:flex-row">
        <a class="rounded-full bg-ochre-500 px-4 py-2 text-center font-semibold text-ink" data-cta="match-advies" href="/adviesgesprek">Plan een adviesgesprek</a>
        <a class="rounded-full border border-sand-200 px-4 py-2 text-center font-semibold" data-cta="match-offerte" href="/offerte">Vraag een offerte</a>
      </div>
      ${result.spoed ? `<p class="mt-4"><a class="font-semibold text-ochre-200 underline" data-cta="match-spoed" href="/spoedhulp">U noemt een sanctie, een conflict of een arbeidsrechtelijke component. Ga naar spoedhulp.</a></p>` : ""}
    `;
    const body = out.innerText.trim();
    track("calculator_result", { calculator: "welke-casemanager" });
    mountReport(out, { calculator: "welke-casemanager", title: "Richtadvies casemanager", body });
  });
</script>
