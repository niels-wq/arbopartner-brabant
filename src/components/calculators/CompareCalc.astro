---
import { compareSources, defaultCompareInput } from "../../lib/calc";
import { compareReportHtml } from "../../lib/compare-view";
import { compareEmployment } from "../../lib/calc";

const defaults = defaultCompareInput();
const initialHtml = compareReportHtml(defaults, compareEmployment(defaults));
---

<div data-compare id="vergelijking">
  <div data-out class="rounded-[2rem] border border-line bg-white/80 p-6 md:p-8" aria-live="polite" set:html={initialHtml} />
  <form class="mt-6 grid gap-6 lg:grid-cols-2">
    <div class="space-y-4 rounded-[2rem] border border-line bg-white/80 p-5 md:p-7">
      <p class="text-sm font-semibold uppercase tracking-[0.14em] text-ochre-800">Uw situatie</p>
      <label class="block text-sm font-semibold">Niveau
        <select class="ap-field" name="level">
          <option value="medior" selected>Medior</option>
          <option value="medior-plus">Medior+</option>
          <option value="senior">Senior met specialisatie</option>
        </select>
      </label>
      <label class="block text-sm font-semibold">Uren per week die u echt nodig heeft
        <input class="ap-field" name="hours" type="number" min="1" max="80" step="1" value={defaults.neededHours} />
      </label>
      <p class="text-sm text-ink-soft">Bij inhuren rekenen we die uren, met een minimum van tien. Bij een dienstverband betaalt u het volle contract, ook als u minder uren nodig heeft.</p>
      <label class="block text-sm font-semibold">Bruto maandloon bij een dienstverband
        <input class="ap-field" name="gross" type="number" min="0" step="0.01" value={defaults.grossMonthly.toFixed(2)} />
      </label>
      <p class="text-xs text-ink-soft" data-salary-note>Afgeleid van het CBS-mediaan uurloon. Geen CBS-maandloon. Pas het aan naar het loon dat u echt zou bieden.</p>
      <label class="block text-sm font-semibold">Contracturen per week in dienst
        <input class="ap-field" name="contract" type="number" min="8" max="40" value={defaults.contractHours} />
      </label>
      <button class="rounded-full bg-green-800 px-5 py-3 font-semibold text-sand-50" type="submit">Reken opnieuw</button>
    </div>
    <fieldset class="space-y-3 rounded-[2rem] bg-sand-100 p-5 md:p-7">
      <legend class="font-semibold text-green-950">Aannames, met bron en aanpasbaar</legend>
      <label class="check"><input type="checkbox" name="large" checked /> Grote werkgever (Aof hoog, 7,63%). Uitvinken = niet-groot, Aof 6,27%. Middelgroot vult u zelf, die mix verschilt per werkgever.</label>
      <label class="check"><input type="checkbox" name="temporary" /> Tijdelijk contract (AWf hoog, 7,74% in plaats van 2,74%).</label>
      <label class="block text-sm">Whk, %. Standaard 1,52, het landelijk gemiddelde. Niet uw eigen beschikking.
        <input class="ap-field" name="whk" type="number" min="0" max="10" step="0.01" value={defaults.whkPct} />
      </label>
      <label class="block text-sm">Pensioen werkgever, % van bruto jaarloon. Standaard 0: er is geen landelijk percentage.
        <input class="ap-field" name="pension" type="number" min="0" max="40" step="0.1" value={defaults.pensionPct} />
      </label>
      <label class="block text-sm">Eindejaarsuitkering, % van bruto jaarloon plus vakantiegeld. Standaard 0: er is geen wettelijk percentage.
        <input class="ap-field" name="yearend" type="number" min="0" max="20" step="0.1" value={defaults.yearEndPct} />
      </label>
      <label class="block text-sm">Verzuim van de casemanager zelf, %. Standaard CBS 5,4.
        <input class="ap-field" name="absence" type="number" min="0" max="100" step="0.1" value={defaults.absencePct} />
      </label>
      <label class="block text-sm">Loondoorbetaling tijdens ziekte, %. Wettelijk minimum is 70. Standaard 100.
        <input class="ap-field" name="sickpay" type="number" min="70" max="100" value={defaults.sickPayPct} />
      </label>
      <label class="check"><input type="checkbox" name="replace" checked /> Ziekte laten vervangen.</label>
      <label class="block text-sm">Vervangingstarief per uur. Standaard ons tarief voor dit niveau en deze uren.
        <input class="ap-field" name="replacement" type="number" min="0" max="250" step="0.5" value={defaults.replacementRate} />
      </label>
      <label class="block text-sm">Directe wervingskosten, eenmalig. Standaard 5000.
        <input class="ap-field" name="recruitment" type="number" min="0" step="100" value={defaults.recruitmentCost} />
      </label>
      <label class="block text-sm">Vacature in kalenderdagen. Standaard 60.
        <input class="ap-field" name="vacancy" type="number" min="0" max="365" value={defaults.vacancyCalendarDays} />
      </label>
      <label class="check"><input type="checkbox" name="coverVacancy" checked /> Tijdens de vacature vervanging inkopen.</label>
      <label class="block text-sm">Dienstjaren om eenmalige kosten over af te schrijven.
        <input class="ap-field" name="tenure" type="number" min="1" max="40" value={defaults.tenureYears} />
      </label>
      <label class="block text-sm">Inwerkweken. Standaard 0: er is geen landelijk cijfer.
        <input class="ap-field" name="onboarding" type="number" min="0" max="26" value={defaults.onboardingWeeks} />
      </label>
      <label class="block text-sm">Productiviteit tijdens het inwerken, %.
        <input class="ap-field" name="onboardingProductivity" type="number" min="0" max="100" value={defaults.onboardingProductivity * 100} />
      </label>
      <label class="block text-sm">Niet-productieve uren na verlof en verzuim, %. Standaard 0. Leegloop bij een lage caseload zit al in het volle contract.
        <input class="ap-field" name="nonproductive" type="number" min="0" max="80" step="1" value={defaults.nonProductivePct} />
      </label>
      <label class="block text-sm">Feestdagen op een werkdag. Standaard 6 in 2026.
        <input class="ap-field" name="holidays" type="number" min="0" max="15" value={defaults.publicHolidays} />
      </label>
      <label class="block text-sm">Opleiding, eenmalig, exclusief btw. Standaard 4290, de lijstprijs van één CROV-aanbieder.
        <input class="ap-field" name="training" type="number" min="0" step="10" value={defaults.trainingOnce} />
      </label>
      <label class="block text-sm">Registratie per jaar. Standaard 380, RNVC 2026.
        <input class="ap-field" name="registration" type="number" min="0" step="10" value={defaults.registrationYear} />
      </label>
      <label class="block text-sm">Laptop en software per jaar. Standaard 0.
        <input class="ap-field" name="software" type="number" min="0" step="50" value={defaults.softwareYear} />
      </label>
      <label class="block text-sm">Lease of auto per jaar. Standaard 0.
        <input class="ap-field" name="lease" type="number" min="0" step="50" value={defaults.leaseYear} />
      </label>
      <label class="block text-sm">Zakelijke kilometers per week. Standaard 0.
        <input class="ap-field" name="km" type="number" min="0" step="1" value={defaults.kmPerWeek} />
      </label>
      <label class="block text-sm">Kilometertarief. Standaard 0,25, de onbelaste vergoeding 2026.
        <input class="ap-field" name="kmrate" type="number" min="0" max="1" step="0.01" value={defaults.kmRate} />
      </label>
      <label class="check"><input type="checkbox" name="transition" checked /> Jaarlijkse opbouw van de transitievergoeding meetellen. U betaalt die pas als het contract op uw initiatief eindigt.</label>
    </fieldset>
  </form>
  <details class="mt-4 rounded-3xl bg-sand-100 p-4 text-sm" open>
    <summary class="cursor-pointer font-semibold">Bronnen</summary>
    <ul class="mt-3 space-y-2">
      {compareSources.map((item) => (
        <li>
          <a class="font-semibold text-green-800 underline decoration-ochre-500" href={item.url}>{item.title}</a>
          <span> — {item.note}</span>
        </li>
      ))}
    </ul>
  </details>
</div>

<style>
  .check { display: flex; gap: 0.5rem; align-items: flex-start; font-size: 0.95rem; }
</style>

<script>
  import { compareEmployment, grossMonthlyFromCbs, type CompareInput } from "../../lib/calc";
  import { compareReportHtml } from "../../lib/compare-view";
  import { rateFor } from "../../lib/rates";
  import { mountReport } from "../../scripts/report";
  import { track } from "../../scripts/track";

  const root = document.querySelector<HTMLElement>("[data-compare]");
  const form = root?.querySelector("form");
  const out = root?.querySelector<HTMLElement>("[data-out]");
  const gross = form?.querySelector<HTMLInputElement>("[name=gross]");
  const replacement = form?.querySelector<HTMLInputElement>("[name=replacement]");
  const contract = form?.querySelector<HTMLInputElement>("[name=contract]");
  const level = form?.querySelector<HTMLSelectElement>("[name=level]");
  const hours = form?.querySelector<HTMLInputElement>("[name=hours]");
  let grossTouched = false;
  let replacementTouched = false;

  function field(data: FormData, name: string, fallback = 0) {
    const value = Number(data.get(name));
    return Number.isFinite(value) ? value : fallback;
  }

  function render(shouldTrack: boolean) {
    if (!form || !out) return;
    const data = new FormData(form);
    const chosen = String(data.get("level")) as CompareInput["level"];
    const neededHours = field(data, "hours", 10);
    const contractHours = field(data, "contract", 40);
    const input: CompareInput = {
      level: chosen,
      neededHours,
      grossMonthly: grossTouched ? field(data, "gross") : grossMonthlyFromCbs(contractHours),
      contractHours,
      largeEmployer: data.get("large") === "on",
      temporaryContract: data.get("temporary") === "on",
      whkPct: field(data, "whk", 1.52),
      pensionPct: field(data, "pension"),
      yearEndPct: field(data, "yearend"),
      absencePct: field(data, "absence", 5.4),
      sickPayPct: field(data, "sickpay", 100),
      replaceAbsence: data.get("replace") === "on",
      replacementRate: replacementTouched ? field(data, "replacement") : rateFor(chosen, Math.max(10, neededHours)),
      recruitmentCost: field(data, "recruitment"),
      tenureYears: field(data, "tenure", 3),
      vacancyCalendarDays: field(data, "vacancy"),
      coverVacancy: data.get("coverVacancy") === "on",
      onboardingWeeks: field(data, "onboarding"),
      onboardingProductivity: field(data, "onboardingProductivity", 50) / 100,
      trainingOnce: field(data, "training"),
      registrationYear: field(data, "registration"),
      softwareYear: field(data, "software"),
      leaseYear: field(data, "lease"),
      kmPerWeek: field(data, "km"),
      kmRate: field(data, "kmrate", 0.25),
      includeTransition: data.get("transition") === "on",
      publicHolidays: field(data, "holidays", 6),
      nonProductivePct: field(data, "nonproductive"),
    };
    const result = compareEmployment(input);
    out.innerHTML = compareReportHtml(input, result);
    mountReport(out, {
      calculator: "casemanager-inhuren-of-in-dienst",
      title: "Casemanager inhuren of in dienst nemen",
      body: out.innerText.trim(),
    });
    if (shouldTrack) track("calculator_result", { calculator: "casemanager-inhuren-of-in-dienst" });
  }

  gross?.addEventListener("input", () => {
    grossTouched = true;
  });
  replacement?.addEventListener("input", () => {
    replacementTouched = true;
  });
  function syncDerived() {
    if (!grossTouched && gross && contract) {
      const next = grossMonthlyFromCbs(Number(contract.value) || 40);
      gross.value = next.toFixed(2);
    }
    if (!replacementTouched && replacement && level && hours) {
      replacement.value = String(rateFor(level.value as CompareInput["level"], Math.max(10, Number(hours.value) || 10)));
    }
  }
  level?.addEventListener("change", () => {
    syncDerived();
    render(false);
  });
  hours?.addEventListener("change", () => {
    syncDerived();
    render(false);
  });
  contract?.addEventListener("change", () => {
    syncDerived();
    render(false);
  });
  form?.addEventListener("input", (event) => {
    const target = event.target as HTMLElement | null;
    if (target === level || target === hours || target === contract) return;
    render(false);
  });
  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    syncDerived();
    render(true);
  });
  render(false);
</script>
