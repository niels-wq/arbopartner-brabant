---
import { calendlyKennismaking } from "../data/calendly";

interface Props {
  class?: string;
  cta?: string;
  label?: string;
  /** Tekstlink in een zin. Geen knoppadding. */
  inline?: boolean;
  variant?: "primary" | "ghost";
}

const {
  class: className = "",
  cta = "calendly-kennismaking",
  label = calendlyKennismaking.label,
  inline = false,
  variant = "primary",
} = Astro.props;
const classes = inline ? className || "font-semibold text-green-800 underline" : className === "" && Astro.props.class === "" ? undefined : ["btn", variant === "ghost" ? "btn-ghost" : "", className];
---

<button
  type="button"
  class:list={classes}
  data-calendly={calendlyKennismaking.id}
  data-calendly-url={calendlyKennismaking.url}
  data-cta={cta}
>
  {label}
</button>
