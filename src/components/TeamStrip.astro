---
import TeamPhoto from "./TeamPhoto.astro";
import { bestMatchTeam, matchvermogenTeam, teamSource } from "../data/team";

const groups = [
  { title: "Matchvermogen", people: matchvermogenTeam },
  { title: "Best Match Re-integratie", people: bestMatchTeam },
];
---

<section class="mx-auto max-w-6xl px-4 py-8" aria-labelledby="teamstrook">
  <div class="flex items-end justify-between gap-4">
    <h2 id="teamstrook" class="font-serif text-4xl text-green-950">De mensen van Matchvermogen</h2>
    <a class="hidden font-semibold text-green-800 sm:inline" href="/team">Het hele team</a>
  </div>
  <p class="mt-2 max-w-3xl text-sm text-ink-soft">Namen, functies en foto’s staan op de <a class="underline" href={teamSource}>teampagina van matchvermogen.nl</a>. Naast deze vaste kern werken we met een netwerk van gecertificeerde zzp-professionals: snel op te schalen, de juiste specialist per casus, en wisselen als de klik ontbreekt. Wie in loondienst is en wie als zzp’er meewerkt, staat in de offerte.</p>
  {groups.map((group) => (
    <div class="mt-5">
      <h3 class="font-semibold text-green-950">{group.title}</h3>
      <ul class="mt-3 flex gap-3 overflow-x-auto pb-2">
        {group.people.map((person) => (
          <li class="w-36 shrink-0">
            <a class="block rounded-2xl bg-white p-2 ring-1 ring-line" href="/team">
              <TeamPhoto member={person} sizes="9rem" class="h-40 w-full rounded-xl object-cover object-top" />
              <span class="mt-2 block font-semibold leading-tight text-green-950">{person.name}</span>
              <span class="mt-1 block text-xs text-ink-soft">{person.role}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}
</section>
