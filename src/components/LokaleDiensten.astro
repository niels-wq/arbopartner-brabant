---
import { dienstLinks, interimLinks, projectLinks, toetsLinks } from "../data/regios";

interface Props {
  plaats?: string;
}

const { plaats } = Astro.props;
const waar = plaats ? ` in ${plaats}` : "";
---

<section class="mt-8" aria-labelledby="lokale-diensten">
  <h2 id="lokale-diensten" class="font-serif text-3xl text-green-950">Diensten{waar}</h2>
  <h3 class="mt-4 font-serif text-2xl text-green-950">Begeleiding</h3>
  <ul class="mt-3 flex flex-wrap gap-2">
    {dienstLinks.map((item) => (
      <li><a class="inline-block rounded-full bg-white px-3 py-1 text-sm font-semibold text-green-950 ring-1 ring-line" href={item.href}>{item.label}</a></li>
    ))}
  </ul>
  <h3 class="mt-6 font-serif text-2xl text-green-950">Toetsing en bezwaar</h3>
  <ul class="mt-3 flex flex-wrap gap-2">
    {toetsLinks.map((item) => (
      <li><a class="inline-block rounded-full bg-white px-3 py-1 text-sm font-semibold text-green-950 ring-1 ring-line" href={item.href}>{item.label}</a></li>
    ))}
  </ul>
  <h3 class="mt-6 font-serif text-2xl text-green-950">HR-projecten{waar}</h3>
  <p class="mt-2">Cijfers en een rapport, een verzuimsysteem en de implementatie, protocol, training, preventie, verzekeringen, verzuimreductie, een functiehuis, of advies bij een arbodienst-tender. Los of als integrale aanpak. Geen verzuimsysteem? Wij leveren er een en borgen daarin de informatie en de trajecten.</p>
  <ul class="mt-3 flex flex-wrap gap-2">
    {projectLinks.map((item) => (
      <li><a class="inline-block rounded-full bg-white px-3 py-1 text-sm font-semibold text-green-950 ring-1 ring-line" href={item.href}>{item.label}</a></li>
    ))}
  </ul>
  <h3 class="mt-6 font-serif text-2xl text-green-950">Interim</h3>
  <p class="mt-2">Een casemanager of verzuimcoördinator tijdelijk op locatie. Of spoedhulp als HR wegvalt of een dossier acuut vastloopt. Reactie binnen 24 uur.</p>
  <ul class="mt-3 flex flex-wrap gap-2">
    {interimLinks.map((item) => (
      <li><a class="inline-block rounded-full bg-white px-3 py-1 text-sm font-semibold text-green-950 ring-1 ring-line" href={item.href}>{item.label}</a></li>
    ))}
  </ul>
  <p class="mt-4 text-sm"><a class="font-semibold underline" href="/diensten">Alle diensten</a></p>
</section>
