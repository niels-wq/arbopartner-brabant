---
import Button from "./Button.astro";

interface Props {
  href?: string;
  label?: string;
  cta?: string;
  risk?: string;
}
const {
  href = "/adviesgesprek",
  label = "Plan een adviesgesprek",
  cta = "kop-advies",
  risk = "Het gesprek van 30 minuten verplicht u tot niets.",
} = Astro.props;
---

<p class="mt-6">
  <Button data-cta={cta} href={href}>{label}</Button>
</p>
<p class="mt-2 text-sm text-ink-soft">{risk}</p>
