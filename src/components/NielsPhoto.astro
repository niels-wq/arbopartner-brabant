---
interface Props {
  sizes: string;
  class?: string;
  eager?: boolean;
  alt?: string;
}
const {
  sizes,
  class: className = "",
  eager = false,
  alt = "Niels Alderding met een kop koffie, arbeidsdeskundige en eigenaar van Matchvermogen",
} = Astro.props;
const webp = "/mensen/niels-koffie-240.webp 240w, /mensen/niels-koffie-400.webp 400w";
const avif = "/mensen/niels-koffie-240.avif 240w, /mensen/niels-koffie-400.avif 400w";
---

<picture class:list={["inline-block shrink-0 overflow-hidden", className]}>
  <source type="image/avif" srcset={avif} sizes={sizes} />
  <img
    src="/mensen/niels-koffie-400.webp"
    srcset={webp}
    sizes={sizes}
    width="400"
    height="336"
    alt={alt}
    class="niels-koffie h-full w-full"
    loading={eager ? "eager" : "lazy"}
    decoding="async"
    fetchpriority={eager ? "high" : "auto"}
  />
</picture>
