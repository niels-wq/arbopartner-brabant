---
interface Props {
  sizes: string;
  class?: string;
  eager?: boolean;
  alt?: string;
}
const { sizes, class: className = "", eager = false, alt = "Niels Alderding, directeur en arbeidsdeskundige bij Matchvermogen in Uden" } = Astro.props;
const webp = "/mensen/niels-alderding-240.webp 240w, /mensen/niels-alderding-480.webp 480w, /mensen/niels-alderding-800.webp 800w, /mensen/niels-alderding-1200.webp 1200w";
const avif = "/mensen/niels-alderding-240.avif 240w, /mensen/niels-alderding-480.avif 480w, /mensen/niels-alderding-800.avif 800w, /mensen/niels-alderding-1200.avif 1200w";
---

<picture>
  <source type="image/avif" srcset={avif} sizes={sizes} />
  <img
    src="/mensen/niels-alderding-800.webp"
    srcset={webp}
    sizes={sizes}
    width="800"
    height="1000"
    alt={alt}
    class={className}
    loading={eager ? "eager" : "lazy"}
    decoding="async"
    fetchpriority={eager ? "high" : "auto"}
  />
</picture>
