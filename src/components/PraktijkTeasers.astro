---
import { praktijkEerst } from "../data/praktijk";

interface Props {
  eerst?: string;
  kop?: string;
}

const { eerst = "fietsfabrikant-reorganisatie", kop = "Praktijkvoorbeelden" } = Astro.props;
const items = praktijkEerst(eerst);
---

<section class="mt-10" aria-labelledby="praktijk-teaser-kop">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <h2 id="praktijk-teaser-kop" class="font-serif text-3xl text-green-950">{kop}</h2>
    <a class="font-semibold text-green-800 underline" href="/praktijkvoorbeelden">Alle praktijkvoorbeelden</a>
  </div>
  <p class="mt-3 max-w-2xl text-ink-soft">Anoniem, uit ons eigen werk. Geen review en geen bedrijfsnaam.</p>
  <div class="mt-5 grid gap-4 md:grid-cols-2">
    {items.map((item) => (
      <article class="rounded-2xl border border-line bg-white p-5">
        <h3 class="font-serif text-2xl text-green-950">{item.title}</h3>
        <p class="mt-2 text-ink-soft">{item.teaser}</p>
        <p class="mt-3 font-semibold text-green-950">{item.resultaat}</p>
        <a class="mt-4 inline-block font-semibold text-green-800 underline" href={`/praktijkvoorbeelden/${item.slug}`}>Lees het praktijkvoorbeeld</a>
      </article>
    ))}
  </div>
</section>
