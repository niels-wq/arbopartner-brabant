---
import type { TeamMember } from "../data/team";

interface Props {
  member: TeamMember;
  sizes: string;
  eager?: boolean;
  class?: string;
}
const { member, sizes, eager = false, class: className = "" } = Astro.props;
const focused = member.slug === "niels-alderding";
const base = `/mensen/${member.slug}`;
const webp = focused
  ? "/mensen/niels-alderding-face.webp 480w"
  : member.widths.map((width) => `${base}-${width}.webp ${width}w`).join(", ");
const avif = focused
  ? "/mensen/niels-alderding-face.avif 480w"
  : member.widths.map((width) => `${base}-${width}.avif ${width}w`).join(", ");
const largest = member.widths[member.widths.length - 1];
---

<picture>
  <source type="image/avif" srcset={avif} sizes={sizes} />
  <img
    src={focused ? "/mensen/niels-alderding-face.webp" : `${base}-${largest}.webp`}
    srcset={webp}
    sizes={sizes}
    width={focused ? 480 : member.width}
    height={focused ? 480 : member.height}
    alt={member.alt}
    class:list={[className, focused && "niels-face"]}
    loading={eager ? "eager" : "lazy"}
    decoding="async"
  />
</picture>
