---
import { site, phoneHref, mailHref, whatsappHref } from "../data/site";
import { places } from "../data/places";
import { footerDiensten, regios } from "../data/regios";
---

<footer class="mt-16 bg-green-950 text-sand-100">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 md:grid-cols-4">
    <div>
      <a href="/" class="inline-flex items-center no-underline" data-cta="logo-footer">
        <img class="site-logo site-logo-footer" src="/logo-light.png?v=20261027" width="263" height="64" alt="Arbopartner Brabant, van Matchvermogen" />
      </a>
      <p class="mt-4 text-sm">
        {site.parent.legalName}<br />
        {site.parent.street}<br />
        {site.parent.postalCode} {site.parent.city}<br />
        KvK {site.parent.kvk}, btw {site.parent.btw}
      </p>
    </div>
    <div>
      <p class="font-semibold text-ochre-200">Contact</p>
      <p class="mt-2 flex flex-col gap-2 text-sm">
        <a class="inline-flex min-h-8 items-center" data-cta="footer-bel" data-channel="phone" href={phoneHref}>Bellen {site.parent.phoneDisplay}</a>
        <a class="inline-flex min-h-8 items-center" data-cta="footer-whatsapp" data-channel="whatsapp" href={whatsappHref} rel="noopener">WhatsApp {site.parent.whatsappDisplay}</a>
        <a class="inline-flex min-h-8 items-center" data-cta="footer-mail" data-channel="email" href={mailHref}>{site.parent.email}</a>
      </p>
      <a class="mt-4 inline-block text-sm font-semibold text-ochre-200" href="/contact">Contactpagina</a>
      <a class="mt-2 inline-block text-sm font-semibold text-ochre-200" data-cta="footer-kantoor" href="/adviesgesprek?plek=kantoor#afspraak">Plan een gesprek op ons kantoor</a>
    </div>
    <div>
      <p class="font-semibold text-ochre-200">Zustermerken</p>
      <ul class="mt-2 space-y-2 text-sm">
        {site.sisters.map((sister) => (
          <li>
            <a href={sister.url} rel="noopener">{sister.name}</a>
            <span class="block text-xs text-sand-200">{sister.role}</span>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <p class="font-semibold text-ochre-200">Werkgebied</p>
      <ul class="mt-2 space-y-1 text-sm">
        <li><a href="/werkgebied">Heel Noord-Brabant</a></li>
        {regios.map((regio) => (
          <li><a href={`/werkgebied/regio/${regio.slug}`}>{regio.name}</a></li>
        ))}
      </ul>
      <ul class="mt-3 columns-2 text-sm">
        {places.map((place) => (
          <li class="mb-1"><a href={`/werkgebied/${place.slug}`}>{place.name}</a></li>
        ))}
      </ul>
    </div>
  </div>
  <nav class="border-t border-white/10" aria-label="Diensten">
    <div class="mx-auto max-w-6xl px-4 py-6">
      <p class="font-semibold text-ochre-200">Diensten</p>
      <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-2 text-sm">
        {footerDiensten.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
        <li><a href="/diensten">Alle diensten</a></li>
      </ul>
    </div>
  </nav>
  <div class="border-t border-white/10">
    <div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-4 text-xs text-sand-200 sm:flex-row sm:justify-between">
      <p class="m-0">© {new Date().getFullYear()} {site.parent.legalName}. {site.labelStatement}.</p>
      <p class="m-0 flex flex-wrap gap-x-4 gap-y-1">
        <a href="/privacy">Privacy</a>
        <a href="/voorwaarden">Voorwaarden</a>
        <a href="/team">Team</a>
        <a href="/werken-bij">Werken bij</a>
        <a href="/reviews">Reviews</a>
        <a href="/arbodienst-of-arbopartner">Anders dan een arbodienst</a>
        <a href="/situaties">Situaties</a>
        <a href="/praktijkvoorbeelden">Praktijkvoorbeelden</a>
        <a href="/diensten">Diensten</a>
        <a href="/checklist-verzuim">Checklist</a>
        <a href="/loonsanctie-risicoscan">Loonsanctie-risicoscan</a>
        <a href="/verzuim-tijdlijn">Verzuim-tijdlijn</a>
      </p>
    </div>
  </div>
</footer>
