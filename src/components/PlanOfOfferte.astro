---
import Button from "./Button.astro";
import { phoneHref, site, whatsappHref } from "../data/site";

interface Props {
  gesprekCta: string;
  offerteCta: string;
  phoneCta: string;
  whatsappCta: string;
}
const { gesprekCta, offerteCta, phoneCta, whatsappCta } = Astro.props;
---

<div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
  <Button class="w-full sm:w-auto" data-cta={gesprekCta} href="/adviesgesprek">Plan een gesprek</Button>
  <Button class="w-full sm:w-auto" variant="ghost" data-cta={offerteCta} href="/offerte">Vraag een offerte aan</Button>
</div>
<p class="mt-3 text-sm text-ink-soft">
  {site.responsePromise}
  Bellen kan op <a class="underline" data-channel="phone" data-cta={phoneCta} href={phoneHref}>{site.parent.phoneDisplay}</a>.
  Appen kan via <a class="underline" data-channel="whatsapp" data-cta={whatsappCta} href={whatsappHref} rel="noopener">WhatsApp {site.parent.whatsappDisplay}</a>.
</p>
